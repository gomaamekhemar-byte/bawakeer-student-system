<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>الداش بورد والمؤشرات التحليلية | مدارس بواكير الأهلية</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    body { font-family: 'Cairo', system-ui, sans-serif; background-color: #f4f6f9; color: #212529; min-height: 100vh; }
    .navbar-erp { background: #ffffff; border-bottom: 1px solid #e3e8ee; }
    .erp-sub-header { background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #ffffff; padding: 14px 0; }
    
    .stat-card-custom {
      background: #ffffff;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 2px 6px rgba(0,0,0,0.03);
      padding: 16px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .stat-card-custom:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 16px rgba(0,0,0,0.06);
    }
    .stat-card-custom .stat-number {
      font-size: 26px;
      font-weight: 800;
      line-height: 1.2;
    }
    .stat-card-custom .stat-title {
      font-size: 13px;
      font-weight: 700;
      color: #64748b;
      margin-top: 4px;
    }
    .stat-card-custom .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .stat-card-blue { border-right: 5px solid #2563eb; }
    .stat-card-green { border-right: 5px solid #10b981; }
    .stat-card-red { border-right: 5px solid #ef4444; }
    .stat-card-cyan { border-right: 5px solid #06b6d4; }
    .stat-card-amber { border-right: 5px solid #f59e0b; }
    .stat-card-purple { border-right: 5px solid #8b5cf6; }

    .rate-card {
      background: #ffffff;
      border-radius: 14px;
      border: 1px solid #e2e8f0;
      padding: 20px;
      text-align: center;
      box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    }
    .rate-circle-badge {
      width: 84px;
      height: 84px;
      border-radius: 50%;
      margin: 0 auto 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      font-weight: 900;
    }

    .table thead th {
      background-color: #1e3a8a !important;
      color: #ffffff !important;
      font-weight: 700;
      padding: 12px 10px;
      font-size: 13.5px;
      vertical-align: middle;
    }
    .table tbody td {
      padding: 12px 10px;
      vertical-align: middle;
      font-size: 13.5px;
    }

    /* Interactive Cross-Filtering Styles */
    .interactive-data-row {
      cursor: pointer;
      transition: all 0.2s ease-in-out;
    }
    .interactive-data-row:hover {
      background-color: #f1f5f9 !important;
      transform: scale(1.002);
      box-shadow: inset 0 0 0 1.5px #3b82f6;
    }
    .interactive-data-row.active-row-filtered {
      background-color: #e0f2fe !important;
      box-shadow: inset 4px 0 0 0 #0284c7, 0 0 8px rgba(2, 132, 199, 0.15) !important;
    }
    .interactive-data-row.active-row-filtered td {
      font-weight: 700;
    }
    .animated-progress-bar {
      transition: width 0.65s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }
    .pulse-badge {
      animation: pulseAnim 1.8s infinite;
    }
    @keyframes pulseAnim {
      0% { transform: scale(1); }
      50% { transform: scale(1.05); }
      100% { transform: scale(1); }
    }
  </style>
</head>
<body>

  <!-- TOP NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-erp py-2">
    <div class="container-fluid px-4">
      <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" href="/">
        <% if (typeof systemSettings !== 'undefined' && systemSettings.school_logo_url) { %>
          <img src="<%= systemSettings.school_logo_url %>" alt="Logo" style="height: 34px; width: 34px; object-fit: contain;">
        <% } else { %>
          <i class="fa-solid fa-graduation-cap fs-4"></i>
        <% } %>
        <span><%= (typeof systemSettings !== 'undefined' && systemSettings.school_name) ? systemSettings.school_name : 'مدارس بواكير الأهلية' %></span>
      </a>

      <div class="d-flex align-items-center gap-3">
        <a href="/" class="btn btn-outline-secondary btn-sm fw-bold">
          <i class="fa-solid fa-house me-1"></i> الرئيسية
        </a>
        <a href="/students" class="btn btn-outline-primary btn-sm fw-bold">
          <i class="fa-solid fa-users me-1"></i> متابعة الطلاب
        </a>
        <a href="/reports" class="btn btn-outline-warning text-dark btn-sm fw-bold">
          <i class="fa-solid fa-file-lines me-1 text-warning"></i> مركز التقارير
        </a>
        <a href="/users" class="btn btn-outline-danger btn-sm fw-bold">
          <i class="fa-solid fa-shield-halved me-1"></i> المستخدمين
        </a>
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a href="/general_settings" class="btn btn-outline-primary btn-sm fw-bold" title="هوية النظام والإعدادات العامة">
            <i class="fa-solid fa-palette me-1"></i> هوية النظام
          </a>
        <% } %>
      </div>

      <div class="d-flex align-items-center gap-3">
        <span class="fw-bold text-dark"><%= currentUser ? (currentUser.full_name || currentUser.username) : 'المستخدم' %></span>
        <button type="button" class="btn btn-outline-warning text-dark btn-sm fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#changePasswordModal" title="تغيير كلمة المرور الخاصة بي">
          <i class="fa-solid fa-key me-1 text-warning"></i> كلمة المرور
        </button>
        <a href="/logout" class="btn btn-outline-danger btn-sm" title="تسجيل الخروج">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </a>
      </div>
    </div>
  </nav>
  <!-- READ-ONLY ARCHIVE BANNER -->
  <% if(typeof isReadOnlyYear !== 'undefined' && isReadOnlyYear){ %>
    <div class="alert alert-warning border-warning d-flex align-items-center justify-content-between mb-0 rounded-0 py-2 px-4 shadow-sm" style="background-color: #fffbeb; border-bottom: 2px solid #f59e0b;">
      <div class="d-flex align-items-center gap-2 fw-bold text-dark">
        <i class="fa-solid fa-lock text-warning fs-5"></i>
        <span>أنت تتصفح أرشيف العام الدراسي (<%= (typeof sessionYear !== 'undefined' && sessionYear) ? sessionYear.name : '' %>) - وضع القراءة فقط 🔒 (لا يمكن الإضافة أو التعديل أو الحذف)</span>
      </div>
      <a href="/login" class="btn btn-warning btn-sm fw-bold shadow-sm">
        <i class="fa-solid fa-arrow-right-from-bracket me-1"></i> العودة للعام النشط
      </a>
    </div>
  <% } %>

    <!-- BLUE SUB-HEADER -->
  <div class="erp-sub-header">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div class="fw-bold fs-5 d-flex align-items-center gap-2">
        <i class="fa-solid fa-chart-pie"></i>
        <span>الداش بورد والمؤشرات التحليلية | <%= (typeof systemSettings !== 'undefined' && systemSettings.school_name) ? systemSettings.school_name : 'مدارس بواكير الأهلية' %></span>
      </div>

      <!-- DYNAMIC UNIFIED ADAPTIVE FILTERS BAR -->
      <form method="get" action="/analytics" class="d-flex align-items-center flex-wrap gap-2" id="analyticsFilterForm" onsubmit="event.preventDefault(); refreshAnalytics();">
        
        <!-- 1. Branch Filter -->
        <% if(typeof isFullBranchAccess !== 'undefined' && isFullBranchAccess){ %>
          <div class="d-flex align-items-center gap-1">
            <label class="text-white small fw-bold text-nowrap" for="branchFilterSelect">
              <i class="fa-solid fa-building me-1"></i> الفرع:
            </label>
            <select name="branch" id="branchFilterSelect" class="form-select form-select-sm fw-bold shadow-sm" style="min-width: 125px;" onchange="refreshAnalytics()">
              <option value="الكل" <%= (!selectedBranch || selectedBranch === 'الكل') ? 'selected' : '' %>>🌐 جميع الفروع</option>
              <% ((typeof availableFilters !== 'undefined' && availableFilters.branches) ? availableFilters.branches : branches).forEach(function(b){ %>
                <option value="<%= b %>" <%= (selectedBranch === b) ? 'selected' : '' %>>🏢 فرع <%= b %></option>
              <% }) %>
            </select>
          </div>
        <% } else { %>
          <input type="hidden" name="branch" id="branchFilterSelect" value="<%= selectedBranch %>">
          <span class="badge bg-white text-primary fs-7 px-3 py-2 fw-bold shadow-sm">
            <i class="fa-solid fa-building me-1"></i> فرع <%= selectedBranch %>
          </span>
        <% } %>

        <!-- 2. Phase Filter -->
        <div class="d-flex align-items-center gap-1">
          <label class="text-white small fw-bold text-nowrap" for="phaseFilterSelect">
            <i class="fa-solid fa-layer-group me-1"></i> المرحلة:
          </label>
          <select name="phase" id="phaseFilterSelect" class="form-select form-select-sm fw-bold shadow-sm" style="min-width: 115px;" onchange="refreshAnalytics()">
            <option value="الكل" <%= (!selectedPhase || selectedPhase === 'الكل') ? 'selected' : '' %>>جميع المراحل</option>
            <% ((typeof availableFilters !== 'undefined' && availableFilters.phases) ? availableFilters.phases : phases).forEach(function(p){ %>
              <option value="<%= p %>" <%= (selectedPhase === p) ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </div>

        <!-- 3. Grade Filter -->
        <div class="d-flex align-items-center gap-1">
          <label class="text-white small fw-bold text-nowrap" for="gradeFilterSelect">
            <i class="fa-solid fa-graduation-cap me-1"></i> الصف:
          </label>
          <select name="grade" id="gradeFilterSelect" class="form-select form-select-sm fw-bold shadow-sm" style="min-width: 110px;" onchange="refreshAnalytics()">
            <option value="الكل" <%= (!selectedGrade || selectedGrade === 'الكل') ? 'selected' : '' %>>جميع الصفوف</option>
            <% ((typeof availableFilters !== 'undefined' && availableFilters.grades) ? availableFilters.grades : grades).forEach(function(g){ %>
              <option value="<%= g %>" <%= (selectedGrade === g) ? 'selected' : '' %>>الصف <%= g %></option>
            <% }) %>
          </select>
        </div>

        <!-- 4. Student Type Filter -->
        <div class="d-flex align-items-center gap-1">
          <label class="text-white small fw-bold text-nowrap" for="typeFilterSelect">
            <i class="fa-solid fa-venus-mars me-1"></i> النوع:
          </label>
          <select name="type" id="typeFilterSelect" class="form-select form-select-sm fw-bold shadow-sm" style="min-width: 105px;" onchange="refreshAnalytics()">
            <option value="الكل" <%= (!selectedType || selectedType === 'الكل') ? 'selected' : '' %>>الكل</option>
            <% ((typeof availableFilters !== 'undefined' && availableFilters.types) ? availableFilters.types : student_types).forEach(function(t){ %>
              <option value="<%= t %>" <%= (selectedType === t) ? 'selected' : '' %>><%= t === 'بنين' ? '👦 بنين' : '👧 بنات' %></option>
            <% }) %>
          </select>
        </div>

        <!-- 5. Track Filter -->
        <div class="d-flex align-items-center gap-1">
          <label class="text-white small fw-bold text-nowrap" for="trackFilterSelect">
            <i class="fa-solid fa-book-open me-1"></i> المسار:
          </label>
          <select name="track" id="trackFilterSelect" class="form-select form-select-sm fw-bold shadow-sm" style="min-width: 110px;" onchange="refreshAnalytics()">
            <option value="الكل" <%= (!selectedTrack || selectedTrack === 'الكل') ? 'selected' : '' %>>جميع المسارات</option>
            <% ((typeof availableFilters !== 'undefined' && availableFilters.tracks) ? availableFilters.tracks : tracks).forEach(function(tr){ %>
              <option value="<%= tr %>" <%= (selectedTrack === tr) ? 'selected' : '' %>><%= tr %></option>
            <% }) %>
          </select>
        </div>

        <!-- 6. Registration Source Filter -->
        <div class="d-flex align-items-center gap-1">
          <label class="text-white small fw-bold text-nowrap" for="sourceFilterSelect">
            <i class="fa-solid fa-filter me-1"></i> المصدر:
          </label>
          <select name="source" id="sourceFilterSelect" class="form-select form-select-sm fw-bold shadow-sm" style="min-width: 125px;" onchange="refreshAnalytics()">
            <option value="الكل" <%= (!selectedSource || selectedSource === 'الكل' || selectedSource === 'جميع المصادر') ? 'selected' : '' %>>جميع المصادر</option>
            <% ((typeof availableFilters !== 'undefined' && availableFilters.sources) ? availableFilters.sources : ['الرابط الخارجي', 'التسجيل الداخلي (المدرسة)']).forEach(function(src){ %>
              <option value="<%= src %>" <%= (selectedSource === src) ? 'selected' : '' %>><%= src === 'الرابط الخارجي' ? '🌐 الرابط الخارجي' : '🏫 التسجيل الداخلي' %></option>
            <% }) %>
          </select>
        </div>

        <!-- Refresh Spinner Indicator -->
        <div id="filterLoadingSpinner" class="spinner-border spinner-border-sm text-white d-none ms-1" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>

      </form>
    </div>
  </div>

  <div class="container-fluid px-4 py-4" id="analyticsMainContent" style="transition: opacity 0.2s ease-in-out;">

    <!-- GLOBAL REUSABLE DATE FILTER -->
    <div class="mb-4">
      <%- include('partials/date_filter') %>
    </div>

    <!-- 1. TOP STATS CARDS (HORIZONTAL ROW) -->
    <div class="row g-3 mb-4">
      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-blue h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number text-primary" id="statTotal"><%= analytics.total %></div>
            <div class="stat-title">إجمالي المتقدمين</div>
          </div>
          <div class="stat-icon bg-primary-subtle text-primary">
            <i class="fa-solid fa-users"></i>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-green h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number text-success" id="statAccepted"><%= analytics.accepted %></div>
            <div class="stat-title">المقبولين</div>
          </div>
          <div class="stat-icon bg-success-subtle text-success">
            <i class="fa-solid fa-circle-check"></i>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-red h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number text-danger" id="statRejected"><%= analytics.rejected %></div>
            <div class="stat-title">غير مقبول</div>
          </div>
          <div class="stat-icon bg-danger-subtle text-danger">
            <i class="fa-solid fa-circle-xmark"></i>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-cyan h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number text-info" id="statRegistered"><%= analytics.registered %></div>
            <div class="stat-title">تم التسجيل</div>
          </div>
          <div class="stat-icon bg-info-subtle text-info">
            <i class="fa-solid fa-user-check"></i>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-amber h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number text-warning" id="statWaiting"><%= analytics.waiting %></div>
            <div class="stat-title">في انتظار التسجيل</div>
          </div>
          <div class="stat-icon bg-warning-subtle text-warning">
            <i class="fa-solid fa-hourglass-half"></i>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-purple h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number" style="color:#8b5cf6;" id="statPendingInterview"><%= analytics.pending_interview %></div>
            <div class="stat-title">في انتظار المقابلة</div>
          </div>
          <div class="stat-icon bg-secondary-subtle text-secondary">
            <i class="fa-solid fa-clipboard-question"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. KEY PERFORMANCE RATES & WAITLIST DEMAND (FEATURE 4) -->
    <div class="row g-3 mb-4">
      <div class="col-lg-3 col-md-6">
        <div class="rate-card h-100">
          <div class="rate-circle-badge bg-success-subtle text-success border border-success" id="statAcceptanceRate">
            <%= analytics.acceptanceRate %>%
          </div>
          <h6 class="fw-bold text-dark mb-1">معدل القبول</h6>
          <small class="text-muted">نسبة المقبولين من إجمالي المتقدمين</small>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="rate-card h-100">
          <div class="rate-circle-badge bg-primary-subtle text-primary border border-primary" id="statRegistrationRate">
            <%= analytics.registrationRate %>%
          </div>
          <h6 class="fw-bold text-dark mb-1">معدل التسجيل الإجمالي</h6>
          <small class="text-muted">نسبة المسجلين فعلياً من الإجمالي</small>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="rate-card h-100">
          <div class="rate-circle-badge bg-info-subtle text-info border border-info" id="statConversionRate">
            <%= analytics.conversionRate %>%
          </div>
          <h6 class="fw-bold text-dark mb-1">معدل التحويل (Conversion)</h6>
          <small class="text-muted">نسبة من تم تسجيلهم من المقبولين</small>
        </div>
      </div>

      <div class="col-lg-3 col-md-6">
        <div class="rate-card h-100 border-warning shadow-sm" style="background: #fffdf5;">
          <div class="rate-circle-badge bg-warning-subtle text-warning border border-warning" id="statWaitlistCount">
            <%= typeof analytics.waitlist_count !== 'undefined' ? analytics.waitlist_count : 0 %>
          </div>
          <h6 class="fw-bold text-dark mb-1 d-flex align-items-center justify-content-center gap-1">
            <span>الطلب على الصفوف غير المتاحة</span>
            <span class="badge bg-warning text-dark font-monospace" style="font-size:10px;" id="statWaitlistRate"><%= typeof analytics.waitlist_rate !== 'undefined' ? analytics.waitlist_rate : 0 %>%</span>
          </h6>
          <small class="text-muted">طلبات قائمة الانتظار لدراسة فتح فصول جديدة</small>
        </div>
      </div>
    </div>

    <!-- 2.5 REGISTRATION SOURCES ANALYSIS (FEATURE 1: ONLINE VS INTERNAL) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
          <i class="fa-solid fa-chart-column text-primary"></i>
          <span>تحليل مصادر التسجيل (الرابط الخارجي مقابل التسجيل الداخلي)</span>
        </h5>
        <div class="d-flex align-items-center gap-2">
          <span class="badge bg-light text-dark border px-3 py-2 fw-bold">
            <i class="fa-solid fa-filter text-primary me-1"></i> تصفية النطاق: <%= analytics.branchLabel %>
          </span>
        </div>
      </div>

      <div class="card-body p-4 pt-2">
        
        <!-- COMPARISON STATS CARDS -->
        <div class="row g-3 mb-4">
          
          <!-- ONLINE / EXTERNAL SOURCE -->
          <div class="col-md-6">
            <div class="p-3 border rounded-3 bg-white h-100 shadow-sm" style="border-right: 5px solid #06b6d4 !important;">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                  <div class="rounded-circle bg-info-subtle text-info p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; font-size: 20px;">
                    <i class="fa-solid fa-globe"></i>
                  </div>
                  <div>
                    <h6 class="fw-bold text-dark mb-0">الرابط الخارجي (أونلاين / إعلانات)</h6>
                    <small class="text-muted">الطلاب المسجلين عبر بوابة الهبوط العامة</small>
                  </div>
                </div>
                <div class="text-end">
                  <span class="badge bg-info-subtle text-info border border-info fs-6 px-3 py-1 fw-bold">
                    <%= analytics.sourceStats.online_percent %>%
                  </span>
                </div>
              </div>

              <div class="d-flex align-items-baseline gap-2 my-2">
                <span class="fs-2 fw-bold text-info"><%= analytics.sourceStats.online_count %></span>
                <span class="text-muted fw-bold">طالب</span>
                <small class="text-muted ms-auto">من أصل <%= analytics.total %> طالب</small>
              </div>

              <div class="row g-2 pt-2 border-top text-center small">
                <div class="col-4">
                  <span class="text-muted d-block" style="font-size: 11px;">المقبولين</span>
                  <strong class="text-success fs-6"><%= analytics.sourceStats.online_accepted %></strong>
                </div>
                <div class="col-4">
                  <span class="text-muted d-block" style="font-size: 11px;">تم التسجيل</span>
                  <strong class="text-primary fs-6"><%= analytics.sourceStats.online_registered %></strong>
                </div>
                <div class="col-4">
                  <span class="text-muted d-block" style="font-size: 11px;">في الانتظار</span>
                  <strong class="text-warning fs-6"><%= analytics.sourceStats.online_waiting %></strong>
                </div>
              </div>
            </div>
          </div>

          <!-- INTERNAL / ON-SITE SOURCE -->
          <div class="col-md-6">
            <div class="p-3 border rounded-3 bg-white h-100 shadow-sm" style="border-right: 5px solid #2563eb !important;">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <div class="d-flex align-items-center gap-2">
                  <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; font-size: 20px;">
                    <i class="fa-solid fa-school"></i>
                  </div>
                  <div>
                    <h6 class="fw-bold text-dark mb-0">التسجيل الداخلي (حضوري بالمدارس)</h6>
                    <small class="text-muted">الطلاب المسجلين بواسطة الموظفين داخل النظام</small>
                  </div>
                </div>
                <div class="text-end">
                  <span class="badge bg-primary-subtle text-primary border border-primary fs-6 px-3 py-1 fw-bold">
                    <%= analytics.sourceStats.internal_percent %>%
                  </span>
                </div>
              </div>

              <div class="d-flex align-items-baseline gap-2 my-2">
                <span class="fs-2 fw-bold text-primary"><%= analytics.sourceStats.internal_count %></span>
                <span class="text-muted fw-bold">طالب</span>
                <small class="text-muted ms-auto">من أصل <%= analytics.total %> طالب</small>
              </div>

              <div class="row g-2 pt-2 border-top text-center small">
                <div class="col-4">
                  <span class="text-muted d-block" style="font-size: 11px;">المقبولين</span>
                  <strong class="text-success fs-6"><%= analytics.sourceStats.internal_accepted %></strong>
                </div>
                <div class="col-4">
                  <span class="text-muted d-block" style="font-size: 11px;">تم التسجيل</span>
                  <strong class="text-primary fs-6"><%= analytics.sourceStats.internal_registered %></strong>
                </div>
                <div class="col-4">
                  <span class="text-muted d-block" style="font-size: 11px;">في الانتظار</span>
                  <strong class="text-warning fs-6"><%= analytics.sourceStats.internal_waiting %></strong>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- VISUAL RATIO COMPARISON BAR -->
        <div class="mb-3">
          <div class="d-flex justify-content-between align-items-center mb-1 small fw-bold">
            <span class="text-info"><i class="fa-solid fa-globe me-1"></i> الرابط الخارجي (<%= analytics.sourceStats.online_percent %>%)</span>
            <span class="text-primary">التسجيل الداخلي (<%= analytics.sourceStats.internal_percent %>%) <i class="fa-solid fa-school ms-1"></i></span>
          </div>
          <div class="progress" style="height: 22px; border-radius: 12px; overflow: hidden;">
            <div class="progress-bar bg-info progress-bar-striped progress-bar-animated fw-bold text-white" role="progressbar" style="width: <%= analytics.sourceStats.online_percent %>%;" aria-valuenow="<%= analytics.sourceStats.online_percent %>" aria-valuemin="0" aria-valuemax="100">
              <%= analytics.sourceStats.online_percent > 8 ? (analytics.sourceStats.online_count + ' طالب (' + analytics.sourceStats.online_percent + '%)') : '' %>
            </div>
            <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated fw-bold text-white" role="progressbar" style="width: <%= analytics.sourceStats.internal_percent %>%;" aria-valuenow="<%= analytics.sourceStats.internal_percent %>" aria-valuemin="0" aria-valuemax="100">
              <%= analytics.sourceStats.internal_percent > 8 ? (analytics.sourceStats.internal_count + ' طالب (' + analytics.sourceStats.internal_percent + '%)') : '' %>
            </div>
          </div>
        </div>

      </div>
    <!-- 2.8 SMART COLLAPSIBLE DEMOGRAPHIC MATRIX (العرض الشبكي الذكي القابل للطي) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
          <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
            <i class="fa-solid fa-layer-group fs-5"></i>
          </div>
          <div>
            <h5 class="fw-bold text-dark mb-0">التوزيع الديموغرافي الذكي المدمج (Smart Collapsible View)</h5>
            <small class="text-muted">عرض هرمي مدمج وقابل للطي حسب الفروع مع إخفاء الصفوف الصفرية تلقائياً لتوفير المساحة</small>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-sm btn-outline-primary fw-bold px-3" onclick="toggleAllBranchAccordions(true)">
            <i class="fa-solid fa-angles-down me-1"></i> فتح الكل
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary fw-bold px-3" onclick="toggleAllBranchAccordions(false)">
            <i class="fa-solid fa-angles-up me-1"></i> طي الكل
          </button>
        </div>
      </div>

      <div class="card-body p-3 pt-0">
        <% if(typeof demographicMatrixGrid !== 'undefined' && demographicMatrixGrid.length){ %>
          <div class="accordion" id="demographicBranchesAccordion">
            <% demographicMatrixGrid.forEach(function(bData, bIdx){ %>
              <div class="accordion-item border rounded-3 mb-3 overflow-hidden shadow-sm">
                
                <!-- Accordion Header -->
                <h2 class="accordion-header" id="heading-branch-<%= bIdx %>">
                  <button class="accordion-button <%= bIdx === 0 ? '' : 'collapsed' %> bg-light py-3 px-3 d-flex align-items-center justify-content-between" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-branch-<%= bIdx %>" aria-expanded="<%= bIdx === 0 ? 'true' : 'false' %>" aria-controls="collapse-branch-<%= bIdx %>">
                    <div class="d-flex align-items-center gap-2 flex-grow-1">
                      <span class="badge bg-primary fs-6 p-2 rounded-2"><i class="fa-solid fa-building"></i></span>
                      <strong class="fs-6 text-dark">فرع <%= bData.branch %></strong>
                      <span class="badge bg-white text-dark border ms-2 shadow-xs">
                        إجمالي الفرع: <strong><%= bData.totals.branchTotal %> طالب</strong>
                      </span>
                    </div>
                    <div class="d-flex align-items-center gap-2 me-3 small d-none d-md-flex">
                      <span class="badge bg-primary-subtle text-primary border border-primary">
                        <i class="fa-solid fa-mars me-1"></i> بنين: <strong><%= bData.totals.boysTotal %></strong> (<%= bData.totals.boysGeneral > 0 ? ('عام: ' + bData.totals.boysGeneral) : '' %><%= (bData.totals.boysGeneral > 0 && bData.totals.boysTahfeez > 0) ? ' | ' : '' %><%= bData.totals.boysTahfeez > 0 ? ('تحفيظ: ' + bData.totals.boysTahfeez) : '' %>)
                      </span>
                      <span class="badge bg-danger-subtle text-danger border border-danger">
                        <i class="fa-solid fa-venus me-1"></i> بنات: <strong><%= bData.totals.girlsTotal %></strong> (<%= bData.totals.girlsGeneral > 0 ? ('عام: ' + bData.totals.girlsGeneral) : '' %><%= (bData.totals.girlsGeneral > 0 && bData.totals.girlsTahfeez > 0) ? ' | ' : '' %><%= bData.totals.girlsTahfeez > 0 ? ('تحفيظ: ' + bData.totals.girlsTahfeez) : '' %>)
                      </span>
                    </div>
                  </button>
                </h2>

                <!-- Accordion Body: Professional Multi-Level Header Data Table (Cross Matrix) -->
                <div id="collapse-branch-<%= bIdx %>" class="accordion-collapse collapse <%= bIdx === 0 ? 'show' : '' %>" aria-labelledby="heading-branch-<%= bIdx %>">
                  <div class="accordion-body p-0 bg-white">
                    <div class="table-responsive">
                      <table class="table table-hover align-middle mb-0 text-center" style="font-size: 13.5px; border-collapse: separate; border-spacing: 0;">
                        <thead class="text-white fw-bold">
                          <!-- ROW 1: MAIN HEADERS -->
                          <tr style="border-bottom: 2px solid #334155;">
                            <th rowspan="2" class="text-end py-3 px-3 align-middle bg-dark text-white" style="width: 22%; border-left: 2px solid #475569;">
                              <i class="fa-solid fa-graduation-cap text-warning me-1"></i> الصف الدراسي
                            </th>
                            <th colspan="3" class="py-2 px-2 text-center text-white" style="background-color: #1e3a8a; border-left: 3px solid #0f172a;">
                              <i class="fa-solid fa-mars text-info me-1"></i> بنين ♂️
                            </th>
                            <th colspan="3" class="py-2 px-2 text-center text-white" style="background-color: #831843; border-left: 3px solid #0f172a;">
                              <i class="fa-solid fa-venus text-pink-300 me-1" style="color: #f472b6;"></i> بنات ♀️
                            </th>
                            <th colspan="3" class="py-2 px-2 text-center text-white bg-black">
                              <i class="fa-solid fa-chart-column text-warning me-1"></i> الإجمالي الكلي 📊
                            </th>
                          </tr>

                          <!-- ROW 2: SUB HEADERS -->
                          <tr class="small text-white font-monospace fw-bold" style="border-bottom: 2px solid #334155;">
                            <!-- Under بنين -->
                            <th class="py-2 px-2 text-center" style="background-color: #2563eb; width: 8%;">عام</th>
                            <th class="py-2 px-2 text-center" style="background-color: #1d4ed8; width: 8%;">تحفيظ</th>
                            <th class="py-2 px-2 text-center" style="background-color: #172554; width: 10%; border-left: 3px solid #0f172a;">الإجمالي</th>

                            <!-- Under بنات -->
                            <th class="py-2 px-2 text-center" style="background-color: #db2777; width: 8%;">عام</th>
                            <th class="py-2 px-2 text-center" style="background-color: #be185d; width: 8%;">تحفيظ</th>
                            <th class="py-2 px-2 text-center" style="background-color: #500724; width: 10%; border-left: 3px solid #0f172a;">الإجمالي</th>

                            <!-- Under الإجمالي الكلي -->
                            <th class="py-2 px-2 text-center" style="background-color: #047857; width: 9%;">إجمالي عام</th>
                            <th class="py-2 px-2 text-center" style="background-color: #b45309; width: 9%;">إجمالي تحفيظ</th>
                            <th class="py-2 px-2 text-center bg-black text-warning" style="width: 11%;">المجموع النهائي</th>
                          </tr>
                        </thead>

                        <tbody class="table-group-divider">
                          <% bData.rows.forEach(function(r, rIdx){ %>
                            <tr class="interactive-data-row <%= rIdx % 2 === 0 ? 'bg-white' : 'bg-light' %>"
                                data-cf-branch="<%= bData.branch %>"
                                data-cf-phase="<%= r.phase %>"
                                data-cf-grade="<%= r.gradeName %>"
                                data-cf-label="فرع <%= bData.branch %> - <%= r.phase %> (<%= r.gradeName %>)"
                                data-cf-boys="<%= r.boysTotal %>"
                                data-cf-girls="<%= r.girlsTotal %>"
                                data-cf-general="<%= r.generalTotal %>"
                                data-cf-tahfeez="<%= r.tahfeezTotal %>"
                                data-cf-total="<%= r.rowTotal %>"
                                onclick="applyRowCrossFilter(this)"
                                title="اضغط لتركيز تحليلات النوع والمسار السفلية على هذا الصف">
                              <!-- 1. Grade Name -->
                              <td class="text-end py-2 px-3 fw-bold text-dark" style="border-left: 2px solid #cbd5e1;">
                                <span class="badge bg-secondary-subtle text-secondary me-1 small"><%= r.phase %></span>
                                <span><%= r.gradeName %></span>
                              </td>

                              <!-- 2. Boys General -->
                              <td class="py-2 px-2 text-primary font-monospace">
                                <%= r.boysGeneral %>
                              </td>

                              <!-- 3. Boys Tahfeez -->
                              <td class="py-2 px-2 text-primary font-monospace">
                                <%= r.boysTahfeez %>
                              </td>

                              <!-- 4. Boys Total (Highlighted & Thick Divider) -->
                              <td class="py-2 px-2 fw-bold text-primary bg-primary-subtle" style="border-left: 3px solid #64748b;">
                                <%= r.boysTotal %>
                              </td>

                              <!-- 5. Girls General -->
                              <td class="py-2 px-2 text-danger font-monospace">
                                <%= r.girlsGeneral %>
                              </td>

                              <!-- 6. Girls Tahfeez -->
                              <td class="py-2 px-2 text-danger font-monospace">
                                <%= r.girlsTahfeez %>
                              </td>

                              <!-- 7. Girls Total (Highlighted & Thick Divider) -->
                              <td class="py-2 px-2 fw-bold text-danger bg-danger-subtle" style="border-left: 3px solid #64748b;">
                                <%= r.girlsTotal %>
                              </td>

                              <!-- 8. Grand General -->
                              <td class="py-2 px-2 text-success font-monospace fw-semibold" style="background-color: #f0fdf4;">
                                <%= r.generalTotal %>
                              </td>

                              <!-- 9. Grand Tahfeez -->
                              <td class="py-2 px-2 text-warning-emphasis font-monospace fw-semibold" style="background-color: #fffbeb;">
                                <%= r.tahfeezTotal %>
                              </td>

                              <!-- 10. Grand Row Total (Final Total Highlighted) -->
                              <td class="py-2 px-2 bg-dark text-white fw-bold">
                                <span class="badge bg-white text-dark px-2 py-1 rounded-pill fw-bold">
                                  <%= r.rowTotal %>
                                </span>
                              </td>
                            </tr>
                          <% }) %>
                        </tbody>

                        <!-- GRAND TOTAL FOOTER -->
                        <tfoot class="fw-bold" style="border-top: 3px solid #0f172a; font-size: 14px;">
                          <tr class="table-secondary">
                            <td class="text-end py-3 px-3 fw-bolder text-dark" style="border-left: 2px solid #94a3b8;">
                              <i class="fa-solid fa-chart-pie text-primary me-1"></i> المجموع الكلي لفرع <%= bData.branch %>
                            </td>

                            <!-- Boys Totals -->
                            <td class="py-3 px-2 font-monospace fw-bold text-primary" style="background-color: #eff6ff;">
                              <%= bData.totals.boysGeneral %>
                            </td>
                            <td class="py-3 px-2 font-monospace fw-bold text-primary" style="background-color: #eff6ff;">
                              <%= bData.totals.boysTahfeez %>
                            </td>
                            <td class="py-3 px-2 font-monospace fw-bolder text-primary bg-primary-subtle" style="border-left: 3px solid #64748b;">
                              <%= bData.totals.boysTotal %>
                            </td>

                            <!-- Girls Totals -->
                            <td class="py-3 px-2 font-monospace fw-bold text-danger" style="background-color: #fdf2f8;">
                              <%= bData.totals.girlsGeneral %>
                            </td>
                            <td class="py-3 px-2 font-monospace fw-bold text-danger" style="background-color: #fdf2f8;">
                              <%= bData.totals.girlsTahfeez %>
                            </td>
                            <td class="py-3 px-2 font-monospace fw-bolder text-danger bg-danger-subtle" style="border-left: 3px solid #64748b;">
                              <%= bData.totals.girlsTotal %>
                            </td>

                            <!-- Grand General & Tahfeez & Final Total -->
                            <td class="py-3 px-2 font-monospace fw-bolder text-success" style="background-color: #ecfdf5;">
                              <%= bData.totals.generalTotal %>
                            </td>
                            <td class="py-3 px-2 font-monospace fw-bolder text-warning-emphasis" style="background-color: #fffbeb;">
                              <%= bData.totals.tahfeezTotal %>
                            </td>
                            <td class="py-3 px-2 bg-black text-white fw-bolder">
                              <span class="fs-6 text-warning font-monospace"><%= bData.totals.branchTotal %> طالب</span>
                            </td>
                          </tr>
                        </tfoot>
                      </table>
                    </div>
                  </div>
                </div>

              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-4 text-muted">
            <i class="fa-solid fa-inbox fs-2 mb-2 d-block text-secondary"></i>
            <span>لا توجد بيانات طلاب مطابقة لمعايير الفلترة المحددة</span>
          </div>
        <% } %>
      </div>
    </div>

    <!-- 3. DETAILED BRANCH & PHASES BREAKDOWN TABLE (FEATURE 3 - IMPORTANT) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
          <i class="fa-solid fa-table-cells text-primary"></i>
          <span>التحليل التفصيلي للفروع والمراحل الدراسية</span>
        </h5>
        <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 fw-bold">
          النطاق المعروض: <%= analytics.branchLabel %>
        </span>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0 text-nowrap text-center">
          <thead>
            <tr>
              <th class="text-end" style="width: 160px;">الفرع</th>
              <th class="text-end" style="width: 140px;">المرحلة الدراسية</th>
              <th>إجمالي المتقدمين</th>
              <th>المقبولين</th>
              <th>تم التسجيل</th>
              <th>في انتظار المقابلة</th>
              <th>في انتظار التسجيل</th>
              <th>نسبة الإنجاز</th>
            </tr>
          </thead>
          <tbody>
            <% if(detailedBranchPhaseStats && detailedBranchPhaseStats.length > 0){ %>
              <% detailedBranchPhaseStats.forEach(function(branchGroup){ %>
                <% branchGroup.phasesData.forEach(function(pData, pIdx){ 
                  const completionRate = pData.total > 0 ? Math.round(pData.registered / pData.total * 100) : 0;
                %>
                  <tr class="interactive-data-row"
                      data-cf-branch="<%= branchGroup.branch %>"
                      data-cf-phase="<%= pData.phase %>"
                      data-cf-grade=""
                      data-cf-label="فرع <%= branchGroup.branch %> - <%= pData.phase %>"
                      data-cf-boys="<%= pData.boys || 0 %>"
                      data-cf-girls="<%= pData.girls || 0 %>"
                      data-cf-general="<%= pData.general || 0 %>"
                      data-cf-tahfeez="<%= pData.tahfeez || 0 %>"
                      data-cf-total="<%= pData.total || 0 %>"
                      onclick="applyRowCrossFilter(this)"
                      title="اضغط لتركيز تحليلات النوع والمسار السفلية على هذه المرحلة">
                    <% if(pIdx === 0){ %>
                      <td class="text-end fw-bold text-dark bg-light border-end" rowspan="<%= branchGroup.phasesData.length %>" style="vertical-align: middle;">
                        <i class="fa-solid fa-school text-primary me-1"></i>
                        فرع <%= branchGroup.branch %>
                        <div class="small text-muted fw-normal mt-1">(إجمالي الفرع: <%= branchGroup.total %>)</div>
                      </td>
                    <% } %>
                    <td class="text-end fw-bold text-secondary border-end"><%= pData.phase %></td>
                    <td><span class="badge bg-light text-dark border px-2 py-1"><%= pData.total %></span></td>
                    <td><span class="badge bg-success-subtle text-success border border-success px-2 py-1"><%= pData.accepted %></span></td>
                    <td><span class="badge bg-info-subtle text-info border border-info px-2 py-1 fw-bold"><%= pData.registered %></span></td>
                    <td><span class="badge bg-secondary-subtle text-secondary border px-2 py-1"><%= pData.pending_interview %></span></td>
                    <td><span class="badge bg-warning-subtle text-warning border border-warning px-2 py-1"><%= pData.waiting_registration %></span></td>
                    <td style="min-width: 140px;">
                      <div class="d-flex align-items-center gap-2 justify-content-center">
                        <div class="progress flex-grow-1" style="height: 8px;">
                          <div class="progress-bar bg-success" role="progressbar" style="width: <%= completionRate %>%"></div>
                        </div>
                        <small class="fw-bold text-muted"><%= completionRate %>%</small>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">لا توجد بيانات متاحة</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ACTIVE CROSS-FILTER BANNER (DYNAMIC FOCUS) -->
    <div id="activeCrossFilterBanner" class="alert alert-primary border-primary d-none align-items-center justify-content-between mb-4 rounded-3 py-2 px-3 shadow-sm" role="alert">
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-primary fs-6 p-2 rounded-circle"><i class="fa-solid fa-filter"></i></span>
        <div>
          <span class="fw-bold text-dark">تركيز التحليل اللحظي (Interactive Focus):</span>
          <span id="activeCrossFilterLabel" class="badge bg-white text-primary border border-primary fs-7 ms-2 px-3 py-1 fw-bold"></span>
          <span id="activeCrossFilterCount" class="badge bg-primary text-white fs-7 ms-1 px-2 py-1"></span>
        </div>
      </div>
      <button type="button" class="btn btn-outline-primary btn-sm fw-bold px-3 d-inline-flex align-items-center gap-1 shadow-xs" onclick="clearRowCrossFilter()">
        <i class="fa-solid fa-xmark"></i>
        <span>إلغاء التحديد والعودة للعرض الشامل</span>
      </button>
    </div>

    <!-- 4. GENDER & TRACK CATEGORY ANALYSIS (FEATURE 4) -->
    <div class="row g-4 mb-4" id="distributionCardsContainer">
      <!-- GENDER ANALYSIS (بنين / بنات) -->
      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
          <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-venus-mars text-primary me-2"></i> توزيع الطلاب حسب النوع (بنين / بنات)
            </h6>
            <span id="genderScopeBadge" class="badge bg-light text-secondary border px-2 py-1 small">حسب الفلترة الحالية</span>
          </div>
          <div class="card-body p-4 pt-2">
            <% 
              const boysCount = analytics.typeStats['بنين'] || 0;
              const girlsCount = analytics.typeStats['بنات'] || 0;
              const totalGender = boysCount + girlsCount;
              const boysPercent = totalGender > 0 ? Math.round(boysCount / totalGender * 100) : 0;
              const girlsPercent = totalGender > 0 ? Math.round(girlsCount / totalGender * 100) : 0;
            %>
            
            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-primary"><i class="fa-solid fa-mars me-1"></i> بنين</span>
                <span id="cfBadgeBoys" class="badge bg-primary-subtle text-primary fs-7 fw-bold"
                      data-default-count="<%= boysCount %>"
                      data-default-percent="<%= boysPercent %>"><%= boysCount %> طالب (<%= boysPercent %>%)</span>
              </div>
              <div class="progress" style="height: 14px;">
                <div id="cfBarBoys" class="progress-bar bg-primary animated-progress-bar" role="progressbar" style="width: <%= boysPercent %>%;"
                     data-default-percent="<%= boysPercent %>"></div>
              </div>
            </div>

            <div>
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold" style="color: #ec4899;"><i class="fa-solid fa-venus me-1"></i> بنات</span>
                <span id="cfBadgeGirls" class="badge fs-7 fw-bold" style="background: #fdf2f8; color: #ec4899; border: 1px solid #fbcfe8;"
                      data-default-count="<%= girlsCount %>"
                      data-default-percent="<%= girlsPercent %>"><%= girlsCount %> طالبة (<%= girlsPercent %>%)</span>
              </div>
              <div class="progress" style="height: 14px;">
                <div id="cfBarGirls" class="progress-bar animated-progress-bar" role="progressbar" style="width: <%= girlsPercent %>%; background-color: #ec4899;"
                     data-default-percent="<%= girlsPercent %>"></div>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- TRACK ANALYSIS (عام / تحفيظ) -->
      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
          <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-book-bookmark text-success me-2"></i> توزيع الطلاب حسب المسار التعليمي (عام / تحفيظ)
            </h6>
            <span id="trackScopeBadge" class="badge bg-light text-secondary border px-2 py-1 small">حسب الفلترة الحالية</span>
          </div>
          <div class="card-body p-4 pt-2">
            <% 
              const generalCount = analytics.trackStats['عام'] || 0;
              const tahfeezCount = analytics.trackStats['تحفيظ'] || 0;
              const totalTracks = generalCount + tahfeezCount;
              const generalPercent = totalTracks > 0 ? Math.round(generalCount / totalTracks * 100) : 0;
              const tahfeezPercent = totalTracks > 0 ? Math.round(tahfeezCount / totalTracks * 100) : 0;
            %>
            
            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-dark"><i class="fa-solid fa-graduation-cap me-1 text-secondary"></i> مسار عام</span>
                <span id="cfBadgeGeneral" class="badge bg-secondary-subtle text-dark fs-7 fw-bold"
                      data-default-count="<%= generalCount %>"
                      data-default-percent="<%= generalPercent %>"><%= generalCount %> طالب (<%= generalPercent %>%)</span>
              </div>
              <div class="progress" style="height: 14px;">
                <div id="cfBarGeneral" class="progress-bar bg-secondary animated-progress-bar" role="progressbar" style="width: <%= generalPercent %>%;"
                     data-default-percent="<%= generalPercent %>"></div>
              </div>
            </div>

            <div>
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-success"><i class="fa-solid fa-quran me-1"></i> مسار تحفيظ القرآن</span>
                <span id="cfBadgeTahfeez" class="badge bg-success-subtle text-success fs-7 fw-bold"
                      data-default-count="<%= tahfeezCount %>"
                      data-default-percent="<%= tahfeezPercent %>"><%= tahfeezCount %> طالب (<%= tahfeezPercent %>%)</span>
              </div>
              <div class="progress" style="height: 14px;">
                <div id="cfBarTahfeez" class="progress-bar bg-success animated-progress-bar" role="progressbar" style="width: <%= tahfeezPercent %>%;"
                     data-default-percent="<%= tahfeezPercent %>"></div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

    <!-- 5. SIBLINGS ANALYSIS & NATIONALITY DISTRIBUTION ROW -->
    <div class="row g-3 mt-2 mb-4">
      <!-- SIBLINGS ANALYSIS CARD -->
      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
          <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-people-roof text-warning me-2"></i> تحليل الإخوة (عائلات متعددة الطلاب)
            </h6>
            <span class="badge bg-warning-subtle text-dark fw-bold border border-warning">
              <%= analytics.siblingStats ? analytics.siblingStats.siblingFamiliesCount : 0 %> أسر
            </span>
          </div>
          <div class="card-body p-4 pt-2">
            <% const sib = analytics.siblingStats || { siblingFamiliesCount: 0, siblingStudentsTotal: 0, siblingFamiliesList: [] }; %>
            <div class="d-flex align-items-center justify-content-around bg-light p-3 rounded-3 mb-3 text-center border">
              <div>
                <div class="fs-4 fw-bold text-warning"><%= sib.siblingFamiliesCount %></div>
                <div class="small text-muted fw-bold">أسر لديها أكثر من طالب</div>
              </div>
              <div class="border-start h-100 mx-2"></div>
              <div>
                <div class="fs-4 fw-bold text-primary"><%= sib.siblingStudentsTotal %></div>
                <div class="small text-muted fw-bold">إجمالي أعداد الإخوة</div>
              </div>
            </div>

            <% if (sib.siblingFamiliesList && sib.siblingFamiliesList.length > 0) { %>
              <div class="small fw-bold text-secondary mb-2"><i class="fa-solid fa-list-ul me-1"></i> أسر الإخوة المسجلين:</div>
              <div class="list-group list-group-flush border rounded-3 overflow-auto" style="max-height: 180px;">
                <% sib.siblingFamiliesList.forEach(function(fam) { %>
                  <div class="list-group-item p-2">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                      <span class="fw-bold text-dark small"><i class="fa-solid fa-phone me-1 text-success"></i> <%= fam.phone %></span>
                      <span class="badge bg-primary-subtle text-primary rounded-pill"><%= fam.count %> إخوة</span>
                    </div>
                    <div class="small text-muted">
                      <% fam.students.forEach(function(st) { %>
                        <span class="badge bg-light text-dark border me-1"><%= st.name %> (<%= st.phase || '' %> <%= st.grade ? 'صف ' + st.grade : '' %>)</span>
                      <% }); %>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="text-center text-muted py-4 small">
                <i class="fa-solid fa-user-group fs-3 d-block mb-1 text-secondary"></i>
                لا توجد أسر لديها إخوة مسجلين حالياً بنفس رقم الجوال
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- NATIONALITY DISTRIBUTION -->
      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
          <div class="card-header bg-white py-3 border-0">
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-globe text-info me-2"></i> توزيع الطلاب حسب الجنسية
              <span class="badge bg-info-subtle text-info ms-2" id="nationalityTotalBadge"><%= analytics.total %> طالب</span>
            </h6>
          </div>
          <div class="card-body p-4 pt-2">
            <%
              const natColors = ['primary','success','danger','warning','info','secondary','dark'];
              const natEntries = Object.entries(analytics.nationalityStats || {}).sort((a,b)=>b[1]-a[1]);
            %>
            <div class="row g-3" id="nationalityListContainer">
              <% natEntries.forEach(function([nat, cnt], i){ %>
                <%
                  const natPct = analytics.total > 0 ? Math.round(cnt / analytics.total * 100) : 0;
                  const col = natColors[i % natColors.length];
                %>
                <div class="col-md-6 col-sm-6">
                  <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold text-dark small"><i class="fa-solid fa-flag me-1 text-<%= col %>"></i> <%= nat %></span>
                    <span class="badge bg-<%= col %>-subtle text-<%= col %> border fw-bold"><%= cnt %> (<%= natPct %>%)</span>
                  </div>
                  <div class="progress" style="height:10px; border-radius:6px;">
                    <div class="progress-bar bg-<%= col %>" role="progressbar" style="width:<%= natPct %>%"></div>
                  </div>
                </div>
              <% }) %>
              <% if(!natEntries.length){ %>
                <div class="col-12 text-center text-muted py-3"><i class="fa-solid fa-chart-pie me-2"></i> لا توجد بيانات جنسيات متاحة</div>
              <% } %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 6. REGISTRATION SOURCE BREAKDOWN CARD (الرابط الخارجي vs التسجيل الداخلي) -->
    <div class="row g-3 mb-4">
      <div class="col-12">
        <div class="card border-0 shadow-sm rounded-3">
          <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
              <i class="fa-solid fa-chart-column text-primary"></i>
              <span>الرسم البياني لمصادر التسجيل (الرابط الخارجي أونلاين vs التسجيل الداخلي بالمدرسة)</span>
            </h6>
            <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-1 fw-bold" id="sourceCardScopeBadge">
              إجمالي الطلاب: <%= analytics.total %> طالب
            </span>
          </div>
          <div class="card-body p-4 pt-2">
            <%
              const sStats = analytics.sourceStats || { online_count: 0, internal_count: 0, online_percent: 0, internal_percent: 0 };
              const onlineCount = sStats.online_count || 0;
              const internalCount = sStats.internal_count || 0;
              const onlinePct = sStats.online_percent || 0;
              const internalPct = sStats.internal_percent || 0;
            %>
            <div class="row g-4 align-items-center">
              <!-- Online Applicants (External Portal) -->
              <div class="col-md-6">
                <div class="p-3 rounded-3 border bg-light">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-info fs-6">
                      <i class="fa-solid fa-globe me-1"></i> الرابط الخارجي (أونلاين)
                    </span>
                    <span id="sourceBadgeOnline" class="badge bg-info-subtle text-info border border-info fs-7 fw-bold px-3 py-1">
                      <%= onlineCount %> طالب (<%= onlinePct %>%)
                    </span>
                  </div>
                  <div class="progress" style="height: 16px;">
                    <div id="sourceBarOnline" class="progress-bar bg-info animated-progress-bar" role="progressbar" style="width: <%= onlinePct %>%;"></div>
                  </div>
                  <div class="mt-2 text-muted small d-flex justify-content-between">
                    <span>مسجلون عبر الرابط العام لأولياء الأمور</span>
                    <span class="fw-bold text-dark"><span id="sourceCountOnline"><%= onlineCount %></span> مسجل</span>
                  </div>
                </div>
              </div>

              <!-- Internal Applicants (In-School) -->
              <div class="col-md-6">
                <div class="p-3 rounded-3 border bg-light">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold text-secondary fs-6">
                      <i class="fa-solid fa-school me-1"></i> التسجيل الداخلي (المدرسة)
                    </span>
                    <span id="sourceBadgeInternal" class="badge bg-secondary-subtle text-secondary border border-secondary fs-7 fw-bold px-3 py-1">
                      <%= internalCount %> طالب (<%= internalPct %>%)
                    </span>
                  </div>
                  <div class="progress" style="height: 16px;">
                    <div id="sourceBarInternal" class="progress-bar bg-secondary animated-progress-bar" role="progressbar" style="width: <%= internalPct %>%;"></div>
                  </div>
                  <div class="mt-2 text-muted small d-flex justify-content-between">
                    <span>مسجلون حضورياً عبر إدارة المدرسة</span>
                    <span class="fw-bold text-dark"><span id="sourceCountInternal"><%= internalCount %></span> مسجل</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  <!-- SELF CHANGE PASSWORD MODAL -->
  <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-light">
          <h5 class="modal-title fw-bold text-dark">
            <i class="fa-solid fa-key text-warning me-2"></i> تغيير كلمة المرور الخاصة بي
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form method="post" action="/change_password">
          <div class="modal-body p-4">
            <div class="mb-3">
              <label class="form-label fw-bold small text-dark">كلمة المرور الحالية <span class="text-danger">*</span></label>
              <input type="password" name="current_password" class="form-control" required placeholder="••••••••">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small text-dark">كلمة المرور الجديدة <span class="text-danger">*</span></label>
              <input type="password" name="new_password" class="form-control" required placeholder="••••••••">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small text-dark">تأكيد كلمة المرور الجديدة <span class="text-danger">*</span></label>
              <input type="password" name="confirm_password" class="form-control" required placeholder="••••••••">
            </div>
          </div>
          <div class="modal-footer bg-light d-flex justify-content-start gap-2">
            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
              <i class="fa-solid fa-check me-1"></i> تحديث كلمة المرور
            </button>
            <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">إلغاء</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function toggleAllBranchAccordions(open) {
      const items = document.querySelectorAll('#demographicBranchesAccordion .accordion-collapse');
      const buttons = document.querySelectorAll('#demographicBranchesAccordion .accordion-button');
      items.forEach(el => {
        if (open) {
          el.classList.add('show');
        } else {
          el.classList.remove('show');
        }
      });
      buttons.forEach(btn => {
        if (open) {
          btn.classList.remove('collapsed');
          btn.setAttribute('aria-expanded', 'true');
        } else {
          btn.classList.add('collapsed');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Client-side dataset for instant reactive updates (Derived State)
    window.allAnalyticsStudents = <%- JSON.stringify(typeof clientStudents !== 'undefined' ? clientStudents : []) %>;
    window.rawData = window.allAnalyticsStudents;
    window.filteredData = window.allAnalyticsStudents;

    // Dedicated Nationality Distribution Chart Component (accepts filteredData strictly)
    function renderNationalityChart(filteredData) {
      const natContainer = document.getElementById('nationalityListContainer');
      const natTotalBadge = document.getElementById('nationalityTotalBadge');
      
      if (!filteredData || filteredData.length === 0) {
        if (natTotalBadge) natTotalBadge.textContent = '0 طالب';
        if (natContainer) {
          natContainer.innerHTML = '<div class="col-12 text-center text-muted py-3"><i class="fa-solid fa-chart-pie me-2"></i> لا توجد بيانات جنسيات متاحة للفلتر المحدد</div>';
        }
        return;
      }

      const total = filteredData.length;
      if (natTotalBadge) natTotalBadge.textContent = total + ' طالب';

      const natMap = {};
      filteredData.forEach(s => {
        const n = (s.nationality || 'غير محدد').trim();
        natMap[n] = (natMap[n] || 0) + 1;
      });

      const natColors = ['primary', 'success', 'danger', 'warning', 'info', 'secondary', 'dark'];
      const entries = Object.entries(natMap).sort((a, b) => b[1] - a[1]);

      if (entries.length === 0) {
        if (natContainer) {
          natContainer.innerHTML = '<div class="col-12 text-center text-muted py-3"><i class="fa-solid fa-chart-pie me-2"></i> لا توجد بيانات جنسيات متاحة</div>';
        }
        return;
      }

      let natHtml = '';
      entries.forEach(([nat, cnt], i) => {
        const natPct = total > 0 ? Math.round((cnt / total) * 100) : 0;
        const col = natColors[i % natColors.length];
        natHtml += `
          <div class="col-md-6 col-sm-6">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="fw-bold text-dark small"><i class="fa-solid fa-flag me-1 text-${col}"></i> ${nat}</span>
              <span class="badge bg-${col}-subtle text-${col} border fw-bold">${cnt} (${natPct}%)</span>
            </div>
            <div class="progress" style="height:10px; border-radius:6px;">
              <div class="progress-bar bg-${col}" role="progressbar" style="width:${natPct}%"></div>
            </div>
          </div>
        `;
      });

      if (natContainer) natContainer.innerHTML = natHtml;
    }
    window.renderNationalityChart = renderNationalityChart;

    function updateClientSideAggregations(branch, phase, grade, type, track, source) {
      const normBranch = (branch || 'الكل').trim();
      const normPhase = (phase || 'الكل').trim();
      const normGrade = (grade || 'الكل').trim();
      const normType = (type || 'الكل').trim();
      const normTrack = (track || 'الكل').trim();
      const normSource = (source || 'الكل').trim();

      const filtered = (window.allAnalyticsStudents || []).filter(s => {
        const sBranch = (s.branch || '').trim();
        const sPhase = (s.phase || '').trim();
        const sGrade = String(s.grade || '').trim();
        const sType = (s.student_type || 'بنين').trim();
        const sTrack = (s.track || 'عام').trim();
        const sSource = (s.registration_source || '').trim();

        if (normBranch !== 'الكل' && sBranch !== normBranch) return false;
        if (normPhase !== 'الكل' && sPhase !== normPhase) return false;
        if (normGrade !== 'الكل' && sGrade !== normGrade) return false;
        if (normType !== 'الكل' && sType !== normType) return false;
        if (normTrack !== 'الكل' && sTrack !== normTrack) return false;
        if (normSource !== 'الكل' && normSource !== 'جميع المصادر') {
          const isOnline = sSource === 'رابط خارجي';
          if (normSource === 'الرابط الخارجي' || normSource === 'رابط خارجي' || normSource === 'external') {
            if (!isOnline) return false;
          } else {
            if (isOnline) return false;
          }
        }
        return true;
      });

      // Update global state references
      window.filteredData = filtered;

      const total = filtered.length;
      const accepted = filtered.filter(s => (s.interview_result || '').trim() === 'مقبول' && s.status !== 'unavailable_grade').length;
      const rejected = filtered.filter(s => (s.interview_result || '').trim() === 'غير مقبول' && s.status !== 'unavailable_grade').length;
      const registered = filtered.filter(s => (s.followup_status || '').trim() === 'تم التسجيل' && s.status !== 'unavailable_grade').length;
      const waiting = filtered.filter(s => (s.followup_status || '').trim() === 'في انتظار التسجيل' && s.status !== 'unavailable_grade').length;
      const pending_interview = filtered.filter(s => (s.interview_result || '').trim() === 'في انتظار المقابلة' && s.status !== 'unavailable_grade').length;

      // Update Top Stat Cards
      const elTotal = document.getElementById('statTotal');
      const elAccepted = document.getElementById('statAccepted');
      const elRejected = document.getElementById('statRejected');
      const elRegistered = document.getElementById('statRegistered');
      const elWaiting = document.getElementById('statWaiting');
      const elPending = document.getElementById('statPendingInterview');

      if (elTotal) elTotal.textContent = total;
      if (elAccepted) elAccepted.textContent = accepted;
      if (elRejected) elRejected.textContent = rejected;
      if (elRegistered) elRegistered.textContent = registered;
      if (elWaiting) elWaiting.textContent = waiting;
      if (elPending) elPending.textContent = pending_interview;

      // Update Rates
      const acceptRate = total > 0 ? Math.round((accepted / total) * 1000) / 10 : 0;
      const regRate = total > 0 ? Math.round((registered / total) * 1000) / 10 : 0;
      const convRate = accepted > 0 ? Math.round((registered / accepted) * 1000) / 10 : 0;

      const elAcceptRate = document.getElementById('statAcceptanceRate');
      const elRegRate = document.getElementById('statRegistrationRate');
      const elConvRate = document.getElementById('statConversionRate');
      if (elAcceptRate) elAcceptRate.textContent = acceptRate + '%';
      if (elRegRate) elRegRate.textContent = regRate + '%';
      if (elConvRate) elConvRate.textContent = convRate + '%';

      // Update Gender Distribution
      const boys = filtered.filter(s => (s.student_type || '').trim() === 'بنين').length;
      const girls = filtered.filter(s => (s.student_type || '').trim() === 'بنات').length;
      const genderSum = boys + girls;
      const boysPct = genderSum > 0 ? Math.round((boys / genderSum) * 100) : 0;
      const girlsPct = genderSum > 0 ? Math.round((girls / genderSum) * 100) : 0;

      const barBoys = document.getElementById('cfBarBoys');
      const barGirls = document.getElementById('cfBarGirls');
      const badgeBoys = document.getElementById('cfBadgeBoys');
      const badgeGirls = document.getElementById('cfBadgeGirls');
      if (barBoys) { barBoys.style.width = boysPct + '%'; barBoys.setAttribute('data-default-percent', boysPct); }
      if (barGirls) { barGirls.style.width = girlsPct + '%'; barGirls.setAttribute('data-default-percent', girlsPct); }
      if (badgeBoys) { badgeBoys.textContent = `${boys} طالب (${boysPct}%)`; badgeBoys.setAttribute('data-default-count', boys); badgeBoys.setAttribute('data-default-percent', boysPct); }
      if (badgeGirls) { badgeGirls.textContent = `${girls} طالبة (${girlsPct}%)`; badgeGirls.setAttribute('data-default-count', girls); badgeGirls.setAttribute('data-default-percent', girlsPct); }

      // Update Track Distribution
      const general = filtered.filter(s => ((s.track || 'عام')).trim() === 'عام').length;
      const tahfeez = filtered.filter(s => (s.track || '').trim() === 'تحفيظ').length;
      const trackSum = general + tahfeez;
      const genPct = trackSum > 0 ? Math.round((general / trackSum) * 100) : 0;
      const tahPct = trackSum > 0 ? Math.round((tahfeez / trackSum) * 100) : 0;

      const barGen = document.getElementById('cfBarGeneral');
      const barTah = document.getElementById('cfBarTahfeez');
      const badgeGen = document.getElementById('cfBadgeGeneral');
      const badgeTah = document.getElementById('cfBadgeTahfeez');
      if (barGen) { barGen.style.width = genPct + '%'; barGen.setAttribute('data-default-percent', genPct); }
      if (barTah) { barTah.style.width = tahPct + '%'; barTah.setAttribute('data-default-percent', tahPct); }
      if (badgeGen) { badgeGen.textContent = `${general} طالب (${genPct}%)`; badgeGen.setAttribute('data-default-count', general); badgeGen.setAttribute('data-default-percent', genPct); }
      if (badgeTah) { badgeTah.textContent = `${tahfeez} طالب (${tahPct}%)`; badgeTah.setAttribute('data-default-count', tahfeez); badgeTah.setAttribute('data-default-percent', tahPct); }

      // Update Waitlist Demand (Demand for unavailable grades)
      const unavailableCount = filtered.filter(student => student.status === 'unavailable_grade').length;
      const waitlist = unavailableCount;
      const waitlistRate = total > 0 ? Math.round((waitlist / total) * 1000) / 10 : 0;
      const elWaitlist = document.getElementById('statWaitlistCount');
      const elWaitlistRate = document.getElementById('statWaitlistRate');
      if (elWaitlist) elWaitlist.textContent = waitlist;
      if (elWaitlistRate) elWaitlistRate.textContent = waitlistRate + '%';

      // Update Source Stats Card Dynamically
      const onlineTotal = filtered.filter(s => (s.registration_source || '').trim() === 'رابط خارجي').length;
      const internalTotal = filtered.filter(s => (s.registration_source || '').trim() !== 'رابط خارجي').length;
      const onlinePct = total > 0 ? Math.round((onlineTotal / total) * 100) : 0;
      const internalPct = total > 0 ? Math.round((internalTotal / total) * 100) : 0;

      const barOnline = document.getElementById('sourceBarOnline');
      const barInternal = document.getElementById('sourceBarInternal');
      const badgeOnline = document.getElementById('sourceBadgeOnline');
      const badgeInternal = document.getElementById('sourceBadgeInternal');
      const countOnline = document.getElementById('sourceCountOnline');
      const countInternal = document.getElementById('sourceCountInternal');
      const scopeBadge = document.getElementById('sourceCardScopeBadge');

      if (barOnline) barOnline.style.width = onlinePct + '%';
      if (barInternal) barInternal.style.width = internalPct + '%';
      if (badgeOnline) badgeOnline.textContent = `${onlineTotal} طالب (${onlinePct}%)`;
      if (badgeInternal) badgeInternal.textContent = `${internalTotal} طالب (${internalPct}%)`;
      if (countOnline) countOnline.textContent = onlineTotal;
      if (countInternal) countInternal.textContent = internalTotal;
      if (scopeBadge) scopeBadge.textContent = `إجمالي الطلاب: ${total} طالب`;

      // Update Nationality Distribution dynamically based on filteredData
      renderNationalityChart(filtered);
    }

    function refreshAnalytics() {
      const branchSel = document.getElementById('branchFilterSelect');
      const phaseSel = document.getElementById('phaseFilterSelect');
      const gradeSel = document.getElementById('gradeFilterSelect');
      const typeSel = document.getElementById('typeFilterSelect');
      const trackSel = document.getElementById('trackFilterSelect');
      const sourceSel = document.getElementById('sourceFilterSelect');

      const branch = branchSel ? branchSel.value : 'الكل';
      const phase = phaseSel ? phaseSel.value : 'الكل';
      const grade = gradeSel ? gradeSel.value : 'الكل';
      const type = typeSel ? typeSel.value : 'الكل';
      const track = trackSel ? trackSel.value : 'الكل';
      const source = sourceSel ? sourceSel.value : 'الكل';
      const spinner = document.getElementById('filterLoadingSpinner');

      const startInput = document.getElementById('filterStartDate');
      const endInput = document.getElementById('filterEndDate');
      const startDate = startInput ? startInput.value.trim() : '';
      const endDate = endInput ? endInput.value.trim() : '';

      if (spinner) spinner.classList.remove('d-none');

      // 1. Instant client-side derived state calculation
      if (window.allAnalyticsStudents && window.allAnalyticsStudents.length > 0) {
        updateClientSideAggregations(branch, phase, grade, type, track, source);
      }

      const params = new URLSearchParams();
      if (branch) params.set('branch', branch);
      if (phase) params.set('phase', phase);
      if (grade) params.set('grade', grade);
      if (type) params.set('type', type);
      if (track) params.set('track', track);
      if (source) params.set('source', source);
      if (startDate) params.set('startDate', startDate);
      if (endDate) params.set('endDate', endDate);

      const url = '/analytics?' + params.toString();
      window.history.pushState({ branch, phase, grade, type, track, source, startDate, endDate }, '', url);

      const container = document.getElementById('analyticsMainContent');
      if (container) {
        container.style.opacity = '0.6';
      }

      fetch(url)
        .then(res => res.text())
        .then(html => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');

          // Update filter form options if present
          const newForm = doc.getElementById('analyticsFilterForm');
          const currentForm = document.getElementById('analyticsFilterForm');
          if (newForm && currentForm) {
            currentForm.innerHTML = newForm.innerHTML;
          }

          const newContent = doc.getElementById('analyticsMainContent');
          if (newContent && container) {
            container.innerHTML = newContent.innerHTML;
            container.style.opacity = '1';
          } else {
            window.location.reload();
          }
        })
        .catch(err => {
          console.error('Failed to refresh analytics:', err);
          window.location.href = url;
        })
        .finally(() => {
          if (spinner) spinner.classList.add('d-none');
        });
    }

    // Handle browser Back/Forward navigation
    window.addEventListener('popstate', function(e) {
      if (e.state) {
        const branchSel = document.getElementById('branchFilterSelect');
        const phaseSel = document.getElementById('phaseFilterSelect');
        const gradeSel = document.getElementById('gradeFilterSelect');
        const typeSel = document.getElementById('typeFilterSelect');
        const trackSel = document.getElementById('trackFilterSelect');
        const sourceSel = document.getElementById('sourceFilterSelect');
        if (branchSel && e.state.branch) branchSel.value = e.state.branch;
        if (phaseSel && e.state.phase) phaseSel.value = e.state.phase;
        if (gradeSel && e.state.grade) gradeSel.value = e.state.grade;
        if (typeSel && e.state.type) typeSel.value = e.state.type;
        if (trackSel && e.state.track) trackSel.value = e.state.track;
        if (sourceSel && e.state.source) sourceSel.value = e.state.source;
      }
      refreshAnalytics();
    });

    // -------------------------------------------------------------
    // INTERACTIVE CROSS-FILTERING (Click-to-Filter on Tables)
    // -------------------------------------------------------------
    let currentSelectedCrossFilterRow = null;

    function applyRowCrossFilter(rowEl) {
      if (!rowEl) return;

      // If already selected, clicking again acts as toggle to clear
      if (rowEl.classList.contains('active-row-filtered')) {
        clearRowCrossFilter();
        return;
      }

      // Remove active class from any previous rows
      document.querySelectorAll('.interactive-data-row.active-row-filtered').forEach(el => {
        el.classList.remove('active-row-filtered');
      });

      // Highlight this row
      rowEl.classList.add('active-row-filtered');
      currentSelectedCrossFilterRow = rowEl;

      // Extract row data attributes
      const label = rowEl.getAttribute('data-cf-label') || 'العنصر المختار';
      const boys = parseInt(rowEl.getAttribute('data-cf-boys') || 0);
      const girls = parseInt(rowEl.getAttribute('data-cf-girls') || 0);
      const general = parseInt(rowEl.getAttribute('data-cf-general') || 0);
      const tahfeez = parseInt(rowEl.getAttribute('data-cf-tahfeez') || 0);
      const total = parseInt(rowEl.getAttribute('data-cf-total') || (boys + girls));

      // Calculate localized percentages
      const genderSum = boys + girls;
      const boysPct = genderSum > 0 ? Math.round((boys / genderSum) * 100) : 0;
      const girlsPct = genderSum > 0 ? Math.round((girls / genderSum) * 100) : 0;

      const trackSum = general + tahfeez;
      const generalPct = trackSum > 0 ? Math.round((general / trackSum) * 100) : 0;
      const tahfeezPct = trackSum > 0 ? Math.round((tahfeez / trackSum) * 100) : 0;

      // Update Active Filter Banner
      const banner = document.getElementById('activeCrossFilterBanner');
      const bannerLabel = document.getElementById('activeCrossFilterLabel');
      const bannerCount = document.getElementById('activeCrossFilterCount');
      if (banner && bannerLabel && bannerCount) {
        bannerLabel.textContent = label;
        bannerCount.textContent = total + ' طالب مسجل';
        banner.classList.remove('d-none');
        banner.classList.add('d-flex');
      }

      // Update Gender Distribution Bars with smooth transitions
      const barBoys = document.getElementById('cfBarBoys');
      const barGirls = document.getElementById('cfBarGirls');
      const badgeBoys = document.getElementById('cfBadgeBoys');
      const badgeGirls = document.getElementById('cfBadgeGirls');
      const genderScope = document.getElementById('genderScopeBadge');

      if (barBoys) barBoys.style.width = boysPct + '%';
      if (barGirls) barGirls.style.width = girlsPct + '%';
      if (badgeBoys) badgeBoys.textContent = `${boys} طالب (${boysPct}%)`;
      if (badgeGirls) badgeGirls.textContent = `${girls} طالبة (${girlsPct}%)`;
      if (genderScope) {
        genderScope.textContent = 'تركيز: ' + label;
        genderScope.className = 'badge bg-primary text-white border border-primary px-2 py-1 small pulse-badge';
      }

      // Update Track Distribution Bars with smooth transitions
      const barGeneral = document.getElementById('cfBarGeneral');
      const barTahfeez = document.getElementById('cfBarTahfeez');
      const badgeGeneral = document.getElementById('cfBadgeGeneral');
      const badgeTahfeez = document.getElementById('cfBadgeTahfeez');
      const trackScope = document.getElementById('trackScopeBadge');

      if (barGeneral) barGeneral.style.width = generalPct + '%';
      if (barTahfeez) barTahfeez.style.width = tahfeezPct + '%';
      if (badgeGeneral) badgeGeneral.textContent = `${general} طالب (${generalPct}%)`;
      if (badgeTahfeez) badgeTahfeez.textContent = `${tahfeez} طالب (${tahfeezPct}%)`;
      if (trackScope) {
        trackScope.textContent = 'تركيز: ' + label;
        trackScope.className = 'badge bg-success text-white border border-success px-2 py-1 small pulse-badge';
      }

      // Scroll smoothly to distribution cards if not in view
      const targetSection = document.getElementById('distributionCardsContainer');
      if (targetSection) {
        targetSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    }

    function clearRowCrossFilter() {
      // Remove highlighting from all rows
      document.querySelectorAll('.interactive-data-row.active-row-filtered').forEach(el => {
        el.classList.remove('active-row-filtered');
      });
      currentSelectedCrossFilterRow = null;

      // Hide active banner
      const banner = document.getElementById('activeCrossFilterBanner');
      if (banner) {
        banner.classList.add('d-none');
        banner.classList.remove('d-flex');
      }

      // Reset Gender Bars to default
      const barBoys = document.getElementById('cfBarBoys');
      const barGirls = document.getElementById('cfBarGirls');
      const badgeBoys = document.getElementById('cfBadgeBoys');
      const badgeGirls = document.getElementById('cfBadgeGirls');
      const genderScope = document.getElementById('genderScopeBadge');

      if (barBoys && barBoys.hasAttribute('data-default-percent')) {
        const defBoysPct = barBoys.getAttribute('data-default-percent');
        barBoys.style.width = defBoysPct + '%';
      }
      if (barGirls && barGirls.hasAttribute('data-default-percent')) {
        const defGirlsPct = barGirls.getAttribute('data-default-percent');
        barGirls.style.width = defGirlsPct + '%';
      }
      if (badgeBoys && badgeBoys.hasAttribute('data-default-count')) {
        badgeBoys.textContent = `${badgeBoys.getAttribute('data-default-count')} طالب (${badgeBoys.getAttribute('data-default-percent')}%)`;
      }
      if (badgeGirls && badgeGirls.hasAttribute('data-default-count')) {
        badgeGirls.textContent = `${badgeGirls.getAttribute('data-default-count')} طالبة (${badgeGirls.getAttribute('data-default-percent')}%)`;
      }
      if (genderScope) {
        genderScope.textContent = 'حسب الفلترة الحالية';
        genderScope.className = 'badge bg-light text-secondary border px-2 py-1 small';
      }

      // Reset Track Bars to default
      const barGeneral = document.getElementById('cfBarGeneral');
      const barTahfeez = document.getElementById('cfBarTahfeez');
      const badgeGeneral = document.getElementById('cfBadgeGeneral');
      const badgeTahfeez = document.getElementById('cfBadgeTahfeez');
      const trackScope = document.getElementById('trackScopeBadge');

      if (barGeneral && barGeneral.hasAttribute('data-default-percent')) {
        const defGenPct = barGeneral.getAttribute('data-default-percent');
        barGeneral.style.width = defGenPct + '%';
      }
      if (barTahfeez && barTahfeez.hasAttribute('data-default-percent')) {
        const defTahPct = barTahfeez.getAttribute('data-default-percent');
        barTahfeez.style.width = defTahPct + '%';
      }
      if (badgeGeneral && badgeGeneral.hasAttribute('data-default-count')) {
        badgeGeneral.textContent = `${badgeGeneral.getAttribute('data-default-count')} طالب (${badgeGeneral.getAttribute('data-default-percent')}%)`;
      }
      if (badgeTahfeez && badgeTahfeez.hasAttribute('data-default-count')) {
        badgeTahfeez.textContent = `${badgeTahfeez.getAttribute('data-default-count')} طالب (${badgeTahfeez.getAttribute('data-default-percent')}%)`;
      }
      if (trackScope) {
        trackScope.textContent = 'حسب الفلترة الحالية';
        trackScope.className = 'badge bg-light text-secondary border px-2 py-1 small';
      }
    }
  </script>
</body>
</html>
