<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>الداش بورد والتحليلات | مدارس بواكير الأهلية</title>
  <link rel="stylesheet" href="/public/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <style>
    body { background-color: #f1f5f9; font-family: 'Cairo', sans-serif; margin: 0; padding: 0; }
    .erp-top-nav { background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 8px 20px; display: flex; justify-content: space-between; align-items: center; font-size: 13.5px; }
    .erp-nav-right, .erp-nav-left { display: flex; align-items: center; gap: 12px; }
    .erp-menu-item { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 6px; color: #334155; text-decoration: none; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .erp-menu-item:hover { background: #f1f5f9; color: #0f172a; }
    .erp-menu-tag { padding: 4px 8px; border-radius: 4px; font-weight: 700; color: white; display: inline-flex; align-items: center; gap: 4px; }
    .erp-sub-banner { background: linear-gradient(90deg, #1d4ed8 0%, #2563eb 50%, #3b82f6 100%); color: #ffffff; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 14.5px; box-shadow: 0 2px 4px rgba(37,99,235,0.15); }
    .erp-content { max-width: 1400px; margin: 24px auto; padding: 0 24px; }
    .rates-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; margin-bottom: 24px; }
    .rate-card { background: white; border-radius: 16px; padding: 24px; text-align: center; border: 1px solid #e2e8f0; box-shadow: 0 2px 6px rgba(0,0,0,0.03); }
    .rate-circle { width: 100px; height: 100px; border-radius: 50%; margin: 0 auto 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 900; }
    .analytics-grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-bottom: 24px; }
    .bar-row { display: flex; align-items: center; margin-bottom: 12px; font-size: 13.5px; }
    .bar-label { width: 120px; font-weight: 700; color: #334155; }
    .bar-track { flex: 1; background: #e2e8f0; height: 22px; border-radius: 11px; overflow: hidden; margin: 0 12px; position: relative; }
    .bar-fill { height: 100%; display: flex; align-items: center; padding: 0 10px; color: #fff; font-size: 11.5px; font-weight: 800; }
    .bar-percent { width: 50px; text-align: left; font-weight: 700; color: #64748b; }
    @media (max-width: 900px) { .analytics-grid-2 { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <!-- TOP ERP NAVBAR -->
  <nav class="erp-top-nav">
    <div class="erp-nav-right">
      <a href="/" class="erp-menu-item" style="color:#2563eb;font-weight:800;"><span>🏠 الرئيسية</span></a>
      <a href="/students" class="erp-menu-item"><span class="erp-menu-tag" style="background:#10b981;">📋 متابعة الطلاب</span></a>
      <a href="/users" class="erp-menu-item"><span class="erp-menu-tag" style="background:#ef4444;">🛡️ الحماية والمستخدمين</span></a>
      <a href="/history" class="erp-menu-item"><span class="erp-menu-tag" style="background:#6366f1;">📑 السجل التاريخي</span></a>
      <a href="/branches" class="erp-menu-item"><span class="erp-menu-tag" style="background:#2563eb;">🏛️ الفروع والأعوام</span></a>
      <a href="/analytics" class="erp-menu-item" style="background:#f8fafc;"><span class="erp-menu-tag" style="background:#d97706;">📊 الداش بورد</span></a>
    </div>
    <div class="erp-nav-left">
      <span style="font-weight:700;color:#1e293b;"><%= currentUser ? (currentUser.full_name || currentUser.username) : 'المستخدم' %></span>
      <a href="/logout" style="color:#ef4444;text-decoration:none;font-weight:700;">🚪 خروج</a>
    </div>
  </nav>

  <!-- SUB BANNER -->
  <div class="erp-sub-banner">
    <div>الداش بورد والمؤشرات التحليلية | مدارس بواكير الأهلية</div>
    <div><%= analytics.branchLabel || 'جميع الفروع' %></div>
  </div>

  <div class="erp-content">
    <!-- TOP STATS TILES -->
    <div class="stats-grid">
      <div class="stat-card stat-total"><strong><%= analytics.total %></strong><span>إجمالي الطلاب</span></div>
      <div class="stat-card stat-success"><strong><%= analytics.accepted %></strong><span>المقبولين</span></div>
      <div class="stat-card stat-danger"><strong><%= analytics.rejected %></strong><span>غير المقبولين</span></div>
      <div class="stat-card stat-info"><strong><%= analytics.registered %></strong><span>المسجلين</span></div>
      <div class="stat-card stat-warning"><strong><%= analytics.waiting %></strong><span>في انتظار التسجيل</span></div>
      <div class="stat-card stat-secondary"><strong><%= analytics.pending_interview %></strong><span>في انتظار المقابلة</span></div>
    </div>

    <!-- RATE CIRCLES -->
    <div class="rates-grid">
      <div class="rate-card">
        <div class="rate-circle" style="border:5px solid #10b981;color:#059669;background:#ecfdf5;">
          <%= analytics.acceptanceRate %>%
        </div>
        <h4 style="margin:0;font-size:16px;color:#1e293b;">نسبة القبول</h4>
        <span style="font-size:12px;color:#64748b;">(المقبولين ÷ الإجمالي)</span>
      </div>

      <div class="rate-card">
        <div class="rate-circle" style="border:5px solid #2563eb;color:#1d4ed8;background:#eff6ff;">
          <%= analytics.registrationRate %>%
        </div>
        <h4 style="margin:0;font-size:16px;color:#1e293b;">نسبة التسجيل العامة</h4>
        <span style="font-size:12px;color:#64748b;">(المسجلين ÷ الإجمالي)</span>
      </div>

      <div class="rate-card">
        <div class="rate-circle" style="border:5px solid #d97706;color:#b45309;background:#fffbeb;">
          <%= analytics.conversionRate %>%
        </div>
        <h4 style="margin:0;font-size:16px;color:#1e293b;">نسبة تحويل المقبولين</h4>
        <span style="font-size:12px;color:#64748b;">(المسجلين ÷ المقبولين)</span>
      </div>
    </div>

    <!-- CHARTS / BARS ROW 1 -->
    <div class="analytics-grid-2">
      <!-- Phases -->
      <div class="card">
        <div class="card-header"><h3>توزيع الطلاب حسب المراحل الدراسية</h3></div>
        <% Object.entries(analytics.phaseStats || {}).forEach(function([p, count]){ 
           var pct = analytics.total > 0 ? Math.round(count / analytics.total * 100) : 0; %>
          <div class="bar-row">
            <span class="bar-label"><%= p %></span>
            <div class="bar-track">
              <div class="bar-fill" style="width:<%= pct %>%;background:#2563eb;"><%= count %></div>
            </div>
            <span class="bar-percent"><%= pct %>%</span>
          </div>
        <% }) %>
      </div>

      <!-- Followup Statuses -->
      <div class="card">
        <div class="card-header"><h3>توزيع حالات المتابعة</h3></div>
        <% Object.entries(analytics.registrationStats || {}).forEach(function([st, count]){ 
           var pct = analytics.total > 0 ? Math.round(count / analytics.total * 100) : 0; %>
          <div class="bar-row">
            <span class="bar-label"><%= st %></span>
            <div class="bar-track">
              <div class="bar-fill" style="width:<%= pct %>%;background:#10b981;"><%= count %></div>
            </div>
            <span class="bar-percent"><%= pct %>%</span>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- CHARTS / BARS ROW 2 -->
    <div class="analytics-grid-2">
      <!-- Branches -->
      <div class="card">
        <div class="card-header"><h3>توزيع الطلاب حسب الفروع</h3></div>
        <% Object.entries(analytics.branchStats || {}).forEach(function([b, count]){ 
           var pct = analytics.total > 0 ? Math.round(count / analytics.total * 100) : 0; %>
          <div class="bar-row">
            <span class="bar-label"><%= b %></span>
            <div class="bar-track">
              <div class="bar-fill" style="width:<%= pct %>%;background:#7c3aed;"><%= count %></div>
            </div>
            <span class="bar-percent"><%= pct %>%</span>
          </div>
        <% }) %>
      </div>

      <!-- Student Types -->
      <div class="card">
        <div class="card-header"><h3>نوع الطلاب والمسارات</h3></div>
        <% Object.entries(analytics.typeStats || {}).forEach(function([t, count]){ 
           var pct = analytics.total > 0 ? Math.round(count / analytics.total * 100) : 0; %>
          <div class="bar-row">
            <span class="bar-label"><%= t %></span>
            <div class="bar-track">
              <div class="bar-fill" style="width:<%= pct %>%;background:#0284c7;"><%= count %></div>
            </div>
            <span class="bar-percent"><%= pct %>%</span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</body>
</html>
