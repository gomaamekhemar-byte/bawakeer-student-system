<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>الداش بورد والمؤشرات التحليلية | مدارس بواكير الأهلية</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    body { font-family: 'Cairo', system-ui, sans-serif; background-color: #f4f6f9; color: #212529; min-height: 100vh; }
    .navbar-erp { background: #ffffff; border-bottom: 1px solid #e3e8ee; }
    .erp-sub-header { background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #ffffff; padding: 14px 0; }
    
    .stat-card-custom {
      background: #ffffff;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 2px 6px rgba(0,0,0,0.03);
      padding: 16px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .stat-card-custom:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 16px rgba(0,0,0,0.06);
    }
    .stat-card-custom .stat-number {
      font-size: 26px;
      font-weight: 800;
      line-height: 1.2;
    }
    .stat-card-custom .stat-title {
      font-size: 13px;
      font-weight: 700;
      color: #64748b;
      margin-top: 4px;
    }
    .stat-card-custom .stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .stat-card-blue { border-right: 5px solid #2563eb; }
    .stat-card-green { border-right: 5px solid #10b981; }
    .stat-card-red { border-right: 5px solid #ef4444; }
    .stat-card-cyan { border-right: 5px solid #06b6d4; }
    .stat-card-amber { border-right: 5px solid #f59e0b; }
    .stat-card-purple { border-right: 5px solid #8b5cf6; }

    .rate-card {
      background: #ffffff;
      border-radius: 14px;
      border: 1px solid #e2e8f0;
      padding: 20px;
      text-align: center;
      box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    }
    .rate-circle-badge {
      width: 84px;
      height: 84px;
      border-radius: 50%;
      margin: 0 auto 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      font-weight: 900;
    }

    .table thead th {
      background-color: #1e3a8a !important;
      color: #ffffff !important;
      font-weight: 700;
      padding: 12px 10px;
      font-size: 13.5px;
      vertical-align: middle;
    }
    .table tbody td {
      padding: 12px 10px;
      vertical-align: middle;
      font-size: 13.5px;
    }
  </style>
</head>
<body>

  <!-- TOP NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-erp py-2">
    <div class="container-fluid px-4">
      <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" href="/">
        <i class="fa-solid fa-graduation-cap fs-4"></i>
        <span>مدارس بواكير الأهلية</span>
      </a>

      <div class="d-flex align-items-center gap-3">
        <a href="/" class="btn btn-outline-secondary btn-sm fw-bold">
          <i class="fa-solid fa-house me-1"></i> الرئيسية
        </a>
        <a href="/students" class="btn btn-outline-primary btn-sm fw-bold">
          <i class="fa-solid fa-users me-1"></i> متابعة الطلاب
        </a>
        <a href="/reports" class="btn btn-outline-warning text-dark btn-sm fw-bold">
          <i class="fa-solid fa-file-lines me-1 text-warning"></i> مركز التقارير
        </a>
        <a href="/users" class="btn btn-outline-danger btn-sm fw-bold">
          <i class="fa-solid fa-shield-halved me-1"></i> المستخدمين
        </a>
      </div>

      <div class="d-flex align-items-center gap-3">
        <span class="fw-bold text-dark"><%= currentUser ? (currentUser.full_name || currentUser.username) : 'المستخدم' %></span>
        <button type="button" class="btn btn-outline-warning text-dark btn-sm fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#changePasswordModal" title="تغيير كلمة المرور الخاصة بي">
          <i class="fa-solid fa-key me-1 text-warning"></i> كلمة المرور
        </button>
        <a href="/logout" class="btn btn-outline-danger btn-sm" title="تسجيل الخروج">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </a>
      </div>
    </div>
  </nav>

  <!-- BLUE SUB-HEADER -->
  <div class="erp-sub-header">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div class="fw-bold fs-5 d-flex align-items-center gap-2">
        <i class="fa-solid fa-chart-pie"></i>
        <span>الداش بورد والمؤشرات التحليلية | مدارس بواكير الأهلية</span>
      </div>
      
      <!-- GLOBAL BRANCH FILTER SELECTOR (FEATURE 1) -->
      <form method="get" action="/analytics" class="d-flex align-items-center gap-2">
        <label class="text-white small fw-bold text-nowrap"><i class="fa-solid fa-filter me-1"></i> تصفية الداش بورد حسب الفرع:</label>
        <select name="branch" class="form-select form-select-sm fw-bold shadow-sm" style="min-width: 180px;" onchange="this.form.submit()">
          <option value="الكل" <%= (!selectedBranch || selectedBranch === 'الكل') ? 'selected' : '' %>>🌐 جميع الفروع</option>
          <% branches.forEach(function(b){ %>
            <option value="<%= b %>" <%= (selectedBranch === b) ? 'selected' : '' %>>🏢 فرع <%= b %></option>
          <% }) %>
        </select>
      </form>
    </div>
  </div>

  <div class="container-fluid px-4 py-4">

    <!-- 1. TOP STATS CARDS (HORIZONTAL ROW) -->
    <div class="row g-3 mb-4">
      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-blue h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number text-primary"><%= analytics.total %></div>
            <div class="stat-title">إجمالي المتقدمين</div>
          </div>
          <div class="stat-icon bg-primary-subtle text-primary">
            <i class="fa-solid fa-users"></i>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-green h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number text-success"><%= analytics.accepted %></div>
            <div class="stat-title">المقبولين</div>
          </div>
          <div class="stat-icon bg-success-subtle text-success">
            <i class="fa-solid fa-circle-check"></i>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-red h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number text-danger"><%= analytics.rejected %></div>
            <div class="stat-title">غير مقبول</div>
          </div>
          <div class="stat-icon bg-danger-subtle text-danger">
            <i class="fa-solid fa-circle-xmark"></i>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-cyan h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number text-info"><%= analytics.registered %></div>
            <div class="stat-title">تم التسجيل</div>
          </div>
          <div class="stat-icon bg-info-subtle text-info">
            <i class="fa-solid fa-user-check"></i>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-amber h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number text-warning"><%= analytics.waiting %></div>
            <div class="stat-title">في انتظار التسجيل</div>
          </div>
          <div class="stat-icon bg-warning-subtle text-warning">
            <i class="fa-solid fa-hourglass-half"></i>
          </div>
        </div>
      </div>

      <div class="col-xl-2 col-md-4 col-6">
        <div class="stat-card-custom stat-card-purple h-100 d-flex align-items-center justify-content-between">
          <div>
            <div class="stat-number" style="color:#8b5cf6;"><%= analytics.pending_interview %></div>
            <div class="stat-title">في انتظار المقابلة</div>
          </div>
          <div class="stat-icon bg-secondary-subtle text-secondary">
            <i class="fa-solid fa-clipboard-question"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. KEY PERFORMANCE RATES -->
    <div class="row g-3 mb-4">
      <div class="col-md-4">
        <div class="rate-card">
          <div class="rate-circle-badge bg-success-subtle text-success border border-success">
            <%= analytics.acceptanceRate %>%
          </div>
          <h6 class="fw-bold text-dark mb-1">معدل القبول</h6>
          <small class="text-muted">نسبة المقبولين من إجمالي المتقدمين</small>
        </div>
      </div>

      <div class="col-md-4">
        <div class="rate-card">
          <div class="rate-circle-badge bg-primary-subtle text-primary border border-primary">
            <%= analytics.registrationRate %>%
          </div>
          <h6 class="fw-bold text-dark mb-1">معدل التسجيل الإجمالي</h6>
          <small class="text-muted">نسبة المسجلين فعلياً من الإجمالي</small>
        </div>
      </div>

      <div class="col-md-4">
        <div class="rate-card">
          <div class="rate-circle-badge bg-info-subtle text-info border border-info">
            <%= analytics.conversionRate %>%
          </div>
          <h6 class="fw-bold text-dark mb-1">معدل التحويل (Conversion)</h6>
          <small class="text-muted">نسبة من تم تسجيلهم من المقبولين</small>
        </div>
      </div>
    </div>

    <!-- 3. DETAILED BRANCH & PHASES BREAKDOWN TABLE (FEATURE 3 - IMPORTANT) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
          <i class="fa-solid fa-table-cells text-primary"></i>
          <span>التحليل التفصيلي للفروع والمراحل الدراسية</span>
        </h5>
        <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 fw-bold">
          النطاق المعروض: <%= analytics.branchLabel %>
        </span>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0 text-nowrap text-center">
          <thead>
            <tr>
              <th class="text-end" style="width: 160px;">الفرع</th>
              <th class="text-end" style="width: 140px;">المرحلة الدراسية</th>
              <th>إجمالي المتقدمين</th>
              <th>المقبولين</th>
              <th>تم التسجيل</th>
              <th>في انتظار المقابلة</th>
              <th>في انتظار التسجيل</th>
              <th>نسبة الإنجاز</th>
            </tr>
          </thead>
          <tbody>
            <% if(detailedBranchPhaseStats && detailedBranchPhaseStats.length > 0){ %>
              <% detailedBranchPhaseStats.forEach(function(branchGroup){ %>
                <% branchGroup.phasesData.forEach(function(pData, pIdx){ 
                  const completionRate = pData.total > 0 ? Math.round(pData.registered / pData.total * 100) : 0;
                %>
                  <tr>
                    <% if(pIdx === 0){ %>
                      <td class="text-end fw-bold text-dark bg-light border-end" rowspan="<%= branchGroup.phasesData.length %>" style="vertical-align: middle;">
                        <i class="fa-solid fa-school text-primary me-1"></i>
                        فرع <%= branchGroup.branch %>
                        <div class="small text-muted fw-normal mt-1">(إجمالي الفرع: <%= branchGroup.total %>)</div>
                      </td>
                    <% } %>
                    <td class="text-end fw-bold text-secondary border-end"><%= pData.phase %></td>
                    <td><span class="badge bg-light text-dark border px-2 py-1"><%= pData.total %></span></td>
                    <td><span class="badge bg-success-subtle text-success border border-success px-2 py-1"><%= pData.accepted %></span></td>
                    <td><span class="badge bg-info-subtle text-info border border-info px-2 py-1 fw-bold"><%= pData.registered %></span></td>
                    <td><span class="badge bg-secondary-subtle text-secondary border px-2 py-1"><%= pData.pending_interview %></span></td>
                    <td><span class="badge bg-warning-subtle text-warning border border-warning px-2 py-1"><%= pData.waiting_registration %></span></td>
                    <td style="min-width: 140px;">
                      <div class="d-flex align-items-center gap-2 justify-content-center">
                        <div class="progress flex-grow-1" style="height: 8px;">
                          <div class="progress-bar bg-success" role="progressbar" style="width: <%= completionRate %>%"></div>
                        </div>
                        <small class="fw-bold text-muted"><%= completionRate %>%</small>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">لا توجد بيانات متاحة</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 4. GENDER & TRACK CATEGORY ANALYSIS (FEATURE 4) -->
    <div class="row g-4 mb-4">
      <!-- GENDER ANALYSIS (بنين / بنات) -->
      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
          <div class="card-header bg-white py-3 border-0">
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-venus-mars text-primary me-2"></i> توزيع الطلاب حسب النوع (بنين / بنات)
            </h6>
          </div>
          <div class="card-body p-4 pt-2">
            <% 
              const boysCount = analytics.typeStats['بنين'] || 0;
              const girlsCount = analytics.typeStats['بنات'] || 0;
              const totalGender = boysCount + girlsCount;
              const boysPercent = totalGender > 0 ? Math.round(boysCount / totalGender * 100) : 0;
              const girlsPercent = totalGender > 0 ? Math.round(girlsCount / totalGender * 100) : 0;
            %>
            
            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-primary"><i class="fa-solid fa-mars me-1"></i> بنين</span>
                <span class="badge bg-primary-subtle text-primary fs-7 fw-bold"><%= boysCount %> طالب (<%= boysPercent %>%)</span>
              </div>
              <div class="progress" style="height: 14px;">
                <div class="progress-bar bg-primary" role="progressbar" style="width: <%= boysPercent %>%"></div>
              </div>
            </div>

            <div>
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold" style="color: #ec4899;"><i class="fa-solid fa-venus me-1"></i> بنات</span>
                <span class="badge fs-7 fw-bold" style="background: #fdf2f8; color: #ec4899; border: 1px solid #fbcfe8;"><%= girlsCount %> طالبة (<%= girlsPercent %>%)</span>
              </div>
              <div class="progress" style="height: 14px;">
                <div class="progress-bar" role="progressbar" style="width: <%= girlsPercent %>%; background-color: #ec4899;"></div>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- TRACK ANALYSIS (عام / تحفيظ) -->
      <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-3 h-100">
          <div class="card-header bg-white py-3 border-0">
            <h6 class="fw-bold mb-0 text-dark">
              <i class="fa-solid fa-book-bookmark text-success me-2"></i> توزيع الطلاب حسب المسار التعليمي (عام / تحفيظ)
            </h6>
          </div>
          <div class="card-body p-4 pt-2">
            <% 
              const generalCount = analytics.trackStats['عام'] || 0;
              const tahfeezCount = analytics.trackStats['تحفيظ'] || 0;
              const totalTracks = generalCount + tahfeezCount;
              const generalPercent = totalTracks > 0 ? Math.round(generalCount / totalTracks * 100) : 0;
              const tahfeezPercent = totalTracks > 0 ? Math.round(tahfeezCount / totalTracks * 100) : 0;
            %>
            
            <div class="mb-4">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-dark"><i class="fa-solid fa-graduation-cap me-1 text-secondary"></i> مسار عام</span>
                <span class="badge bg-secondary-subtle text-dark fs-7 fw-bold"><%= generalCount %> طالب (<%= generalPercent %>%)</span>
              </div>
              <div class="progress" style="height: 14px;">
                <div class="progress-bar bg-secondary" role="progressbar" style="width: <%= generalPercent %>%"></div>
              </div>
            </div>

            <div>
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold text-success"><i class="fa-solid fa-quran me-1"></i> مسار تحفيظ القرآن</span>
                <span class="badge bg-success-subtle text-success fs-7 fw-bold"><%= tahfeezCount %> طالب (<%= tahfeezPercent %>%)</span>
              </div>
              <div class="progress" style="height: 14px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: <%= tahfeezPercent %>%"></div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>

  <!-- SELF CHANGE PASSWORD MODAL -->
  <div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-light">
          <h5 class="modal-title fw-bold text-dark">
            <i class="fa-solid fa-key text-warning me-2"></i> تغيير كلمة المرور الخاصة بي
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form method="post" action="/change_password">
          <div class="modal-body p-4">
            <div class="mb-3">
              <label class="form-label fw-bold small text-dark">كلمة المرور الحالية <span class="text-danger">*</span></label>
              <input type="password" name="current_password" class="form-control" required placeholder="••••••••">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small text-dark">كلمة المرور الجديدة <span class="text-danger">*</span></label>
              <input type="password" name="new_password" class="form-control" required placeholder="••••••••">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold small text-dark">تأكيد كلمة المرور الجديدة <span class="text-danger">*</span></label>
              <input type="password" name="confirm_password" class="form-control" required placeholder="••••••••">
            </div>
          </div>
          <div class="modal-footer bg-light d-flex justify-content-start gap-2">
            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
              <i class="fa-solid fa-check me-1"></i> تحديث كلمة المرور
            </button>
            <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">إلغاء</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
