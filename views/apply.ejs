<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>بوابة التسجيل والقبول الإلكتروني | مدارس بواكير الأهلية</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- MOMENT & MOMENT-HIJRI -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/moment-hijri@2.1.2/moment-hijri.min.js"></script>

  <style>
    body {
      font-family: 'Cairo', system-ui, sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
      min-height: 100vh;
      color: #1e293b;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .apply-card {
      background: #ffffff;
      border-radius: 20px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.25);
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.2);
    }
    .apply-header {
      background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
      color: #ffffff;
      padding: 32px 24px;
      text-align: center;
      position: relative;
    }
    .apply-header .brand-icon {
      width: 70px;
      height: 70px;
      background: rgba(255,255,255,0.15);
      backdrop-filter: blur(10px);
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      margin-bottom: 14px;
      border: 1px solid rgba(255,255,255,0.3);
    }
    .form-section-title {
      font-size: 15px;
      font-weight: 800;
      color: #1e3a8a;
      border-bottom: 2px solid #e2e8f0;
      padding-bottom: 8px;
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .form-control, .form-select {
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 14px;
      border: 1.5px solid #cbd5e1;
      font-weight: 500;
    }
    .form-control:focus, .form-select:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);
    }
    .btn-submit {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
      border: none;
      border-radius: 12px;
      padding: 14px;
      font-size: 16px;
      font-weight: 800;
      transition: all 0.2s;
    }
    .btn-submit:hover {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.35);
      color: white;
    }
    .btn-whatsapp {
      background-color: #25D366;
      color: white;
      border-radius: 10px;
      font-weight: 700;
      padding: 12px 20px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
    }
    .btn-whatsapp:hover {
      background-color: #128C7E;
      color: white;
    }
    .feature-badge {
      background: #f1f5f9;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      color: #475569;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .age-badge {
      font-size: 13px;
      padding: 6px 14px;
      border-radius: 8px;
      font-weight: 700;
      display: inline-block;
    }
  </style>
</head>
<body>

  <!-- MAIN CONTAINER -->
  <div class="container py-4 my-auto">
    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">

        <% if(typeof submitted !== 'undefined' && submitted){ %>
          <!-- SUCCESS CONFIRMATION SCREEN (DYNAMIC ROUTING TO BRANCH WHATSAPP) -->
          <div class="apply-card p-4 p-md-5 text-center shadow-lg">
            
            <!-- THANK YOU & CONFIRMATION BADGE -->
            <div class="mb-4 position-relative d-inline-block">
              <div class="rounded-circle text-white d-inline-flex align-items-center justify-content-center shadow-lg" style="width: 100px; height: 100px; font-size: 50px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: 4px solid #ffffff;">
                <i class="fa-solid fa-check"></i>
              </div>
              <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning text-dark fs-6 shadow">
                <i class="fa-solid fa-star"></i> تم بنجاح
              </span>
            </div>
            
            <h3 class="fw-bold text-dark mb-2">شكراً لكم! تم استلام طلب التسجيل بنجاح 🎉</h3>
            <p class="text-muted fs-6 mb-4">أهلاً بكم في عائلة <strong>مدارس بواكير الأهلية</strong>. تم تسجيل بيانات الطالب/ـة بنجاح، ويسرنا تواصلكم لمتابعة موعد المقابلة.</p>
            
            <!-- STUDENT & BRANCH SUMMARY CARD -->
            <div class="card bg-light border-0 rounded-4 p-4 mb-4 text-start shadow-sm">
              <div class="row g-3">
                <div class="col-sm-6">
                  <small class="text-muted d-block fw-bold"><i class="fa-solid fa-user-graduate me-1 text-primary"></i> اسم الطالب</small>
                  <strong class="text-dark fs-6"><%= student.name %></strong>
                </div>
                <div class="col-sm-6">
                  <small class="text-muted d-block fw-bold"><i class="fa-solid fa-building text-primary me-1"></i> الفرع المطلوب</small>
                  <span class="badge bg-primary fs-6 px-3 py-1">فرع <%= student.branch %></span>
                </div>
                <div class="col-sm-6">
                  <small class="text-muted d-block fw-bold"><i class="fa-solid fa-layer-group text-primary me-1"></i> المرحلة والصف</small>
                  <strong class="text-dark"><%= student.phase %> - <%= student.grade ? 'صف ' + student.grade : '' %></strong>
                </div>
                <div class="col-sm-6">
                  <small class="text-muted d-block fw-bold"><i class="fa-solid fa-mobile-screen text-primary me-1"></i> رقم جوال ولي الأمر</small>
                  <strong class="text-dark" style="direction:ltr;"><%= student.phone %></strong>
                </div>
              </div>
            </div>

            <!-- AUTOMATED CONFIRMATION ALERT -->
            <div class="alert alert-success d-flex align-items-center justify-content-center gap-2 py-3 rounded-3 mb-4 shadow-sm" role="alert">
              <i class="fa-brands fa-whatsapp fs-4 text-success"></i>
              <span>تم إرسال رسالة تأكيد آلية إلى تطبيق واتساب على الرقم المسجل.</span>
            </div>

            <!-- PROMINENT DYNAMIC 'متابعة الطلب' BUTTON LINKED TO BRANCH WHATSAPP -->
            <div class="mb-4">
              <% const targetWhatsAppLink = (typeof branchWhatsAppUrl !== 'undefined' && branchWhatsAppUrl) ? branchWhatsAppUrl : (typeof whatsappUrl !== 'undefined' ? whatsappUrl : '#'); %>
              <a href="<%= targetWhatsAppLink %>" target="_blank" class="btn btn-success btn-lg px-5 py-3 fw-bold rounded-pill shadow-lg d-inline-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #25D366 0%, #128C7E 100%); font-size: 18px; transition: all 0.2s;">
                <i class="fa-brands fa-whatsapp fs-3"></i>
                <span>متابعة الطلب</span>
              </a>
              <div class="mt-2 text-muted small">
                <i class="fa-solid fa-headset me-1 text-success"></i> اضغط على زر <strong>"متابعة الطلب"</strong> لبدء محادثة مباشرة مع مسؤولي القبول والتسجيل بـ <strong>(فرع <%= student.branch %>)</strong> عبر واتساب.
              </div>
            </div>

            <div class="pt-3 border-top">
              <a href="/apply" class="btn btn-outline-primary px-4 py-2 rounded-3 fw-bold">
                <i class="fa-solid fa-plus me-1"></i> تسجيل طالب آخر
              </a>
            </div>
          </div>

        <% } else if(typeof settings !== 'undefined' && settings.is_portal_open === false) { %>

          <!-- CLOSED PORTAL SCREEN -->
          <div class="apply-card p-5 text-center shadow-lg">
            <div class="mb-4">
              <div class="rounded-circle bg-warning-subtle text-warning d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 38px;">
                <i class="fa-solid fa-lock"></i>
              </div>
            </div>
            <h3 class="fw-bold text-dark mb-2">التسجيل الإلكتروني مغلق حالياً</h3>
            <p class="text-muted fs-6 mb-4"><%= settings.portal_closed_message || 'نعتذر منكم، باب التسجيل مغلق حالياً.' %></p>
            <div class="text-center">
              <a href="/login" class="btn btn-outline-primary px-4 py-2 rounded-3 fw-bold">
                <i class="fa-solid fa-user-shield me-1"></i> تسجيل دخول الموظفين
              </a>
            </div>
          </div>

        <% } else { %>
          
          <!-- REGISTRATION FORM -->
          <div class="apply-card">
            
            <!-- HEADER -->
            <div class="apply-header">
              <div class="brand-icon">
                <i class="fa-solid fa-graduation-cap"></i>
              </div>
              <h3 class="fw-bold mb-1">مدارس بواكير الأهلية</h3>
              <p class="mb-3 text-white-50 fs-6">بوابة تسجيل وقبول الطلاب الجدد — العام الدراسي <%= activeYear ? activeYear.year_name : '1448-1449هـ' %></p>
              
              <% if(typeof settings !== 'undefined' && settings.portal_announcement){ %>
                <div class="alert alert-light py-2 px-3 mb-3 text-dark fw-bold small shadow-sm d-inline-block rounded-pill">
                  <i class="fa-solid fa-bullhorn text-primary me-1"></i> <%= settings.portal_announcement %>
                </div>
              <% } %>

              <div class="d-flex justify-content-center flex-wrap gap-2">
                <span class="feature-badge"><i class="fa-solid fa-bolt text-warning"></i> تسجيل فوري سريع</span>
                <span class="feature-badge"><i class="fa-brands fa-whatsapp text-success"></i> تأكيد آلي عبر واتساب</span>
                <span class="feature-badge"><i class="fa-solid fa-moon text-warning"></i> تقويم هجري وميلادي</span>
              </div>
            </div>

            <!-- FORM BODY -->
            <div class="p-4 p-md-5">
              
              <% if(typeof error !== 'undefined' && error){ %>
                <div class="alert alert-danger py-2 px-3 fw-bold mb-4 shadow-sm" role="alert">
                  <i class="fa-solid fa-circle-exclamation me-1"></i> <%= error %>
                </div>
              <% } %>

              <form method="post" action="/apply" id="applyForm">
                
                <!-- ANTI-SPAM HONEYPOT (MUST REMAIN EMPTY) -->
                <input type="text" name="website_trap" style="display:none !important;" tabindex="-1" autocomplete="off">

                <!-- 1. بيانات الطالب الأساسية -->
                <div class="form-section-title">
                  <i class="fa-solid fa-user-graduate"></i>
                  <span>بيانات الطالب / الطالبة</span>
                </div>

                <div class="row g-3 mb-4">
                  <div class="col-md-8">
                    <label class="form-label fw-bold small text-dark">اسم الطالب رباعي <span class="text-danger">*</span></label>
                    <input type="text" name="name" class="form-control" required placeholder="أدخل الاسم الرباعي كاملاً">
                  </div>
                  <div class="col-md-4">
                    <label class="form-label fw-bold small text-dark">نوع الطالب <span class="text-danger">*</span></label>
                    <select name="student_type" class="form-select" required>
                      <option value="بنين" selected>بنين</option>
                      <option value="بنات">بنات</option>
                    </select>
                  </div>

                  <!-- تاريـخ الميـلاد: ميلادي + هجري تفاعلي -->
                  <div class="col-md-6">
                    <label class="form-label fw-bold text-dark small"><i class="fa-solid fa-calendar-days text-primary me-1"></i> تاريخ الميلاد (ميلادي) <span class="text-danger">*</span></label>
                    <input type="date" name="date_of_birth" id="dobGregorian" class="form-control" required oninput="onGregorianChange(this.value)">
                  </div>

                  <div class="col-md-6">
                    <label class="form-label fw-bold text-dark small"><i class="fa-solid fa-moon text-warning me-1"></i> تاريخ الميلاد (هجري)</label>
                    <div class="row g-1">
                      <div class="col-4">
                        <select id="hijriDay" class="form-select text-center" onchange="onHijriDropdownChange()">
                          <option value="">اليوم</option>
                          <% for(let d = 1; d <= 30; d++){ %>
                            <option value="<%= d %>"><%= d %></option>
                          <% } %>
                        </select>
                      </div>
                      <div class="col-4">
                        <select id="hijriMonth" class="form-select" onchange="onHijriDropdownChange()">
                          <option value="">الشهر</option>
                          <option value="1">1 - محرم</option>
                          <option value="2">2 - صفر</option>
                          <option value="3">3 - ربيع الأول</option>
                          <option value="4">4 - ربيع الآخر</option>
                          <option value="5">5 - جمادى الأولى</option>
                          <option value="6">6 - جمادى الآخرة</option>
                          <option value="7">7 - رجب</option>
                          <option value="8">8 - شعبان</option>
                          <option value="9">9 - رمضان</option>
                          <option value="10">10 - شوال</option>
                          <option value="11">11 - ذو القعدة</option>
                          <option value="12">12 - ذو الحجة</option>
                        </select>
                      </div>
                      <div class="col-4">
                        <select id="hijriYear" class="form-select text-center" onchange="onHijriDropdownChange()">
                          <option value="">السنة</option>
                          <% for(let y = 1448; y >= 1425; y--){ %>
                            <option value="<%= y %>"><%= y %>هـ</option>
                          <% } %>
                        </select>
                      </div>
                    </div>
                  </div>

                  <!-- شارة عرض العمر الدقيق -->
                  <div class="col-12">
                    <div class="d-flex align-items-center gap-2 p-2 bg-light rounded-3">
                      <span class="small fw-bold text-muted"><i class="fa-solid fa-hourglass-half text-primary me-1"></i> العمر المحسوب:</span>
                      <span id="studentAgeDisplay" class="badge bg-secondary fs-6 px-3 py-1">يرجى تحديد تاريخ الميلاد</span>
                    </div>
                  </div>

                  <% if(typeof settings === 'undefined' || settings.show_nationality !== false){ %>
                  <div class="col-md-12">
                    <label class="form-label fw-bold small text-dark">الجنسية <span class="text-danger">*</span></label>
                    <select name="nationality" class="form-select" required>
                      <option value="سعودي" selected>سعودي</option>
                      <option value="مصري">مصري</option>
                      <option value="سوري">سوري</option>
                      <option value="أردني">أردني</option>
                      <option value="يمني">يمني</option>
                      <option value="فلسطيني">فلسطيني</option>
                      <option value="أخرى">أخرى</option>
                    </select>
                  </div>
                  <% } %>
                </div>

                <!-- 2. بيانات الاتصال وولي الأمر -->
                <div class="form-section-title">
                  <i class="fa-solid fa-phone"></i>
                  <span>بيانات ولي الأمر والاتصال</span>
                </div>

                <div class="row g-3 mb-4">
                  <div class="col-md-6">
                    <label class="form-label fw-bold small text-dark">رقم جوال ولي الأمر (واتساب) <span class="text-danger">*</span></label>
                    <div class="input-group">
                      <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-mobile-screen"></i></span>
                      <input type="tel" name="phone" class="form-control" required placeholder="05xxxxxxxx" pattern="^0?5[0-9]{8}$">
                    </div>
                    <small class="text-muted" style="font-size: 11px;">سيتم إرسال رسالة التأكيد وموعد المقابلة عبر هذا الرقم.</small>
                  </div>
                  
                  <% if(typeof settings === 'undefined' || settings.show_mother_phone !== false){ %>
                  <div class="col-md-6">
                    <label class="form-label fw-bold small text-dark">رقم جوال إضافي / جوال الأم (اختياري)</label>
                    <div class="input-group">
                      <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-phone"></i></span>
                      <input type="tel" name="mother_phone" class="form-control" placeholder="05xxxxxxxx">
                    </div>
                  </div>
                  <% } %>

                  <% if(typeof settings === 'undefined' || settings.show_neighborhood !== false){ %>
                  <div class="col-md-12">
                    <label class="form-label fw-bold small text-dark">الحي السكني</label>
                    <input type="text" name="neighborhood" class="form-control" placeholder="مثال: حي الروابي، حي الندى...">
                  </div>
                  <% } %>
                </div>

                <!-- 3. الفرع والمرحلة الدراسية -->
                <div class="form-section-title">
                  <i class="fa-solid fa-school"></i>
                  <span>الفرع والمرحلة الأكاديمية المطلوبة</span>
                </div>

                <div class="row g-3 mb-4">
                  <div class="col-md-6">
                    <label class="form-label fw-bold small text-dark">الفرع المطلوب <span class="text-danger">*</span></label>
                    <select name="student_branch" class="form-select fw-bold" required>
                      <% branches.forEach(function(b){ %>
                        <option value="<%= b %>">فرع <%= b %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold small text-dark">المرحلة الدراسية <span class="text-danger">*</span></label>
                    <select name="phase" class="form-select" required>
                      <option value="روضة">روضة</option>
                      <option value="ابتدائي" selected>ابتدائي</option>
                      <option value="متوسط">متوسط</option>
                      <option value="ثانوي">ثانوي</option>
                    </select>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-bold small text-dark">الصف الدراسي <span class="text-danger">*</span></label>
                    <select name="grade" class="form-select" required>
                      <option value="1" selected>الصف الأول</option>
                      <option value="2">الصف الثاني</option>
                      <option value="3">الصف الثالث</option>
                      <option value="4">الصف الرابع</option>
                      <option value="5">الصف الخامس</option>
                      <option value="6">الصف السادس</option>
                    </select>
                  </div>

                  <% if(typeof settings === 'undefined' || settings.show_track !== false){ %>
                  <div class="col-md-6">
                    <label class="form-label fw-bold small text-dark">المسار التعليمي</label>
                    <select name="track" class="form-select">
                      <option value="عام" selected>عام</option>
                      <option value="تحفيظ">تحفيظ</option>
                    </select>
                  </div>
                  <% } %>

                  <% if(typeof settings === 'undefined' || settings.show_notes !== false){ %>
                  <div class="col-md-12">
                    <label class="form-label fw-bold small text-dark">ملاحظات أو استفسارات إضافية (اختياري)</label>
                    <textarea name="notes" class="form-control" rows="2" placeholder="اكتب أي معلومات ترغب في توضيحها لإدارة القبول..."></textarea>
                  </div>
                  <% } %>
                </div>

                <!-- SUBMIT BUTTON -->
                <button type="submit" class="btn btn-submit w-100 shadow-sm d-flex align-items-center justify-content-center gap-2">
                  <i class="fa-solid fa-paper-plane fs-5"></i>
                  <span>إرسال طلب التسجيل وتأكيد البيانات</span>
                </button>

              </form>

            </div>
          </div>

        <% } %>

      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="text-center text-white-50 py-3" style="font-size: 12.5px;">
    <div>جميع الحقوق محفوظة © مدارس بواكير الأهلية <%= new Date().getFullYear() %></div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

  <!-- INTERACTIVE HIJRI-GREGORIAN DUAL ENGINE -->
  <script>
    function gregorianToHijriObj(gDateStr) {
      if (!gDateStr) return null;
      try {
        if (typeof moment !== 'undefined') {
          const m = moment(gDateStr, 'YYYY-MM-DD');
          if (m.isValid()) {
            return {
              year: parseInt(m.format('iYYYY'), 10),
              month: parseInt(m.format('iM'), 10),
              day: parseInt(m.format('iD'), 10)
            };
          }
        }
        const parts = gDateStr.split('-');
        let y = parseInt(parts[0], 10), m = parseInt(parts[1], 10), d = parseInt(parts[2], 10);
        if (m < 3) { y -= 1; m += 12; }
        const a = Math.floor(y / 100);
        const b = 2 - a + Math.floor(a / 4);
        const jd = Math.floor(365.25 * (y + 4716)) + Math.floor(30.6001 * (m + 1)) + d + b - 1524.5;
        const z = jd - 1948439.5;
        const hy = Math.floor((30 * z + 10646) / 10631);
        const z2 = z - Math.floor((10631 * hy + 5844) / 30);
        const hm = Math.min(12, Math.floor((z2 + 28.5001) / 29.5) + 1);
        const hd = Math.floor(z2 - Math.floor(29.5 * (hm - 1) + 0.5) + 1);
        return { year: hy, month: hm, day: Math.max(1, Math.min(30, hd)) };
      } catch (e) { return null; }
    }

    function hijriToGregorianStr(hYear, hMonth, hDay) {
      if (!hYear || !hMonth || !hDay) return '';
      try {
        if (typeof moment !== 'undefined') {
          const m = moment(`${hYear}/${hMonth}/${hDay}`, 'iYYYY/iM/iD');
          if (m.isValid()) {
            return m.format('YYYY-MM-DD');
          }
        }
        const yNum = parseInt(hYear, 10), mNum = parseInt(hMonth, 10), dNum = parseInt(hDay, 10);
        const jd = Math.floor((11 * yNum + 3) / 30) + 354 * yNum + 30 * mNum - Math.floor((mNum - 1) / 2) + dNum + 1948440 - 385;
        const l = jd + 68569;
        const n = Math.floor((4 * l) / 146097);
        const l2 = l - Math.floor((146097 * n + 3) / 4);
        const i = Math.floor((4000 * (l2 + 1)) / 1461001);
        const l3 = l2 - Math.floor((1461 * i) / 4) + 31;
        const j = Math.floor((80 * l3) / 2447);
        const d = l3 - Math.floor((2447 * j) / 80);
        const l4 = Math.floor(j / 11);
        const m = j + 2 - 12 * l4;
        const y = 100 * (n - 49) + i + l4;
        return y + '-' + String(m).padStart(2, '0') + '-' + String(d).padStart(2, '0');
      } catch (e) { return ''; }
    }

    function calculateAgeExact(gDateStr) {
      const display = document.getElementById('studentAgeDisplay');
      if (!display) return;
      if (!gDateStr) {
        display.textContent = 'يرجى تحديد تاريخ الميلاد';
        display.className = 'badge bg-secondary fs-6 px-3 py-1';
        return;
      }
      
      try {
        const birth = typeof moment !== 'undefined' ? moment(gDateStr, 'YYYY-MM-DD') : new Date(gDateStr);
        const today = typeof moment !== 'undefined' ? moment() : new Date();
        
        let years = 0, months = 0, days = 0;
        if (typeof moment !== 'undefined') {
          if (!birth.isValid() || birth.isAfter(today)) {
            display.textContent = 'تاريخ غير صالح (في المستقبل)';
            display.className = 'badge bg-danger fs-6 px-3 py-1';
            return;
          }
          const bClone = birth.clone();
          years = today.diff(bClone, 'years');
          bClone.add(years, 'years');
          months = today.diff(bClone, 'months');
          bClone.add(months, 'months');
          days = today.diff(bClone, 'days');
        } else {
          years = today.getFullYear() - birth.getFullYear();
          months = today.getMonth() - birth.getMonth();
          days = today.getDate() - birth.getDate();
          if (days < 0) { const pm = new Date(today.getFullYear(), today.getMonth(), 0); days += pm.getDate(); months -= 1; }
          if (months < 0) { months += 12; years -= 1; }
        }

        const parts = [];
        if (years > 0) parts.push(years === 1 ? 'سنة واحدة' : years === 2 ? 'سنتان' : years <= 10 ? (years + ' سنوات') : (years + ' سنة'));
        if (months > 0) parts.push(months === 1 ? 'شهر واحد' : months === 2 ? 'شهران' : months <= 10 ? (months + ' أشهر') : (months + ' شهر'));
        if (days > 0) parts.push(days === 1 ? 'يوم واحد' : days === 2 ? 'يومان' : days <= 10 ? (days + ' أيام') : (days + ' يوم'));

        const resultText = parts.length > 0 ? parts.join('، ') : 'مولود حديثاً (أقل من يوم)';
        display.textContent = resultText;
        display.className = 'badge bg-success fs-6 px-3 py-1';
      } catch (e) {
        display.textContent = 'خطأ في حساب العمر';
        display.className = 'badge bg-danger fs-6 px-3 py-1';
      }
    }

    function onGregorianChange(val) {
      if (val) {
        const hObj = gregorianToHijriObj(val);
        if (hObj) {
          const dSel = document.getElementById('hijriDay');
          const mSel = document.getElementById('hijriMonth');
          const ySel = document.getElementById('hijriYear');
          if (dSel) dSel.value = hObj.day;
          if (mSel) mSel.value = hObj.month;
          if (ySel) ySel.value = hObj.year;
        }
      } else {
        const dSel = document.getElementById('hijriDay');
        const mSel = document.getElementById('hijriMonth');
        const ySel = document.getElementById('hijriYear');
        if (dSel) dSel.value = '';
        if (mSel) mSel.value = '';
        if (ySel) ySel.value = '';
      }
      calculateAgeExact(val);
    }

    function onHijriDropdownChange() {
      const d = document.getElementById('hijriDay').value;
      const m = document.getElementById('hijriMonth').value;
      const y = document.getElementById('hijriYear').value;

      if (d && m && y) {
        const gStr = hijriToGregorianStr(y, m, d);
        if (gStr) {
          document.getElementById('dobGregorian').value = gStr;
          calculateAgeExact(gStr);
        }
      }
    }
  </script>
</body>
