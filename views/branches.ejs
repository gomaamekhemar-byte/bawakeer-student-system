<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>إدارة الفروع | مدارس بواكير الأهلية</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    body { font-family: 'Cairo', system-ui, sans-serif; background-color: #f4f6f9; color: #212529; }
    .navbar-erp { background: #ffffff; border-bottom: 1px solid #e3e8ee; }
    .erp-sub-header { background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #ffffff; padding: 14px 0; }
    .table thead th { background-color: #1e3a8a !important; color: #ffffff !important; font-weight: 700; padding: 12px; }
  </style>
</head>
<body>

  <!-- TOP NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-erp py-2">
    <div class="container-fluid px-4">
      <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" href="/">
        <i class="fa-solid fa-graduation-cap fs-4"></i>
        <span>مدارس بواكير الأهلية</span>
      </a>

      <div class="d-flex align-items-center gap-3">
        <a href="/" class="btn btn-outline-secondary btn-sm fw-bold">
          <i class="fa-solid fa-house me-1"></i> الرئيسية
        </a>
        <a href="/students" class="btn btn-outline-primary btn-sm fw-bold">
          <i class="fa-solid fa-users me-1"></i> قائمة الطلاب
        </a>
        <a href="/academic_years" class="btn btn-outline-info text-dark btn-sm fw-bold">
          <i class="fa-solid fa-calendar-days me-1"></i> الأعوام الدراسية
        </a>
      </div>

      <div class="d-flex align-items-center gap-3">
        <span class="fw-bold text-dark"><%= currentUser ? (currentUser.full_name || currentUser.username) : 'المستخدم' %></span>
        <a href="/logout" class="btn btn-outline-danger btn-sm" title="تسجيل الخروج">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </a>
      </div>
    </div>
  </nav>

  <!-- BLUE SUB-HEADER -->
  <div class="erp-sub-header">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
      <div class="fw-bold fs-5 d-flex align-items-center gap-2">
        <i class="fa-solid fa-building"></i>
        <span>إدارة الفروع المدرسية | مدارس بواكير الأهلية</span>
      </div>
      <a href="/students" class="btn btn-light text-primary btn-sm fw-bold shadow-sm">
        <i class="fa-solid fa-arrow-right me-1"></i> العودة للطلاب
      </a>
    </div>
  </div>

  <div class="container px-4 py-4" style="max-width: 1100px;">
    <% if(typeof message !== 'undefined' && message){ %>
      <div class="alert alert-primary alert-dismissible fade show shadow-sm fw-bold mb-4" role="alert">
        <i class="fa-solid fa-circle-info me-2"></i> <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- ADD BRANCH CARD (BOOTSTRAP GRID) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-plus-circle text-primary me-2"></i> إضافة فرع جديد
        </h5>
      </div>
      <div class="card-body p-4 pt-2">
        <form method="post" action="/branches" class="row g-3 align-items-end">
          <input type="hidden" name="action" value="create">
          
          <div class="col-md-5">
            <label class="form-label fw-bold text-secondary small">اسم الفرع <span class="text-danger">*</span></label>
            <input name="name" class="form-control" required placeholder="مثال: فرع الروابي">
          </div>

          <div class="col-md-5">
            <label class="form-label fw-bold text-secondary small">الموقع / العنوان</label>
            <input name="location" class="form-control" placeholder="مثال: الرياض - حي الروابي">
          </div>

          <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm">
              <i class="fa-solid fa-floppy-disk me-1"></i> إضافة
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- BRANCHES LIST TABLE (BOOTSTRAP TABLE) -->
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-school text-primary me-2"></i> فروع المدارس الحالية
        </h5>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead>
            <tr>
              <th style="width: 50px;">#</th>
              <th>اسم الفرع</th>
              <th>الموقع والعنوان</th>
              <th>الحالة</th>
              <th class="text-center" style="width: 160px;">الإجراءات</th>
            </tr>
          </thead>
          <tbody>
            <% if(typeof branches !== 'undefined' && branches && branches.length > 0){ branches.forEach(function(branch, idx){ %>
              <tr>
                <td class="text-muted fw-bold"><%= idx + 1 %></td>
                <td class="fw-bold text-dark fs-6"><%= branch.name %></td>
                <td class="text-muted"><%= branch.location || '—' %></td>
                <td>
                  <% if(branch.is_active){ %>
                    <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fw-bold">
                      <i class="fa-solid fa-check me-1"></i> نشط
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary px-3 py-2 fw-bold">
                      <i class="fa-solid fa-pause me-1"></i> متوقف
                    </span>
                  <% } %>
                </td>
                <td class="text-center">
                  <div class="btn-group btn-group-sm">
                    <form method="post" action="/branches" class="d-inline">
                      <input type="hidden" name="action" value="toggle_active">
                      <input type="hidden" name="branch_id" value="<%= branch.id %>">
                      <button type="submit" class="btn <%= branch.is_active ? 'btn-outline-secondary' : 'btn-outline-success' %> fw-bold" title="<%= branch.is_active ? 'إيقاف الفرع' : 'تفعيل الفرع' %>">
                        <i class="fa-solid <%= branch.is_active ? 'fa-pause' : 'fa-play' %>"></i> <%= branch.is_active ? 'إيقاف' : 'تفعيل' %>
                      </button>
                    </form>

                    <form method="post" action="/branches" class="d-inline ms-1" onsubmit="return confirm('هل أنت متأكد من حذف هذا الفرع؟')">
                      <input type="hidden" name="action" value="delete">
                      <input type="hidden" name="branch_id" value="<%= branch.id %>">
                      <button type="submit" class="btn btn-outline-danger fw-bold" title="حذف">
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% })} %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
