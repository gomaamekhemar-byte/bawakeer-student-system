<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <title>إدارة الفروع | مدارس بواكير الأهلية</title>
  <link rel="stylesheet" href="/public/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <style>
    body { background-color: #f1f5f9; font-family: 'Cairo', sans-serif; margin: 0; padding: 0; }
    .erp-top-nav { background: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 8px 20px; display: flex; justify-content: space-between; align-items: center; font-size: 13.5px; }
    .erp-nav-right, .erp-nav-left { display: flex; align-items: center; gap: 12px; }
    .erp-menu-item { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 6px; color: #334155; text-decoration: none; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .erp-menu-item:hover { background: #f1f5f9; color: #0f172a; }
    .erp-menu-tag { padding: 4px 8px; border-radius: 4px; font-weight: 700; color: white; display: inline-flex; align-items: center; gap: 4px; }
    .erp-sub-banner { background: linear-gradient(90deg, #1d4ed8 0%, #2563eb 50%, #3b82f6 100%); color: #ffffff; padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 14.5px; box-shadow: 0 2px 4px rgba(37,99,235,0.15); }
    .erp-content { max-width: 1200px; margin: 24px auto; padding: 0 24px; }
  </style>
</head>
<body>
  <nav class="erp-top-nav">
    <div class="erp-nav-right">
      <a href="/" class="erp-menu-item" style="color:#2563eb;font-weight:800;"><span>🏠 الرئيسية</span></a>
      <a href="/students" class="erp-menu-item"><span class="erp-menu-tag" style="background:#10b981;">📋 متابعة الطلاب</span></a>
      <a href="/users" class="erp-menu-item"><span class="erp-menu-tag" style="background:#ef4444;">🛡️ الحماية</span></a>
      <a href="/history" class="erp-menu-item"><span class="erp-menu-tag" style="background:#6366f1;">📑 السجل التاريخي</span></a>
      <a href="/branches" class="erp-menu-item" style="background:#f8fafc;"><span class="erp-menu-tag" style="background:#2563eb;">🏛️ الفروع والأعوام</span></a>
      <a href="/analytics" class="erp-menu-item"><span class="erp-menu-tag" style="background:#d97706;">📊 الداش بورد</span></a>
    </div>
    <div class="erp-nav-left">
      <span style="font-weight:700;color:#1e293b;"><%= currentUser ? (currentUser.full_name || currentUser.username) : 'المستخدم' %></span>
      <a href="/logout" style="color:#ef4444;text-decoration:none;font-weight:700;">🚪 خروج</a>
    </div>
  </nav>

  <div class="erp-sub-banner">
    <div>إدارة الفروع المدرسية | مدارس بواكير الأهلية</div>
    <div>قائمة الفروع والمواقع</div>
  </div>

  <div class="erp-content">
    <% if(typeof message !== 'undefined' && message){ %><div class="message"><%= message %></div><% } %>

    <div class="card" style="margin-bottom:20px;">
      <div class="card-header"><h3>+ إضافة فرع جديد</h3></div>
      <form method="post" action="/branches" class="grid" style="align-items:flex-end;">
        <input type="hidden" name="action" value="create">
        <label>اسم الفرع * <input name="name" required placeholder="مثال: فرع الروابي"></label>
        <label>الموقع / العنوان <input name="location" placeholder="مثال: الرياض - حي الروابي"></label>
        <div><button type="submit" style="padding:10px 20px;background:#2563eb;color:white;border:none;border-radius:8px;font-weight:700;cursor:pointer;">إضافة الفرع</button></div>
      </form>
    </div>

    <div class="card">
      <div class="card-header"><h3>فروع المدارس الحالية</h3></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>#</th><th>اسم الفرع</th><th>الموقع</th><th>الحالة</th><th>الإجراءات</th></tr></thead>
          <tbody>
            <% if(typeof branches !== 'undefined' && branches && branches.length > 0){ branches.forEach(function(branch, idx){ %>
              <tr>
                <td><%= idx + 1 %></td>
                <td style="font-weight:700;color:#0f172a;"><%= branch.name %></td>
                <td><%= branch.location || '—' %></td>
                <td><%= branch.is_active ? '<span class="pill pill-success">نشط</span>' : '<span class="pill pill-danger">غير نشط</span>' %></td>
                <td>
                  <form method="post" action="/branches" style="display:inline;">
                    <input type="hidden" name="action" value="toggle_active">
                    <input type="hidden" name="branch_id" value="<%= branch.id %>">
                    <button type="submit" class="btn-sm"><%= branch.is_active ? 'تعطيل' : 'تفعيل' %></button>
                  </form>
                  <form method="post" action="/branches" style="display:inline;" onsubmit="return confirm('هل تريد حذف الفرع؟')">
                    <input type="hidden" name="action" value="delete">
                    <input type="hidden" name="branch_id" value="<%= branch.id %>">
                    <button type="submit" class="btn-sm" style="color:#ef4444;background:#fef2f2;border-color:#fecaca;">حذف</button>
                  </form>
                </td>
              </tr>
            <% })} %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</body>
</html>
