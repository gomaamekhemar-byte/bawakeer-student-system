<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>سجل العمليات واسترجاع المحذوفات | مدارس بواكير الأهلية</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    body { font-family: 'Cairo', system-ui, sans-serif; background-color: #f4f6f9; color: #212529; }
    .navbar-erp { background: #ffffff; border-bottom: 1px solid #e3e8ee; }
    .erp-sub-header { background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #ffffff; padding: 14px 0; }
    .table thead th { background-color: #1e3a8a !important; color: #ffffff !important; font-weight: 700; padding: 12px; }
  </style>
</head>
<body>

  <!-- TOP NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-erp py-2">
    <div class="container-fluid px-4">
      <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" href="/">
        <i class="fa-solid fa-graduation-cap fs-4"></i>
        <span>مدارس بواكير الأهلية</span>
      </a>

      <div class="d-flex align-items-center gap-3">
        <a href="/" class="btn btn-outline-secondary btn-sm fw-bold">
          <i class="fa-solid fa-house me-1"></i> الرئيسية
        </a>
        <a href="/students" class="btn btn-outline-primary btn-sm fw-bold">
          <i class="fa-solid fa-users me-1"></i> قائمة الطلاب
        </a>
        <a href="/branches" class="btn btn-outline-info text-dark btn-sm fw-bold">
          <i class="fa-solid fa-building me-1"></i> الفروع
        </a>
      </div>

      <div class="d-flex align-items-center gap-3">
        <span class="fw-bold text-dark"><%= currentUser ? (currentUser.full_name || currentUser.username) : 'المستخدم' %></span>
        <a href="/logout" class="btn btn-outline-danger btn-sm" title="تسجيل الخروج">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </a>
      </div>
    </div>
  </nav>

  <!-- BLUE SUB-HEADER -->
  <div class="erp-sub-header">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
      <div class="fw-bold fs-5 d-flex align-items-center gap-2">
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span>سجل العمليات وحركات التسجيل والمحذوفات | مدارس بواكير الأهلية</span>
      </div>
      <a href="/students" class="btn btn-light text-primary btn-sm fw-bold shadow-sm">
        <i class="fa-solid fa-arrow-right me-1"></i> العودة للطلاب
      </a>
    </div>
  </div>

  <div class="container px-4 py-4" style="max-width: 1250px;">
    
    <!-- ALERT MESSAGE -->
    <div id="liveAlertPlaceholder">
      <% if(typeof message !== 'undefined' && message){ %>
        <div class="alert alert-success alert-dismissible fade show shadow-sm fw-bold mb-4" role="alert">
          <i class="fa-solid fa-circle-check me-2"></i> <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
    </div>

    <!-- SEARCH IN HISTORY -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-body p-3">
        <div class="input-group">
          <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
          <input type="text" id="historySearchInput" class="form-control" placeholder="بحث فوري في سجل العمليات (باسم الطالب، الفرع، المستخدم، أو الإجراء)..." onkeyup="filterHistoryTable()">
        </div>
      </div>
    </div>

    <!-- AUDIT LOG TABLE -->
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-list-check text-primary me-2"></i> سجل العمليات وحركات التسجيل (<span id="historyCount"><%= entries ? entries.length : 0 %></span> عملية)
        </h5>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0" id="historyTable">
          <thead>
            <tr>
              <th style="width: 50px;">#</th>
              <th style="width: 170px;">التاريخ والتوقيت</th>
              <th style="width: 150px;">نوع الإجراء</th>
              <th>تفاصيل العملية</th>
              <th style="width: 140px;">المسؤول</th>
              <th style="width: 250px;" class="text-center">بيانات المحذوف / الإجراءات</th>
            </tr>
          </thead>
          <tbody id="historyTbody">
            <% if(typeof entries !== 'undefined' && entries && entries.length > 0){ entries.forEach(function(entry, idx){ %>
              <% 
                const hasSnapshot = entry.record_snapshot && typeof entry.record_snapshot === 'object';
                const isDeleteAction = entry.action === 'student_deleted';
                const studentId = hasSnapshot ? entry.record_snapshot.id : '';
                const studentName = hasSnapshot ? entry.record_snapshot.name : '';
              %>
              <tr data-hist-row="<%= idx %>">
                <td class="text-muted fw-bold"><%= idx + 1 %></td>
                <td class="text-muted small">
                  <i class="fa-regular fa-clock me-1 text-secondary"></i>
                  <%= entry.timestamp ? new Date(entry.timestamp).toLocaleString('ar-SA') : '—' %>
                </td>
                <td>
                  <span class="badge <%= isDeleteAction ? 'bg-danger-subtle text-danger border border-danger' : (entry.action === 'student_restored' ? 'bg-success-subtle text-success border border-success' : 'bg-primary-subtle text-primary border border-primary') %> px-2 py-1 fw-bold">
                    <%= entry.action === 'student_deleted' ? '🗑️ حذف طالب' : (entry.action === 'student_restored' ? '♻️ استرجاع طالب' : entry.action) %>
                  </span>
                </td>
                <td class="fw-bold text-dark"><%= entry.details %></td>
                <td>
                  <span class="badge bg-secondary-subtle text-dark border">
                    <i class="fa-solid fa-user me-1 text-secondary"></i> <%= entry.username %>
                  </span>
                </td>
                <td class="text-center">
                  <% if(hasSnapshot){ %>
                    <!-- Hidden JSON data for this row -->
                    <script type="application/json" id="snapshot_data_<%= idx %>">
                      <%- JSON.stringify(entry.record_snapshot) %>
                    </script>

                    <div class="d-flex align-items-center justify-content-center gap-1 flex-wrap" id="actions_box_<%= idx %>">
                      <!-- 1. View Snapshot Details Button -->
                      <button type="button" class="btn btn-outline-primary btn-sm fw-bold d-inline-flex align-items-center gap-1" onclick="openSnapshotModal(<%= idx %>)">
                        <i class="fa-solid fa-eye"></i>
                        <span>عرض التفاصيل</span>
                      </button>

                      <!-- 2. Restore Student Button (Only for deleted actions) -->
                      <% if(isDeleteAction && studentId){ %>
                        <button type="button" class="btn btn-success btn-sm text-white fw-bold d-inline-flex align-items-center gap-1 shadow-xs" id="restore_btn_<%= idx %>" onclick="triggerRestoreStudent('<%= studentId %>', '<%= studentName %>', <%= idx %>)">
                          <i class="fa-solid fa-rotate-left"></i>
                          <span>استرجاع</span>
                        </button>
                      <% } %>
                    </div>
                  <% } else { %>
                    <span class="text-muted small">—</span>
                  <% } %>
                </td>
              </tr>
            <% })} else { %>
              <tr>
                <td colspan="6" class="text-center py-5 text-muted">لا توجد سجلات بعد</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- HISTORY PAGINATION -->
      <div class="p-3 bg-light border-top d-flex justify-content-between align-items-center flex-wrap gap-2" id="histPagBar">
        <div class="text-muted small fw-bold">عرض <span id="hPgStart">1</span>–<span id="hPgEnd">20</span> من <span id="hPgTotal"><%= entries ? entries.length : 0 %></span> عملية</div>
        <nav><ul class="pagination pagination-sm mb-0" id="hPgControls"></ul></nav>
      </div>
    </div>

  </div>

  <!-- MODAL: DELETED STUDENT DETAILS (READABLE CARD / DATA GRID) -->
  <div class="modal fade" id="snapshotDetailsModal" tabindex="-1" aria-labelledby="snapshotDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content border-0 shadow rounded-4">
        
        <div class="modal-header bg-light py-3">
          <div class="d-flex align-items-center gap-2">
            <div class="rounded-circle bg-primary-subtle text-primary p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
              <i class="fa-solid fa-id-card fs-5"></i>
            </div>
            <div>
              <h5 class="modal-title fw-bold text-dark mb-0" id="snapshotDetailsModalLabel">
                بيانات الطالب في لحظة الحذف (Record Snapshot)
              </h5>
              <small class="text-muted" id="snapshotMetaTime">سجل محفوظ ومستقل</small>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4" id="snapshotModalBody">
          <!-- Populated by JavaScript -->
        </div>

        <div class="modal-footer bg-light py-2 d-flex justify-content-between">
          <button type="button" class="btn btn-secondary fw-bold px-3" data-bs-dismiss="modal">إغلاق</button>
          <div id="modalRestoreContainer">
            <!-- Populated with restore button if applicable -->
          </div>
        </div>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Live search filter
    function filterHistoryTable() {
      const input = document.getElementById("historySearchInput").value.toLowerCase();
      const rows = document.querySelectorAll("#historyTbody tr[data-hist-row]");
      let count = 0;
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const show = text.includes(input);
        row.style.display = show ? "" : "none";
        if (show) count++;
      });
      document.getElementById("historyCount").innerText = count;
      buildHistPager(1);
    }

    // Pagination
    const HPG = 20;
    let hCurPage = 1;
    const hRows = Array.from(document.querySelectorAll('#historyTbody tr[data-hist-row]'));
    const hTotal = hRows.length;

    function goHistPage(p) {
      hCurPage = p;
      const s = (p-1)*HPG, e = s+HPG;
      hRows.forEach((r,i) => { r.style.display = (i>=s && i<e) ? '' : 'none'; });
      document.getElementById('hPgStart').textContent = hTotal > 0 ? s+1 : 0;
      document.getElementById('hPgEnd').textContent = Math.min(e, hTotal);
      document.getElementById('hPgTotal').textContent = hTotal;
      buildHistPager(p);
    }

    function buildHistPager(p) {
      const tp = Math.ceil(hTotal/HPG);
      if (tp <= 1) { const bar = document.getElementById('histPagBar'); if(bar) bar.style.display='none'; return; }
      const ul = document.getElementById('hPgControls'); ul.innerHTML = '';
      const mk = (label, pg, dis, act) => {
        const li = document.createElement('li'); li.className = 'page-item'+(dis?' disabled':'')+(act?' active':'');
        const a = document.createElement('a'); a.className = 'page-link'; a.href = '#';
        a.onclick = ev => { ev.preventDefault(); if(!dis) goHistPage(pg); }; a.innerHTML = label; li.appendChild(a); return li;
      };
      ul.appendChild(mk('&raquo; السابق', p-1, p===1, false));
      const sp=Math.max(1,p-2), ep=Math.min(tp,sp+4);
      for(let i=sp;i<=ep;i++) ul.appendChild(mk(i,i,false,i===p));
      ul.appendChild(mk('التالي &laquo;', p+1, p===tp, false));
    }

    if (hTotal > HPG) { goHistPage(1); }
    else {
      const sEl = document.getElementById('hPgStart'), eEl = document.getElementById('hPgEnd'), tEl = document.getElementById('hPgTotal');
      if (sEl) sEl.textContent = hTotal > 0 ? 1 : 0;
      if (eEl) eEl.textContent = hTotal;
      if (tEl) tEl.textContent = hTotal;
    }

    // Modal Snapshot Viewer
    function openSnapshotModal(idx) {
      const dataScript = document.getElementById('snapshot_data_' + idx);
      if (!dataScript) return;
      let s = {};
      try { s = JSON.parse(dataScript.textContent); } catch(e) { return; }

      const body = document.getElementById('snapshotModalBody');
      const timeLbl = document.getElementById('snapshotMetaTime');
      if (timeLbl) {
        timeLbl.textContent = s.deleted_at ? ('تاريخ الحذف: ' + new Date(s.deleted_at).toLocaleString('ar-SA') + ' بواسطة: ' + (s.deleted_by || 'غير معروف')) : 'نسخة محفوظة';
      }

      body.innerHTML = `
        <div class="bg-light p-3 rounded-3 mb-3 border d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <h5 class="fw-bold text-dark mb-1">${s.name || 'بدون اسم'}</h5>
            <div class="d-flex gap-2">
              <span class="badge bg-primary">${s.student_type || 'بنين'}</span>
              <span class="badge bg-secondary">${s.branch || 'الفرع غير محدد'}</span>
              <span class="badge bg-info text-dark">${s.phase || ''} - صف ${s.grade || ''}</span>
              <span class="badge bg-warning text-dark">${s.track || 'عام'}</span>
            </div>
          </div>
          <div class="text-end">
            <span class="badge bg-danger-subtle text-danger border border-danger px-3 py-2 fw-bold">
              <i class="fa-solid fa-trash me-1"></i> تم الحذف
            </span>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-sm align-middle mb-0" style="font-size: 13.5px;">
            <tbody>
              <tr>
                <th class="bg-light text-secondary" style="width: 25%;">رقم الجوال الأساسي</th>
                <td class="fw-bold text-primary" style="direction: ltr; text-align: right;">${s.phone || '—'}</td>
                <th class="bg-light text-secondary" style="width: 25%;">جوال إضافي (الأم)</th>
                <td style="direction: ltr; text-align: right;">${s.mother_phone || '—'}</td>
              </tr>
              <tr>
                <th class="bg-light text-secondary">الجنسية</th>
                <td>${s.nationality || 'سعودي'}</td>
                <th class="bg-light text-secondary">الحي السكني</th>
                <td>${s.neighborhood || '—'}</td>
              </tr>
              <tr>
                <th class="bg-light text-secondary">تاريخ الميلاد</th>
                <td>${s.date_of_birth || '—'}</td>
                <th class="bg-light text-secondary">مصدر التسجيل</th>
                <td>${s.registration_source || 'تسجيل داخلي'}</td>
              </tr>
              <tr>
                <th class="bg-light text-secondary">نتيجة المقابلة</th>
                <td>${s.interview_result || 'لم يقابل'} ${s.interview_reason ? ('(' + s.interview_reason + ')') : ''}</td>
                <th class="bg-light text-secondary">حالة المتابعة</th>
                <td>${s.followup_status || '—'}</td>
              </tr>
              <tr>
                <th class="bg-light text-secondary">ملاحظات الطالب</th>
                <td colspan="3" class="text-muted">${s.notes ? s.notes.replace(/\n/g, '<br>') : 'لا توجد ملاحظات'}</td>
              </tr>
            </tbody>
          </table>
        </div>
      `;

      const restoreCont = document.getElementById('modalRestoreContainer');
      if (restoreCont) {
        if (s.id) {
          restoreCont.innerHTML = `
            <button type="button" class="btn btn-success fw-bold px-4 text-white shadow-sm" onclick="triggerRestoreStudent('${s.id}', '${(s.name || '').replace(/'/g, "\\'")}', ${idx})">
              <i class="fa-solid fa-rotate-left me-1"></i> استرجاع هذا الطالب الآن
            </button>
          `;
        } else {
          restoreCont.innerHTML = '';
        }
      }

      const modal = new bootstrap.Modal(document.getElementById('snapshotDetailsModal'));
      modal.show();
    }

    // Trigger Restore API
    function triggerRestoreStudent(studentId, studentName, idx) {
      if (!studentId) {
        alert('تعذر تحديد معرف الطالب');
        return;
      }
      const confirmed = confirm('هل أنت متأكد من استرجاع هذا الطالب ليعود لقائمة الطلاب النشطين؟\nالطالب: ' + studentName);
      if (!confirmed) return;

      fetch('/api/students/' + studentId + '/restore', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        }
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          // Hide modal if open
          const modalEl = document.getElementById('snapshotDetailsModal');
          const modalInstance = bootstrap.Modal.getInstance(modalEl);
          if (modalInstance) modalInstance.hide();

          // Replace restore button with success badge in row
          const rBtn = document.getElementById('restore_btn_' + idx);
          if (rBtn) {
            rBtn.outerHTML = '<span class="badge bg-success-subtle text-success border border-success px-2 py-1"><i class="fa-solid fa-check me-1"></i> تم الاسترجاع</span>';
          }

          // Show alert
          const alertHolder = document.getElementById('liveAlertPlaceholder');
          if (alertHolder) {
            alertHolder.innerHTML = `
              <div class="alert alert-success alert-dismissible fade show shadow-sm fw-bold mb-4" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> تم استرجاع الطالب (${studentName}) بنجاح وأصبح متاحاً في قائمة الطلاب والفرع الخاص به ✅
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            `;
          }
        } else {
          alert('تعذر استرجاع الطالب: ' + (data.error || 'خطأ في السيرفر'));
        }
      })
      .catch(err => {
        alert('حدث خطأ في الاتصال أثناء استرجاع الطالب: ' + err.message);
      });
    }
  </script>
</body>
</html>
