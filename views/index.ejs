                <!-- Existing Attachments in Edit Mode with 3 Actions -->
                <% if(editingStudent && editingStudent.attachments && editingStudent.attachments.length > 0){ %>
                  <div class="mt-3 p-3 bg-light rounded border" id="editModalAttachmentsBox">
                    <div class="fw-bold small text-secondary mb-2"><i class="fa-solid fa-folder-open me-1"></i> المرفقات الحالية المسجلة للطالب:</div>
