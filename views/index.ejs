  <script>
    // =============================================
    // Hijri <-> Gregorian Interactive Dual-Pick & Exact Age
    // =============================================
    function gregorianToHijriObj(gStr) {
      if (!gStr) return null;
      try {
        if (typeof moment !== 'undefined') {
          const m = moment(gStr, 'YYYY-MM-DD');
          if (m.isValid()) {
            return { year: m.iYear(), month: m.iMonth() + 1, day: m.iDate() };
          }
        }
        const d = new Date(gStr);
        const formatter = new Intl.DateTimeFormat('en-u-ca-islamic-umalqura', { day: 'numeric', month: 'numeric', year: 'numeric' });
        const parts = formatter.formatToParts(d);
        let day = '', month = '', year = '';
        parts.forEach(p => {
          if (p.type === 'day') day = parseInt(p.value, 10);
          if (p.type === 'month') month = parseInt(p.value, 10);
          if (p.type === 'year') year = parseInt(p.value.replace(/[^0-9]/g, ''), 10);
        });
        return { year, month, day };
      } catch (e) { return null; }
    }

    function hijriToGregorianStr(hYear, hMonth, hDay) {
      if (!hYear || !hMonth || !hDay) return '';
      try {
        if (typeof moment !== 'undefined') {
          const m = moment(`${hYear}/${hMonth}/${hDay}`, 'iYYYY/iM/iD');
          if (m.isValid()) {
            return m.format('YYYY-MM-DD');
          }
        }
        const yNum = parseInt(hYear, 10), mNum = parseInt(hMonth, 10), dNum = parseInt(hDay, 10);
        const jd = Math.floor((11 * yNum + 3) / 30) + 354 * yNum + 30 * mNum - Math.floor((mNum - 1) / 2) + dNum + 1948440 - 385;
        const l = jd + 68569;
        const n = Math.floor((4 * l) / 146097);
        const l2 = l - Math.floor((146097 * n + 3) / 4);
        const i = Math.floor((4000 * (l2 + 1)) / 1461001);
        const l3 = l2 - Math.floor((1461 * i) / 4) + 31;
        const j = Math.floor((80 * l3) / 2447);
        const d = l3 - Math.floor((2447 * j) / 80);
        const l4 = Math.floor(j / 11);
        const m = j + 2 - 12 * l4;
        const y = 100 * (n - 49) + i + l4;
        return y + '-' + String(m).padStart(2, '0') + '-' + String(d).padStart(2, '0');
      } catch (e) { return ''; }
    }

    function calculateAgeExact(gDateStr) {
      const display = document.getElementById('studentAgeDisplay');
      if (!display) return;
      if (!gDateStr) {
        display.textContent = 'يرجى إدخال تاريخ الميلاد';
        display.className = 'badge bg-secondary fs-6 px-3 py-1';
        return;
      }
      
      try {
        const birth = typeof moment !== 'undefined' ? moment(gDateStr, 'YYYY-MM-DD') : new Date(gDateStr);
        const today = typeof moment !== 'undefined' ? moment() : new Date();
        
        let years = 0, months = 0, days = 0;
        if (typeof moment !== 'undefined') {
          if (!birth.isValid() || birth.isAfter(today)) {
            display.textContent = 'تاريخ غير صالح (في المستقبل)';
            display.className = 'badge bg-danger fs-6 px-3 py-1';
            return;
          }
          const bClone = birth.clone();
          years = today.diff(bClone, 'years');
          bClone.add(years, 'years');
          months = today.diff(bClone, 'months');
          bClone.add(months, 'months');
          days = today.diff(bClone, 'days');
        } else {
          years = today.getFullYear() - birth.getFullYear();
          months = today.getMonth() - birth.getMonth();
          days = today.getDate() - birth.getDate();
          if (days < 0) { const pm = new Date(today.getFullYear(), today.getMonth(), 0); days += pm.getDate(); months -= 1; }
          if (months < 0) { months += 12; years -= 1; }
        }

        const parts = [];
        if (years > 0) parts.push(years === 1 ? 'سنة واحدة' : years === 2 ? 'سنتان' : years <= 10 ? (years + ' سنوات') : (years + ' سنة'));
        if (months > 0) parts.push(months === 1 ? 'شهر واحد' : months === 2 ? 'شهران' : months <= 10 ? (months + ' أشهر') : (months + ' شهر'));
        if (days > 0) parts.push(days === 1 ? 'يوم واحد' : days === 2 ? 'يومان' : days <= 10 ? (days + ' أيام') : (days + ' يوم'));

        const resultText = parts.length > 0 ? parts.join('، ') : 'مولود حديثاً (أقل من يوم)';
        display.textContent = resultText;
        display.className = 'badge bg-success fs-6 px-3 py-1';
      } catch (e) {
        display.textContent = 'خطأ في حساب العمر';
        display.className = 'badge bg-danger fs-6 px-3 py-1';
      }
    }

    // When user changes Gregorian date -> update Hijri dropdowns & age
    function onGregorianChange(val) {
      if (val) {
        const hObj = gregorianToHijriObj(val);
        if (hObj) {
          const dSel = document.getElementById('hijriDay');
          const mSel = document.getElementById('hijriMonth');
          const ySel = document.getElementById('hijriYear');
          if (dSel) dSel.value = hObj.day;
          if (mSel) mSel.value = hObj.month;
          if (ySel) ySel.value = hObj.year;
        }
      } else {
        const dSel = document.getElementById('hijriDay');
        const mSel = document.getElementById('hijriMonth');
        const ySel = document.getElementById('hijriYear');
        if (dSel) dSel.value = '';
        if (mSel) mSel.value = '';
        if (ySel) ySel.value = '';
      }
      calculateAgeExact(val);
    }

    // When user changes any of the Hijri dropdowns -> update Gregorian date & age
    function onHijriDropdownChange() {
      const d = document.getElementById('hijriDay').value;
      const m = document.getElementById('hijriMonth').value;
      const y = document.getElementById('hijriYear').value;

      if (d && m && y) {
        const gStr = hijriToGregorianStr(y, m, d);
        if (gStr) {
          document.getElementById('dobGregorian').value = gStr;
          calculateAgeExact(gStr);
        }
      }
    }

    // =============================================
    // Modal Helpers & Logic
    // =============================================
    function openNewStudentModal(e) {
      if (e) e.preventDefault();
      
      if (window.location.search.includes('edit_id')) {
        window.location.href = '/students?open_modal=1';
        return;
      }
      
      const form = document.getElementById('studentForm');
      if (form) {
        form.reset();
        const idInp = document.getElementById('studentIdHidden');
        if (idInp) idInp.value = '';
        const nameInp = form.querySelector('input[name="name"]');
        if (nameInp) nameInp.value = '';
        const phoneInp = document.getElementById('phoneInput');
        if (phoneInp) phoneInp.value = '';
        const mPhoneInp = document.getElementById('motherPhoneInput');
        if (mPhoneInp) mPhoneInp.value = '';
        const dobG = document.getElementById('dobGregorian');
        if (dobG) dobG.value = '';
        document.getElementById('hijriDay').value = '';
        document.getElementById('hijriMonth').value = '';
        document.getElementById('hijriYear').value = '';
      }
      
      const title = document.getElementById('studentModalLabel');
      if (title) title.innerHTML = '<i class="fa-solid fa-user-graduate text-primary me-2"></i> إضافة طالب جديد';
      
      const ageDisp = document.getElementById('studentAgeDisplay');
      if (ageDisp) {
        ageDisp.textContent = 'يرجى إدخال تاريخ الميلاد';
        ageDisp.className = 'badge bg-secondary fs-6 px-3 py-1';
      }
      
      toggleInterviewReason();
      
      const modalEl = document.getElementById('studentModal');
      if (modalEl) {
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
      }
    }

    // Dynamic & Mandatory 'سبب عدم القبول' (Textarea)
    function toggleInterviewReason() {
      const select = document.getElementById('interviewResultSelect');
      const col = document.getElementById('interviewReasonCol');
      const input = document.getElementById('interviewReasonInput');
      if (!select || !col || !input) return;
      
      if (select.value === 'غير مقبول') {
        col.classList.remove('d-none');
        input.setAttribute('required', 'required');
      } else {
        col.classList.add('d-none');
        input.removeAttribute('required');
        input.value = '';
      }
    }

    // Phone Validation (05xxxxxxxx - 10 digits)
    function validatePhone(input, errorId) {
      const v = input.value.trim();
      const err = document.getElementById(errorId);
      if (!v) { err.style.display = 'none'; input.classList.remove('is-invalid'); return true; }
      const ok = /^05\d{8}$/.test(v.replace(/\s+/g, ''));
      err.style.display = ok ? 'none' : 'block';
      input.classList.toggle('is-invalid', !ok);
      return ok;
    }

    // Dynamic attachment title requirement on file select
    function handleAttachmentChange(input) {
      const titleInput = document.getElementById('attachmentTitleInput');
      const starEl = document.getElementById('attTitleStar');
      if (input.files && input.files.length > 0) {
        titleInput.setAttribute('required', 'required');
        if (starEl) starEl.classList.remove('d-none');
        if (!titleInput.value.trim()) {
          titleInput.classList.add('border-warning');
        }
      } else {
        titleInput.removeAttribute('required');
        titleInput.classList.remove('is-invalid', 'border-warning');
        if (starEl) starEl.classList.add('d-none');
      }
    }

    function showValidationAlert(msg) {
      const alertBox = document.getElementById('formValidationAlert');
      const alertText = document.getElementById('formValidationAlertText');
      if (alertBox && alertText) {
        alertText.textContent = msg || 'عفواً، يرجى إكمال جميع البيانات الإجبارية المحددة بالنجمة الحمراء قبل الحفظ';
        alertBox.classList.remove('d-none');
        alertBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      showToast('⚠️ ' + msg, 'danger');
    }

    function hideValidationAlert() {
      const alertBox = document.getElementById('formValidationAlert');
      if (alertBox) alertBox.classList.add('d-none');
    }

    // STRICT FORM VALIDATION: Intercept Submit, Prevent Fake Saves, Check All Required Fields
    document.getElementById('studentForm').addEventListener('submit', function(e) {
      hideValidationAlert();
      let hasErrors = false;
      let firstInvalidField = null;
      let customErrorMessage = 'عفواً، يرجى إكمال جميع البيانات الإجبارية المحددة بالنجمة الحمراء قبل الحفظ';

      // 1. Check all [required] fields
      const requiredFields = this.querySelectorAll('input[required], select[required], textarea[required]');
      requiredFields.forEach(field => {
        // Skip elements inside hidden containers (e.g. interview_reason when not rejected)
        if (field.offsetParent === null && field.id !== 'dobHijri') {
          field.classList.remove('is-invalid');
          return;
        }

        const val = field.value ? field.value.trim() : '';
        if (!val) {
          hasErrors = true;
          field.classList.add('is-invalid');
          if (!firstInvalidField) firstInvalidField = field;
        } else {
          field.classList.remove('is-invalid');
        }
      });

      // 2. Check attachments title if files selected
      const fileInput = document.getElementById('attachmentsInput');
      const titleInput = document.getElementById('attachmentTitleInput');
      if (fileInput && fileInput.files && fileInput.files.length > 0) {
        if (!titleInput.value.trim()) {
          hasErrors = true;
          titleInput.classList.add('is-invalid');
          customErrorMessage = 'عفواً، يرجى كتابة اسم المرفق قبل حفظ الملف';
          if (!firstInvalidField) firstInvalidField = titleInput;
        } else {
          titleInput.classList.remove('is-invalid');
        }
      }

      // 3. Strict Phone validation
      const phoneInput = document.getElementById('phoneInput');
      if (phoneInput && !validatePhone(phoneInput, 'phoneError')) {
        hasErrors = true;
        phoneInput.classList.add('is-invalid');
        if (!firstInvalidField) firstInvalidField = phoneInput;
      }

      const motherPhoneInput = document.getElementById('motherPhoneInput');
      if (motherPhoneInput && motherPhoneInput.value.trim()) {
        if (!validatePhone(motherPhoneInput, 'motherPhoneError')) {
          hasErrors = true;
          motherPhoneInput.classList.add('is-invalid');
          if (!firstInvalidField) firstInvalidField = motherPhoneInput;
        }
      }

      // 4. Interview Reason check if rejected
      const resultSel = document.getElementById('interviewResultSelect');
      const reasonInp = document.getElementById('interviewReasonInput');
      if (resultSel && resultSel.value === 'غير مقبول' && reasonInp && !reasonInp.value.trim()) {
        hasErrors = true;
        reasonInp.classList.add('is-invalid');
        customErrorMessage = 'عفواً، يرجى كتابة سبب عدم القبول الإجباري';
        if (!firstInvalidField) firstInvalidField = reasonInp;
      }

      // IF ANY ERROR: PREVENT SUBMISSION COMPLETELY
      if (hasErrors) {
        e.preventDefault();
        e.stopPropagation();

        showValidationAlert(customErrorMessage);

        if (firstInvalidField) {
          firstInvalidField.scrollIntoView({ behavior: 'smooth', block: 'center' });
          firstInvalidField.focus();
        }
        return false;
      }

      // If completely valid, show spinner and allow submission
      const btn = document.getElementById('saveStudentBtn');
      btn.querySelector('.save-text').classList.add('d-none');
      btn.querySelector('.spinner-border').classList.remove('d-none');
      btn.style.pointerEvents = 'none';
    });

    // Remove is-invalid on live user input/change
    document.querySelectorAll('#studentForm input, #studentForm select, #studentForm textarea').forEach(el => {
      el.addEventListener('input', function() {
        if (this.value.trim()) {
          this.classList.remove('is-invalid');
          hideValidationAlert();
        }
      });
      el.addEventListener('change', function() {
        if (this.value.trim()) {
          this.classList.remove('is-invalid');
          hideValidationAlert();
        }
      });
    });

    // Search spinner
    document.getElementById('searchForm').addEventListener('submit', function() {
      const btn = document.getElementById('searchBtn');
      btn.querySelector('.search-text').classList.add('d-none');
      btn.querySelector('.spinner-border').classList.remove('d-none');
      btn.style.pointerEvents = 'none';
    });

    const exBtn = document.getElementById('excelBtn');
    if (exBtn) {
      exBtn.addEventListener('click', function() {
        const sp = this.querySelector('.spinner-border');
        const tx = this.querySelector('span:first-child');
        if (sp && tx) { tx.classList.add('d-none'); sp.classList.remove('d-none'); setTimeout(()=>{ tx.classList.remove('d-none'); sp.classList.add('d-none'); }, 4000); }
      });
    }

    // Automated status transition in Edit Modal
    function onModalInterviewChange(val) {
      toggleInterviewReason();
      const folSelect = document.getElementById('followupStatusSelect');
      if (folSelect) {
        if (val === 'مقبول') {
          folSelect.value = 'في انتظار التسجيل';
        } else if (val === 'غير مقبول') {
          folSelect.value = 'لم يجتز المقابلة';
        }
      }
    }

        // Live Parent History Lookup
    async function checkParentHistory(phoneVal) {
      const alertBox = document.getElementById('parentLookupAlert');
      const msgSpan = document.getElementById('parentLookupMsg');
      if (!phoneVal || phoneVal.trim().length < 8) {
        if (alertBox) alertBox.style.display = 'none';
        return;
      }
      try {
        const res = await fetch('/api/lookup_parent?phone=' + encodeURIComponent(phoneVal.trim()));
        const data = await res.json();
        if (data.found && alertBox && msgSpan) {
          msgSpan.textContent = data.message;
          alertBox.style.display = 'flex';

          // Auto-fill neighborhood and nationality if empty
          const neighInput = document.getElementById('neighborhoodInput') || document.querySelector('input[name="neighborhood"]');
          if (neighInput && !neighInput.value.trim() && data.student.neighborhood) {
            neighInput.value = data.student.neighborhood;
          }
          const natSelect = document.querySelector('select[name="nationality"]');
          if (natSelect && !natSelect.value && data.student.nationality) {
            natSelect.value = data.student.nationality;
          }
        } else if (alertBox) {
          alertBox.style.display = 'none';
        }
      } catch(e) {
        if (alertBox) alertBox.style.display = 'none';
      }
    }

    // Quick Status Update (AJAX with Field Permissions & Workflow Automation)
    async function quickUpdateStatus(id, field, value, sel) {
      sel.disabled = true;
      try {
        const r = await fetch('/api/quick_update_status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ student_id: id, field, value })
        });
        const d = await r.json();
        
        if (d.success) {
          showToast('✅ ' + d.message, 'success');
          
          // Automated workflow: update followup dropdown if interview changed
          if (field === 'interview_result' && d.autoFollowupStatus) {
            const folDropdown = document.getElementById('dd_fol_' + id);
            if (folDropdown) {
              folDropdown.value = d.autoFollowupStatus;
            }
          }
        } else {
          showToast('❌ ' + (d.message || 'فشل التحديث'), 'danger');
        }
      } catch(e) {
        showToast('❌ خطأ في الاتصال بالسيرفر', 'danger');
      } finally {
        sel.disabled = false;
      }
    }

    function showToast(msg, type) {
      const el = document.getElementById('statusToast');
      document.getElementById('toastMessage').textContent = msg;
      el.className = 'toast align-items-center border-0 shadow text-bg-' + (type || 'success');
      bootstrap.Toast.getOrCreateInstance(el, {delay:3000}).show();
    }

    // =============================================
    // Attachments System: Preview, Download, Delete
    // =============================================
    function showStudentAttachments(studentId, attachments, studentName) {
      document.getElementById('attModalTitle').innerHTML = '<i class="fa-solid fa-paperclip me-2"></i> مرفقات الطالب: ' + studentName;
      const mb = document.getElementById('attModalBody');
      
      if (!attachments || !attachments.length) {
        mb.innerHTML = '<div class="text-center py-5 text-muted"><i class="fa-solid fa-folder-open fs-1 text-secondary mb-3 d-block"></i><h6 class="fw-bold">لا توجد مرفقات مسجلة لهذا الطالب</h6><small>يمكنك رفع ملفات أثناء تعديل بيانات الطالب.</small></div>';
      } else {
        let h = '<div class="d-flex flex-column gap-3" id="attContainer_' + studentId + '">';
        attachments.forEach((att, idx) => {
          const name = att.name || att.original_name || ('مرفق رقم ' + (idx + 1));
          const url = att.url || '#';
          const ext = name.split('.').pop().toLowerCase();
          let icon = 'fa-solid fa-file text-secondary';
          if (['png', 'jpg', 'jpeg', 'gif', 'webp'].includes(ext)) icon = 'fa-solid fa-file-image text-success';
          else if (ext === 'pdf') icon = 'fa-solid fa-file-pdf text-danger';
          else if (['doc', 'docx'].includes(ext)) icon = 'fa-solid fa-file-word text-primary';
          else if (['xls', 'xlsx'].includes(ext)) icon = 'fa-solid fa-file-excel text-success';

          h += '<div class="attachment-card d-flex justify-content-between align-items-center flex-wrap gap-2" id="attCard_' + studentId + '_' + idx + '">';
          h += '  <div class="d-flex align-items-center gap-3">';
          h += '    <i class="' + icon + ' fs-3"></i>';
          h += '    <div>';
          h += '      <div class="fw-bold text-dark">' + name + '</div>';
          if (att.uploaded_at) {
            h += '    <small class="text-muted">' + new Date(att.uploaded_at).toLocaleDateString('ar-SA') + '</small>';
          }
          h += '    </div>';
          h += '  </div>';
          h += '  <div class="d-flex gap-2">';
          h += '    <a href="' + url + '" target="_blank" class="btn btn-sm btn-primary fw-bold"><i class="fa-solid fa-eye me-1"></i> معاينة</a>';
          h += '    <a href="' + url + '" download="' + name + '" target="_blank" class="btn btn-sm btn-success fw-bold"><i class="fa-solid fa-download me-1"></i> تنزيل</a>';
          h += '    <button type="button" class="btn btn-sm btn-danger fw-bold" onclick="confirmDeleteAttachment(' + studentId + ', ' + idx + ', \'' + url + '\', \'' + name.replace(/'/g, "\\'") + '\', this, \'modal\')"><i class="fa-solid fa-trash me-1"></i> حذف</button>';
          h += '  </div>';
          h += '</div>';
        });
        h += '</div>';
        mb.innerHTML = h;
      }
      
      bootstrap.Modal.getOrCreateInstance(document.getElementById('attachmentsModal')).show();
    }

    async function confirmDeleteAttachment(studentId, fileIndex, fileUrl, fileName, btnEl, context) {
      if (!confirm('⚠️ هل أنت متأكد من حذف هذا المرفق نهائياً؟\n\n' + fileName)) {
        return;
      }

      btnEl.disabled = true;
      const originalHtml = btnEl.innerHTML;
      btnEl.innerHTML = '<span class="spinner-border spinner-border-sm"></span> جاري الحذف...';

      try {
        const res = await fetch('/api/delete_attachment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            student_id: studentId,
            file_index: fileIndex,
            file_url: fileUrl,
            filename: fileName
          })
        });

        const data = await res.json();
        if (data.success) {
          showToast('✅ ' + data.message, 'success');

          // Remove element from UI
          if (context === 'modal') {
            const card = document.getElementById('attCard_' + studentId + '_' + fileIndex);
            if (card) card.remove();
            
            // Check if container is empty
            const container = document.getElementById('attContainer_' + studentId);
            if (container && container.children.length === 0) {
              document.getElementById('attModalBody').innerHTML = '<div class="text-center py-5 text-muted"><i class="fa-solid fa-folder-open fs-1 text-secondary mb-3 d-block"></i><h6 class="fw-bold">لا توجد مرفقات مسجلة لهذا الطالب</h6></div>';
            }
          } else if (context === 'editModal') {
            const item = document.getElementById('editAttItem_' + fileIndex);
            if (item) item.remove();
          }

          // Update table row badge
          const badge = document.getElementById('attBadge_' + studentId);
          if (badge) {
            if (data.remainingCount > 0) {
              badge.textContent = data.remainingCount;
            } else {
              badge.remove();
            }
          }
        } else {
          showToast('❌ ' + (data.message || 'تعذر حذف المرفق'), 'danger');
          btnEl.disabled = false;
          btnEl.innerHTML = originalHtml;
        }
      } catch (err) {
        showToast('❌ حدث خطأ في الاتصال بالسيرفر', 'danger');
        btnEl.disabled = false;
        btnEl.innerHTML = originalHtml;
      }
    }

    // Pagination (20 records / page)
    const PG = 20;
    let curPage = 1;
    const rows = Array.from(document.querySelectorAll('#studentsTableBody tr[data-student-id]'));
    const total = rows.length;

    function goPage(p) {
      curPage = p;
      const s = (p-1)*PG, e = s+PG;
      rows.forEach((r,i) => r.style.display = (i>=s && i<e) ? '' : 'none');
      document.getElementById('pgStart').textContent = total > 0 ? s+1 : 0;
      document.getElementById('pgEnd').textContent = Math.min(e, total);
      document.getElementById('pgTotal').textContent = total;
      buildPager(p);
    }

    function buildPager(p) {
      const tp = Math.ceil(total/PG);
      if (tp <= 1) { document.querySelector('.pagination-bar').style.display = 'none'; return; }
      const ul = document.getElementById('pgControls'); ul.innerHTML = '';
      const mk = (label, page, dis, act) => {
        const li = document.createElement('li'); li.className = 'page-item' + (dis ? ' disabled' : '') + (act ? ' active' : '');
        const a = document.createElement('a'); a.className = 'page-link'; a.href = '#';
        a.onclick = e => { e.preventDefault(); if (!dis) goPage(page); };
        a.innerHTML = label; li.appendChild(a); return li;
      };
      ul.appendChild(mk('&raquo; السابق', p-1, p===1, false));
      const sp = Math.max(1,p-2), ep = Math.min(tp,sp+4);
      for (let i=sp;i<=ep;i++) ul.appendChild(mk(i, i, false, i===p));
      ul.appendChild(mk('التالي &laquo;', p+1, p===tp, false));
    }

    if (total > PG) { goPage(1); }
    else { document.getElementById('pgStart').textContent = total>0?1:0; document.getElementById('pgEnd').textContent=total; document.getElementById('pgTotal').textContent=total; }

    // Student History Modal
    async function openStudentHistoryModal(id, name) {
      document.getElementById('histModalTitle').innerHTML = '<i class="fa-solid fa-clock-rotate-left me-2"></i> سجل حركات الطالب: ' + name;
      const mb = document.getElementById('histModalBody');
      mb.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>';
      bootstrap.Modal.getOrCreateInstance(document.getElementById('studentHistoryModal')).show();
      try {
        const r = await fetch('/api/student_history/' + id); const d = await r.json();
        if (!d.entries || !d.entries.length) { mb.innerHTML = '<div class="text-center py-4 text-muted">لا توجد سجلات تعديل لهذا الطالب.</div>'; return; }
        let h = '<div class="d-flex flex-column gap-3">';
        d.entries.forEach(e => {
          const dt = e.timestamp ? new Date(e.timestamp).toLocaleString('ar-SA') : '—';
          h += '<div class="card bg-light border p-3 rounded-3"><div class="d-flex justify-content-between flex-wrap gap-2 mb-2"><div><span class="badge bg-primary me-2">'+e.action+'</span><strong>'+e.details+'</strong></div><small class="text-muted">'+e.username+' • '+dt+'</small></div>';
          if (e.field_changes && e.field_changes.length) { h += '<table class="table table-sm mb-0 bg-white rounded border"><thead class="table-light"><tr><th>الحقل</th><th>السابق</th><th>الجديد</th></tr></thead><tbody>'; e.field_changes.forEach(c=>h+='<tr><td class="fw-bold text-secondary">'+c.field_label+'</td><td class="text-danger"><del>'+c.old_value+'</del></td><td class="text-success fw-bold">'+c.new_value+'</td></tr>'); h+='</tbody></table>'; }
          h += '</div>';
        });
        mb.innerHTML = h + '</div>';
      } catch(e) { mb.innerHTML = '<div class="alert alert-danger">حدث خطأ أثناء جلب السجل التاريخي.</div>'; }
    }

    // Init on DOM load
    document.addEventListener('DOMContentLoaded', function() {
      toggleInterviewReason();
      const dobVal = document.getElementById('dobGregorian').value;
      if (dobVal) {
        onGregorianChange(dobVal);
      }
    });
  </script>

  <% if(editingStudent){ %>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      bootstrap.Modal.getOrCreateInstance(document.getElementById('studentModal')).show();
    });
  </script>
  <% } %>

  <% if(typeof openNewModal !== 'undefined' && openNewModal){ %>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      openNewStudentModal();
    });
  </script>
  <% } %>

</body>
</html>
