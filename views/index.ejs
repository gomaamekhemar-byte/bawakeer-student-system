<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>التسجيل الإلكتروني | مدارس بواكير الأهلية</title>
  <link rel="stylesheet" href="/public/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body>
  <!-- TOP ERP NAVBAR -->
  <nav class="erp-top-nav">
    <div class="erp-nav-right">
      <a href="/" class="erp-menu-item" style="color:#2563eb;font-weight:800;">
        <span>🏠 الرئيسية</span>
      </a>
      
      <div class="erp-menu-item">
        <span class="erp-menu-tag" style="background:#f97316;">📄 التقارير ▾</span>
        <div style="font-size:12px;display:flex;gap:6px;margin-right:6px;">
          <a href="/export/excel" style="color:#059669;text-decoration:none;font-weight:700;">Excel</a> |
          <a href="/export/pdf" style="color:#dc2626;text-decoration:none;font-weight:700;">PDF</a>
        </div>
      </div>

      <% if(canManageUsers){ %>
        <a href="/users" class="erp-menu-item">
          <span class="erp-menu-tag" style="background:#ef4444;">🛡️ الحماية والمستخدمين</span>
        </a>
      <% } %>

      <a href="/history" class="erp-menu-item">
        <span class="erp-menu-tag" style="background:#6366f1;">📑 سجل العمليات والتعديلات</span>
      </a>

      <% if(canManageYears){ %>
        <a href="/branches" class="erp-menu-item">
          <span class="erp-menu-tag" style="background:#2563eb;">🏛️ الأعمال الإدارية ▾</span>
        </a>
      <% } %>

      <a href="/analytics" class="erp-menu-item">
        <span class="erp-menu-tag" style="background:#d97706;">📊 الداش بورد</span>
      </a>
    </div>

    <div class="erp-nav-left">
      <span style="font-weight:800;color:#0f172a;"><%= currentUser ? (currentUser.full_name || currentUser.username) : 'مدير النظام' %></span>
      <span style="color:#64748b;font-size:12px;font-weight:600;">(<%= activeBranch && activeBranch !== 'الكل' ? activeBranch : 'جميع الفروع' %>)</span>
      <a href="/logout" class="btn-icon-action" title="تسجيل الخروج" style="color:#ef4444;background:#fef2f2;border-color:#fecaca;">🚪</a>
      <a href="/" class="btn-icon-action" title="لوحة التطبيقات">⊞</a>
    </div>
  </nav>

  <!-- BLUE SUB-HEADER BANNER -->
  <div class="erp-sub-banner">
    <div>الشاشة الرئيسية | نظام متابعة وتسجيل الطلاب</div>
    <div>مدارس بواكير الأهلية - فرع <%= activeBranch && activeBranch !== 'الكل' ? activeBranch : 'جميع الفروع' %> , العام الدراسي: <%= activeYear ? activeYear.year_name : '1448هـ' %></div>
  </div>

  <div style="max-width:1440px;margin:20px auto;padding:0 24px;">
    <!-- FLASH MESSAGE -->
    <% if(message){ %>
      <div style="background:#eff6ff;color:#1e40af;padding:12px 18px;border-radius:10px;border:1px solid #bfdbfe;margin-bottom:18px;font-weight:700;">
        ℹ️ <%= message %>
      </div>
    <% } %>

    <!-- SEARCH & ACTION TOOLBAR (EXACT CLEAN STRUCTURE) -->
    <div class="search-toolbar-card">
      <form method="get" action="/students" class="search-flex-row">
        <div class="search-field-wrap">
          <span class="search-field-icon">🔍</span>
          <input name="q" value="<%= typeof query !== 'undefined' ? query : '' %>" placeholder="اسم الطالب">
        </div>
        
        <div class="search-field-wrap">
          <span class="search-field-icon">🔍</span>
          <input name="neighborhood" value="" placeholder="إسم الأب / الحي">
        </div>
        
        <div class="search-field-wrap">
          <span class="search-field-icon">🔍</span>
          <input name="phone_search" value="" placeholder="الجوال">
        </div>

        <button type="submit" class="btn-search">بحث</button>

        <% if(canManageStudents){ %>
          <button type="button" class="btn-orange-add" onclick="openStudentModal()">
            <span>+ ولي أمر جديد</span>
          </button>
        <% } %>
      </form>
    </div>

    <!-- STATS CARDS ROW (STRUCTURED HORIZONTAL METRIC CARDS) -->
    <div class="stats-container">
      <div class="stat-box primary">
        <strong><%= stats.total %></strong>
        <span>إجمالي الطلاب</span>
      </div>
      <div class="stat-box success">
        <strong><%= stats.accepted %></strong>
        <span>مقبول</span>
      </div>
      <div class="stat-box danger">
        <strong><%= stats.rejected %></strong>
        <span>غير مقبول</span>
      </div>
      <div class="stat-box info">
        <strong><%= stats.registered %></strong>
        <span>تم التسجيل</span>
      </div>
      <div class="stat-box warning">
        <strong><%= stats.waiting %></strong>
        <span>في انتظار التسجيل</span>
      </div>
      <div class="stat-box purple">
        <strong><%= stats.pending_interview %></strong>
        <span>في انتظار المقابلة</span>
      </div>
    </div>

    <!-- MAIN DATA TABLE CARD -->
    <div class="main-card">
      <div class="main-card-header">
        <h3>قائمة الطلاب المسجلين (<%= students.length %> طالب)</h3>
        <div style="display:flex;gap:8px;">
          <% if(currentUser && currentUser.permissions && currentUser.permissions.export_reports){ %>
            <a href="/export/excel" class="btn-icon-action" style="width:auto;padding:0 14px;color:#059669;font-weight:700;" title="تصدير Excel">📥 Excel</a>
            <a href="/export/pdf" class="btn-icon-action" style="width:auto;padding:0 14px;color:#dc2626;font-weight:700;" title="تصدير PDF">📄 PDF</a>
          <% } %>
        </div>
      </div>

      <div class="table-responsive">
        <table class="erp-table">
          <thead>
            <tr>
              <th>#</th>
              <th>اسم الطالب</th>
              <th>رقم الجوال</th>
              <th>المرحلة والصف</th>
              <th>الفرع</th>
              <th>نتيجة المقابلة</th>
              <th>حالة المتابعة</th>
              <th>الملاحظات</th>
              <th>الإجراءات</th>
            </tr>
          </thead>
          <tbody>
            <% if(students && students.length > 0){ %>
              <% students.forEach(function(s, idx){ %>
                <tr>
                  <td><%= idx + 1 %></td>
                  <td style="font-weight:800;color:#0f172a;"><%= s.name %></td>
                  <td>
                    <% if(s.phone){ %>
                      <a href="https://wa.me/<%= s.phone.replace(/[^0-9]/g, '') %>" target="_blank" style="color:#16a34a;text-decoration:none;font-weight:700;">
                        📱 <%= s.phone %>
                      </a>
                    <% } else { %>—<% } %>
                  </td>
                  <td><%= s.phase || '' %> <%= s.grade ? ' - صف ' + s.grade : '' %></td>
                  <td><span class="badge-pill neutral"><%= s.branch || 'الندى' %></span></td>
                  <td>
                    <% if(s.interview_result === 'مقبول'){ %>
                      <span class="badge-pill success">✓ مقبول</span>
                    <% } else if(s.interview_result === 'غير مقبول'){ %>
                      <span class="badge-pill danger">✕ غير مقبول</span>
                    <% } else if(s.interview_result === 'في انتظار المقابلة'){ %>
                      <span class="badge-pill warning">⏳ في انتظار المقابلة</span>
                    <% } else { %>
                      <span class="badge-pill neutral">لم يقابل</span>
                    <% } %>
                  </td>
                  <td>
                    <% if(s.followup_status === 'تم التسجيل'){ %>
                      <span class="badge-pill info">✔ تم التسجيل</span>
                    <% } else if(s.followup_status === 'في انتظار التسجيل'){ %>
                      <span class="badge-pill warning">⏳ في انتظار التسجيل</span>
                    <% } else if(s.followup_status === 'لا يرغب في التسجيل'){ %>
                      <span class="badge-pill danger">لا يرغب</span>
                    <% } else { %>
                      <span class="badge-pill neutral">لم يسجل</span>
                    <% } %>
                  </td>
                  <td style="max-width:200px;font-size:12.5px;color:#64748b;"><%= s.notes || '—' %></td>
                  <td>
                    <div style="display:flex;gap:4px;">
                      <% if(canManageStudents){ %>
                        <a href="/students?edit_id=<%= s.id %>" class="btn-icon-action" title="تعديل">✏️</a>
                      <% } %>
                      <a href="/student_history/<%= s.id %>" class="btn-icon-action" title="سجل التعديلات">📜</a>
                      <% if(canDeleteStudents){ %>
                        <form method="post" action="/delete/<%= s.id %>" style="display:inline;" onsubmit="return confirm('هل أنت متأكد من حذف الطالب <%= s.name %>؟')">
                          <button type="submit" class="btn-icon-action" style="color:#ef4444;background:#fef2f2;border-color:#fecaca;" title="حذف">🗑️</button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="9" style="text-align:center;padding:36px;color:#64748b;font-weight:600;">
                  لا توجد نتائج مطابقة لمعايير البحث
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ADD / EDIT STUDENT MODAL (STRUCTURED 3-COLUMN SECTIONS) -->
  <div id="studentModal" class="modal-backdrop <%= editingStudent ? 'active' : '' %>">
    <div class="modal-window">
      <div class="modal-header-bar">
        <h3><%= editingStudent ? 'تعديل بيانات الطالب: ' + editingStudent.name : 'إضافة ولي أمر / طالب جديد' %></h3>
        <button type="button" onclick="closeStudentModal()" style="background:none;border:none;font-size:22px;cursor:pointer;color:#64748b;">✕</button>
      </div>
      
      <div class="modal-content-area">
        <form method="post" action="/students" enctype="multipart/form-data">
          <input type="hidden" name="student_id" value="<%= editingStudent ? editingStudent.id : '' %>">
          
          <!-- SECTION 1: PERSONAL INFO -->
          <div class="form-section-title">📌 البيانات الأساسية والشخصية</div>
          <div class="form-grid-3">
            <div class="form-control-group">
              <label>اسم الطالب *</label>
              <input name="name" required value="<%= editingStudent ? editingStudent.name : '' %>" placeholder="الاسم ثلاثي أو رباعي">
            </div>

            <div class="form-control-group">
              <label>رقم الجوال *</label>
              <input name="phone" required value="<%= editingStudent ? editingStudent.phone : '' %>" placeholder="05xxxxxxxx">
            </div>

            <div class="form-control-group">
              <label>تاريخ الميلاد</label>
              <input name="date_of_birth" type="date" value="<%= editingStudent ? editingStudent.date_of_birth : '' %>">
            </div>

            <div class="form-control-group">
              <label>الجنسية</label>
              <select name="nationality">
                <option value="">اختر الجنسية...</option>
                <% nationalities.forEach(function(n){ %>
                  <option value="<%= n %>" <%= editingStudent && editingStudent.nationality===n ? 'selected' : '' %>><%= n %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-control-group">
              <label>الحي السكني</label>
              <input name="neighborhood" value="<%= editingStudent ? editingStudent.neighborhood : '' %>" placeholder="اسم الحي">
            </div>

            <div class="form-control-group">
              <label>نوع الطالب</label>
              <select name="student_type">
                <% student_types.forEach(function(t){ %>
                  <option value="<%= t %>" <%= editingStudent && editingStudent.student_type===t ? 'selected' : '' %>><%= t %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <!-- SECTION 2: ACADEMIC INFO -->
          <div class="form-section-title">🏫 البيانات الأكاديمية والفرع</div>
          <div class="form-grid-3">
            <div class="form-control-group">
              <label>الفرع *</label>
              <select name="student_branch" required>
                <% branches.forEach(function(b){ %>
                  <option value="<%= b %>" <%= editingStudent && editingStudent.branch===b ? 'selected' : '' %>><%= b %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-control-group">
              <label>المرحلة الدراسية</label>
              <select name="phase">
                <option value="">اختر المرحلة...</option>
                <% phases.forEach(function(p){ %>
                  <option value="<%= p %>" <%= editingStudent && editingStudent.phase===p ? 'selected' : '' %>><%= p %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-control-group">
              <label>الصف</label>
              <select name="grade">
                <option value="">اختر الصف...</option>
                <% grades.forEach(function(g){ %>
                  <option value="<%= g %>" <%= editingStudent && editingStudent.grade===g ? 'selected' : '' %>>صف <%= g %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-control-group">
              <label>المسار</label>
              <select name="track">
                <% tracks.forEach(function(tr){ %>
                  <option value="<%= tr %>" <%= editingStudent && editingStudent.track===tr ? 'selected' : '' %>><%= tr %></option>
                <% }) %>
              </select>
            </div>
          </div>

          <!-- SECTION 3: INTERVIEW & REGISTRATION -->
          <div class="form-section-title">📋 بيانات المقابلة وحالة المتابعة</div>
          <div class="form-grid-2">
            <div class="form-control-group">
              <label>نتيجة المقابلة</label>
              <select name="interview_result">
                <option value="">لم تحدد بعد</option>
                <% interview_results.forEach(function(r){ %>
                  <option value="<%= r %>" <%= editingStudent && editingStudent.interview_result===r ? 'selected' : '' %>><%= r %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-control-group">
              <label>حالة المتابعة والتسجيل</label>
              <select name="followup_status">
                <option value="">لم تحدد بعد</option>
                <% followup_statuses.forEach(function(s){ %>
                  <option value="<%= s %>" <%= editingStudent && editingStudent.followup_status===s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </div>

            <div class="form-control-group">
              <label>سبب عدم الاجتياز (إن وجد)</label>
              <input name="interview_reason" value="<%= editingStudent ? editingStudent.interview_reason : '' %>" placeholder="في حال عدم القبول">
            </div>

            <div class="form-control-group">
              <label>سبب عدم التسجيل (إن وجد)</label>
              <input name="registration_reason" value="<%= editingStudent ? editingStudent.registration_reason : '' %>" placeholder="في حال عدم الرغبة">
            </div>
          </div>

          <!-- SECTION 4: NOTES & ATTACHMENTS -->
          <div class="form-section-title">📎 الملاحظات والمرفقات</div>
          <div class="form-grid-2">
            <div class="form-control-group">
              <label>ملاحظات إضافية</label>
              <textarea name="notes" rows="3" placeholder="أي تفاصيل أو ملاحظات تخص الطالب..."><%= editingStudent ? editingStudent.notes : '' %></textarea>
            </div>

            <div class="form-control-group">
              <label>إرفاق مستندات / شهادات</label>
              <input type="file" name="attachments" multiple style="background:white;padding:8px;">
            </div>
          </div>

          <div style="display:flex;justify-content:flex-end;gap:12px;margin-top:24px;border-top:1px solid #f1f5f9;padding-top:16px;">
            <button type="button" onclick="closeStudentModal()" style="padding:10px 20px;background:#f1f5f9;color:#475569;border:1px solid #cbd5e1;border-radius:8px;font-weight:700;cursor:pointer;">إلغاء</button>
            <button type="submit" style="padding:10px 28px;background:#2563eb;color:white;border:none;border-radius:8px;font-weight:800;cursor:pointer;box-shadow:0 4px 12px rgba(37,99,235,0.25);">حفظ البيانات</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    function openStudentModal() {
      document.getElementById('studentModal').classList.add('active');
    }
    function closeStudentModal() {
      document.getElementById('studentModal').classList.remove('active');
      if (window.location.search.includes('edit_id')) {
        window.location.href = '/students';
      }
    }
  </script>
</body>
</html>
