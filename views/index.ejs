                      <% editingStudent.attachments.forEach(function(att, idx){ %>
                        <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded border" id="editAttItem_<%= idx %>">
                          <div class="d-flex align-items-center gap-2 text-truncate">
