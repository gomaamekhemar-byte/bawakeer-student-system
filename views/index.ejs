                <textarea name="interview_reason" id="interviewReasonInput" class="form-control border-danger" rows="2" placeholder="اكتب سبب عدم القبول التفصيلي الإجباري..."><%= editingStudent ? (editingStudent.interview_reason || '') : '' %></textarea>
