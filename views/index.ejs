              <!-- سبب عدم التسجيل -->
              <div class="col-md-6">
                <label class="form-label fw-bold text-dark small">سبب عدم التسجيل</label>
                <input type="text" name="registration_reason" class="form-control" value="<%= editingStudent ? editingStudent.registration_reason : '' %>" placeholder="في حال عدم الرغبة">
              </div>

              <!-- ملاحظات -->
