                <label class="form-label fw-bold text-dark small">ملاحظات إضافية</label>
                <textarea name="notes" class="form-control" rows="2" placeholder="اكتب ملاحظات أو تفاصيل..."><%= editingStudent ? editingStudent.notes : '' %></textarea>
