              <!-- مرفقات -->
              <div class="col-12">
                <label class="form-label fw-bold text-dark small"><i class="fa-solid fa-paperclip text-primary me-1"></i> إرفاق ملفات / وثائق / شهادات (صور، PDF، Word، Excel)</label>
