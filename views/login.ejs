<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>تسجيل الدخول | مدارس بواكير الأهلية</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    body {
      font-family: 'Cairo', system-ui, sans-serif;
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #2563eb 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .card-login {
      background: #ffffff;
      border-radius: 20px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.3);
      width: 100%;
      max-width: 440px;
    }
    .login-icon-box {
      width: 70px;
      height: 70px;
      background: linear-gradient(135deg, #1e3a8a, #2563eb);
      color: white;
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      box-shadow: 0 10px 20px rgba(37,99,235,0.3);
    }
  </style>
</head>
<body>

  <div class="card card-login border-0 p-4 p-md-5">
    <div class="text-center mb-4">
      <div class="login-icon-box mb-3">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
      <h4 class="fw-bold text-dark mb-1">مدارس بواكير الأهلية</h4>
      <p class="text-muted small mb-0">نظام متابعة تسجيل وقبول الطلاب</p>
    </div>

    <% if(typeof error !== 'undefined' && error){ %>
      <div class="alert alert-danger py-2 small fw-bold mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation me-1"></i> <%= error %>
      </div>
    <% } %>

    <form method="post" action="/login">
      
      <div class="mb-3">
        <label class="form-label fw-bold text-dark small">اسم المستخدم</label>
        <div class="input-group">
          <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
          <input type="text" name="username" class="form-control" required autocomplete="username" placeholder="اسم المستخدم" autofocus>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label fw-bold text-dark small">كلمة المرور</label>
        <div class="input-group">
          <span class="input-group-text bg-light"><i class="fa-solid fa-lock text-muted"></i></span>
          <input type="password" name="password" class="form-control" required autocomplete="current-password" placeholder="••••••••">
        </div>
      </div>

      <!-- ACADEMIC YEAR DROPDOWN -->
      <div class="mb-3">
        <label class="form-label fw-bold text-dark small">العام الدراسي</label>
        <div class="input-group">
          <span class="input-group-text bg-light"><i class="fa-solid fa-calendar-days text-muted"></i></span>
          <select name="academic_year_id" class="form-select fw-bold" required>
            <% if(typeof academic_years !== 'undefined' && academic_years.length){ %>
              <% academic_years.forEach(function(y){ %>
                <option value="<%= y.id %>" <%= y.is_active ? 'selected' : '' %>>
                  <%= y.year_name %> <%= y.is_active ? '(العام الحالي النشط ✅)' : '(أرشيف - قراءة فقط 🔒)' %>
                </option>
              <% }) %>
            <% } else { %>
              <option value="">العام الحالي</option>
            <% } %>
          </select>
        </div>
      </div>

      <div class="mb-4">
        <label class="form-label fw-bold text-dark small">الفرع</label>
        <div class="input-group">
          <span class="input-group-text bg-light"><i class="fa-solid fa-building text-muted"></i></span>
          <select name="branch" class="form-select" required>
            <option value="الكل">جميع الفروع</option>
            <% branches.forEach(function(branch){ %>
              <option value="<%= branch %>">فرع <%= branch %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
        <span>تسجيل الدخول للنظام</span>
        <i class="fa-solid fa-arrow-left"></i>
      </button>

    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
