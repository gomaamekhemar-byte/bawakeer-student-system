<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>البوابة الرئيسية | مدارس بواكير الأهلية</title>
  <link rel="stylesheet" href="/public/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <style>
    body {
      background-color: #f1f5f9;
      font-family: 'Cairo', sans-serif;
      margin: 0;
      padding: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .portal-header {
      background: #ffffff;
      padding: 14px 32px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }
    .portal-user {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .portal-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, #1e40af, #3b82f6);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      position: relative;
      box-shadow: 0 4px 10px rgba(37,99,235,0.25);
    }
    .portal-avatar .online-dot {
      width: 12px;
      height: 12px;
      background: #22c55e;
      border: 2px solid white;
      border-radius: 50%;
      position: absolute;
      bottom: 0;
      left: 0;
    }
    .portal-user-info {
      text-align: right;
    }
    .portal-user-name {
      font-weight: 800;
      font-size: 16px;
      color: #0f172a;
      line-height: 1.2;
    }
    .portal-user-role {
      font-size: 13px;
      color: #64748b;
      font-weight: 600;
      margin-top: 2px;
    }
    .portal-header-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .portal-header-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 13.5px;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.2s;
    }
    .portal-header-btn.logout {
      background: #fef2f2;
      color: #dc2626;
      border: 1px solid #fecaca;
    }
    .portal-header-btn.logout:hover {
      background: #dc2626;
      color: white;
    }
    .portal-grid-container {
      flex: 1;
      max-width: 1240px;
      margin: 36px auto;
      padding: 0 24px;
      width: 100%;
    }
    .portal-welcome-banner {
      background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
      color: white;
      border-radius: 16px;
      padding: 20px 28px;
      margin-bottom: 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 10px 20px -5px rgba(37,99,235,0.25);
    }
    .portal-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 22px;
    }
    .portal-card {
      background: #ffffff;
      border-radius: 18px;
      padding: 30px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      text-decoration: none;
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
      border: 1px solid #e2e8f0;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      min-height: 165px;
      position: relative;
    }
    .portal-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 14px 28px rgba(0,0,0,0.08);
      border-color: #94a3b8;
    }
    .portal-card-icon-box {
      width: 58px;
      height: 58px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      margin-bottom: 14px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    .portal-card-title {
      font-size: 16.5px;
      font-weight: 800;
      color: #0f172a;
      margin: 0;
    }
    .portal-card-sub {
      font-size: 12px;
      color: #64748b;
      font-weight: 600;
      margin-top: 4px;
    }
    .portal-footer {
      text-align: center;
      padding: 16px;
      font-size: 13px;
      color: #64748b;
      border-top: 1px solid #e2e8f0;
      background: #ffffff;
    }
    @media (max-width: 992px) {
      .portal-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 576px) {
      .portal-grid { grid-template-columns: 1fr; }
      .portal-welcome-banner { flex-direction: column; text-align: center; gap: 10px; }
    }
  </style>
</head>
<body>
  <!-- HEADER -->
  <header class="portal-header">
    <div class="portal-user">
      <div class="portal-avatar">
        👤
        <div class="online-dot"></div>
      </div>
      <div class="portal-user-info">
        <div class="portal-user-name"><%= currentUser ? (currentUser.full_name || currentUser.username) : 'مدير النظام' %></div>
        <div class="portal-user-role"><%= currentUser ? (currentUser.job_title || 'مسؤول النظام') : 'StaffUser' %></div>
      </div>
    </div>
    
    <div class="portal-header-actions">
      <span style="background:#f1f5f9;color:#334155;padding:6px 14px;border-radius:20px;font-size:12.5px;font-weight:700;">
        📍 الفرع: <%= activeBranch && activeBranch !== 'الكل' ? activeBranch : 'جميع الفروع' %>
      </span>
      <a href="/logout" class="portal-header-btn logout">
        <span>🚪</span>
        <span>تسجيل الخروج</span>
      </a>
    </div>
  </header>

  <!-- MAIN GRID MODULES -->
  <main class="portal-grid-container">
    <!-- WELCOME BANNER -->
    <div class="portal-welcome-banner">
      <div>
        <h2 style="margin:0 0 4px;font-size:20px;font-weight:800;">مدارس بواكير الأهلية</h2>
        <p style="margin:0;opacity:0.9;font-size:13.5px;">نظام متابعة تسجيل وقبول الطلاب</p>
      </div>
      <div style="background:rgba(255,255,255,0.18);backdrop-filter:blur(8px);padding:8px 16px;border-radius:30px;font-size:13px;font-weight:700;">
        📅 العام الدراسي: <%= activeYear ? activeYear.year_name : '1448هـ' %>
      </div>
    </div>

    <div class="portal-grid">
      <!-- 1. تسجيل ومتابعة الطلاب -->
      <a href="/students" class="portal-card" style="border:2px solid #2563eb;box-shadow:0 6px 16px rgba(37,99,235,0.1);">
        <div class="portal-card-icon-box" style="background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;">
          📋
        </div>
        <h3 class="portal-card-title" style="color:#1e40af;">تسجيل ومتابعة الطلاب</h3>
        <span class="portal-card-sub">إدارة وتحديث بيانات وحالات الطلاب</span>
      </a>

      <!-- 2. لوحة التحليلات والإحصائيات -->
      <a href="/analytics" class="portal-card">
        <div class="portal-card-icon-box" style="background:#fffbeb;color:#d97706;border:1px solid #fef3c7;">
          📊
        </div>
        <h3 class="portal-card-title">الداش بورد والتحليلات</h3>
        <span class="portal-card-sub">مؤشرات ونسب القبول والتسجيل</span>
      </a>

      <!-- 3. تصدير التقارير (Excel & PDF) -->
      <a href="/students" class="portal-card">
        <div class="portal-card-icon-box" style="background:#f0fdf4;color:#16a34a;border:1px solid #bbf7d0;">
          📑
        </div>
        <h3 class="portal-card-title">التقارير والتصدير</h3>
        <span class="portal-card-sub">تقارير Excel وطباعة كشوفات PDF</span>
      </a>

      <!-- 4. إدارة المستخدمين والصلاحيات -->
      <a href="/users" class="portal-card">
        <div class="portal-card-icon-box" style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;">
          👥
        </div>
        <h3 class="portal-card-title">إدارة المستخدمين والأمان</h3>
        <span class="portal-card-sub">حسابات الموظفين والصلاحيات</span>
      </a>

      <!-- 5. إدارة الفروع -->
      <a href="/branches" class="portal-card">
        <div class="portal-card-icon-box" style="background:#f5f3ff;color:#7c3aed;border:1px solid #ddd6fe;">
          🏢
        </div>
        <h3 class="portal-card-title">إدارة الفروع المدرسية</h3>
        <span class="portal-card-sub">فروع المدارس والمواقع</span>
      </a>

      <!-- 6. الأعوام الدراسية -->
      <a href="/academic_years" class="portal-card">
        <div class="portal-card-icon-box" style="background:#fff7ed;color:#ea580c;border:1px solid #ffedd5;">
          📅
        </div>
        <h3 class="portal-card-title">الأعوام الدراسية</h3>
        <span class="portal-card-sub">تهيئة وتفعيل العام الدراسي</span>
      </a>

      <!-- 7. سجل العمليات والتعديلات -->
      <a href="/history" class="portal-card">
        <div class="portal-card-icon-box" style="background:#f0fdfa;color:#0d9488;border:1px solid #ccfbf1;">
          📜
        </div>
        <h3 class="portal-card-title">سجل العمليات والتعديلات</h3>
        <span class="portal-card-sub">تتبع حركة التعديلات وسجل الإجراءات</span>
      </a>

      <!-- 8. تهيئة وإعدادات النظام -->
      <a href="/setup" class="portal-card">
        <div class="portal-card-icon-box" style="background:#f8fafc;color:#475569;border:1px solid #e2e8f0;">
          ⚙️
        </div>
        <h3 class="portal-card-title">إعدادات النظام</h3>
        <span class="portal-card-sub">الضبط العام وكلمات المرور</span>
      </a>
    </div>
  </main>

  <footer class="portal-footer">
    جميع الحقوق محفوظة © مدارس بواكير الأهلية 2026
  </footer>
</body>
</html>
