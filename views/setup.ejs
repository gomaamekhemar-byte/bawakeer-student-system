<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الإعدادات</title>
    <link rel="stylesheet" href="/public/styles.css">
    <style>
        .container { max-width: 800px; margin: 0 auto; padding: 20px; font-family: sans-serif; }
        .alert { padding: 15px; margin-bottom: 20px; border-radius: 4px; }
        .alert-success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .alert-error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
        .card { background: #fff; padding: 20px; margin-bottom: 20px; border: 1px solid #ddd; border-radius: 5px; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
        .form-group input[type="text"], .form-group input[type="number"], .form-group input[type="password"], .form-group select { width: 100%; padding: 8px; box-sizing: border-box; }
        .form-group input[type="checkbox"] { margin-left: 10px; }
        .btn { padding: 10px 15px; background: #007bff; color: white; border: none; cursor: pointer; border-radius: 4px; }
        .btn-danger { background: #dc3545; }
        header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eee; padding-bottom: 10px; margin-bottom: 20px; }
        nav a { margin-right: 15px; text-decoration: none; color: #007bff; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>إعدادات النظام</h1>
            <nav>
                <a href="/">الرئيسية</a>
                <a href="/users">المستخدمين</a>
            </nav>
        </header>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-<%= (typeof message_type !== 'undefined' && message_type === 'error') ? 'error' : 'success' %>">
                <%= message %>
            </div>
        <% } %>

        <div class="card">
            <h2>الإعدادات العامة</h2>
            <form action="/setup?action=save_settings" method="POST">
                <div class="form-group">
                    <label>اسم المدرسة</label>
                    <input type="text" name="school_name" value="<%= (typeof settings !== 'undefined' && settings.school_name) ? settings.school_name : '' %>">
                </div>
                <div class="form-group">
                    <label>أقصى حجم للمرفقات (ميجابايت)</label>
                    <input type="number" name="max_upload_size_mb" value="<%= (typeof settings !== 'undefined' && settings.max_upload_size_mb) ? settings.max_upload_size_mb : 10 %>">
                </div>
                <div class="form-group">
                    <label>مدة الجلسة (دقائق)</label>
                    <input type="number" name="session_timeout_minutes" value="<%= (typeof settings !== 'undefined' && settings.session_timeout_minutes) ? settings.session_timeout_minutes : 60 %>">
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" name="require_interview_reason" value="true" <%= (typeof settings !== 'undefined' && settings.require_interview_reason) ? 'checked' : '' %>>
                        إلزامية سبب المقابلة
                    </label>
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" name="require_registration_reason" value="true" <%= (typeof settings !== 'undefined' && settings.require_registration_reason) ? 'checked' : '' %>>
                        إلزامية سبب التسجيل
                    </label>
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" name="allow_registration_without_interview" value="true" <%= (typeof settings !== 'undefined' && settings.allow_registration_without_interview) ? 'checked' : '' %>>
                        السماح بالتسجيل بدون مقابلة
                    </label>
                </div>
                <button type="submit" class="btn">حفظ الإعدادات</button>
            </form>
        </div>

        <div class="card">
            <h2>تغيير كلمة مرور المدير</h2>
            <form action="/setup?action=reset_admin_password" method="POST">
                <div class="form-group">
                    <label>كلمة المرور الجديدة</label>
                    <input type="password" name="new_password" required>
                </div>
                <button type="submit" class="btn">تغيير كلمة المرور</button>
            </form>
        </div>

        <div class="card" style="border-color: #dc3545;">
            <h2 style="color: #dc3545;">إعادة ضبط البيانات</h2>
            <form action="/setup?action=reset_data" method="POST" onsubmit="return confirm('تحذير: هذا الإجراء لا يمكن التراجع عنه. هل أنت متأكد؟')">
                <div class="form-group">
                    <label>نوع إعادة الضبط</label>
                    <select name="reset_type" required>
                        <option value="">اختر...</option>
                        <option value="students">حذف جميع الطلاب</option>
                        <option value="interviews">حذف جميع المقابلات</option>
                        <option value="users">حذف جميع المستخدمين (ما عدا المدير)</option>
                        <option value="all">حذف جميع البيانات (تهيئة كاملة)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>لتأكيد الحذف، اكتب "confirm"</label>
                    <input type="text" name="confirm_reset" required pattern="confirm" title="يرجى كتابة confirm للتأكيد">
                </div>
                <button type="submit" class="btn btn-danger">تنفيذ الحذف</button>
            </form>
        </div>
    </div>
</body>
</html>
