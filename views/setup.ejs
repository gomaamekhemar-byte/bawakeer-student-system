<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إعدادات النظام والضبط العام | مدارس بواكير الأهلية</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    body { font-family: 'Cairo', system-ui, sans-serif; background-color: #f4f6f9; color: #212529; }
    .navbar-erp { background: #ffffff; border-bottom: 1px solid #e3e8ee; }
    .erp-sub-header { background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #ffffff; padding: 14px 0; }
  </style>
</head>
<body>

  <!-- TOP NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-erp py-2">
    <div class="container-fluid px-4">
      <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" href="/">
        <i class="fa-solid fa-graduation-cap fs-4"></i>
        <span>مدارس بواكير الأهلية</span>
      </a>

      <div class="d-flex align-items-center gap-3">
        <a href="/" class="btn btn-outline-secondary btn-sm fw-bold">
          <i class="fa-solid fa-house me-1"></i> الرئيسية
        </a>
        <a href="/students" class="btn btn-outline-primary btn-sm fw-bold">
          <i class="fa-solid fa-users me-1"></i> قائمة الطلاب
        </a>
        <a href="/users" class="btn btn-outline-danger btn-sm fw-bold">
          <i class="fa-solid fa-shield-halved me-1"></i> المستخدمين
        </a>
      </div>

      <div class="d-flex align-items-center gap-3">
        <span class="fw-bold text-dark"><%= currentUser ? (currentUser.full_name || currentUser.username) : 'المستخدم' %></span>
        <a href="/logout" class="btn btn-outline-danger btn-sm" title="تسجيل الخروج">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </a>
      </div>
    </div>
  </nav>

  <!-- BLUE SUB-HEADER -->
  <div class="erp-sub-header">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
      <div class="fw-bold fs-5 d-flex align-items-center gap-2">
        <i class="fa-solid fa-gears"></i>
        <span>إعدادات النظام والضبط العام | مدارس بواكير الأهلية</span>
      </div>
      <a href="/students" class="btn btn-light text-primary btn-sm fw-bold shadow-sm">
        <i class="fa-solid fa-arrow-right me-1"></i> العودة للطلاب
      </a>
    </div>
  </div>

  <div class="container px-4 py-4" style="max-width: 900px;">
    
    <% if (typeof message !== 'undefined' && message) { %>
      <div class="alert alert-primary alert-dismissible fade show shadow-sm fw-bold mb-4" role="alert">
        <i class="fa-solid fa-circle-info me-2"></i> <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- GENERAL SETTINGS CARD (GRID SYSTEM) -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
      <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-sliders text-primary me-2"></i> الإعدادات العامة للمنظومة
        </h5>
      </div>
      
      <div class="card-body p-4 pt-2">
        <form action="/setup?action=save_settings" method="POST">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold text-secondary small">اسم المنشأة التعليمية</label>
              <input type="text" name="school_name" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.school_name) ? settings.school_name : 'مدارس بواكير الأهلية' %>">
            </div>

            <div class="col-md-3">
              <label class="form-label fw-bold text-secondary small">أقصى حجم للمرفقات (MB)</label>
              <input type="number" name="max_upload_size_mb" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.max_upload_size_mb) ? settings.max_upload_size_mb : 10 %>">
            </div>

            <div class="col-md-3">
              <label class="form-label fw-bold text-secondary small">مدة الجلسة (دقائق)</label>
              <input type="number" name="session_timeout_minutes" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.session_timeout_minutes) ? settings.session_timeout_minutes : 60 %>">
            </div>
          </div>

          <div class="mt-4 pt-3 border-top d-flex justify-content-end">
            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">
              <i class="fa-solid fa-floppy-disk me-1"></i> حفظ الإعدادات
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- ADMIN PASSWORD RESET CARD -->
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-key text-warning me-2"></i> إعادة ضبط كلمة مرور مدير النظام (Admin)
        </h5>
      </div>

      <div class="card-body p-4 pt-2">
        <form action="/setup?action=reset_admin_password" method="POST">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-bold text-secondary small">كلمة المرور الجديدة</label>
              <input type="password" name="new_password" class="form-control" required placeholder="••••••••">
            </div>

            <div class="col-md-6">
              <label class="form-label fw-bold text-secondary small">تأكيد كلمة المرور الجديدة</label>
              <input type="password" name="confirm_password" class="form-control" required placeholder="••••••••">
            </div>
          </div>

          <div class="mt-4 pt-3 border-top d-flex justify-content-end">
            <button type="submit" class="btn btn-warning text-white px-4 fw-bold shadow-sm" style="background:#f97316;border-color:#f97316;">
              <i class="fa-solid fa-check me-1"></i> تحديث كلمة مرور المشرف
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
