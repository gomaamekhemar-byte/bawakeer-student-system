<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>سجل تغييرات الطالب | مدارس بواكير الأهلية</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    body { font-family: 'Cairo', system-ui, sans-serif; background-color: #f4f6f9; color: #212529; }
    .navbar-erp { background: #ffffff; border-bottom: 1px solid #e3e8ee; }
    .erp-sub-header { background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%); color: #ffffff; padding: 14px 0; }
  </style>
</head>
<body>

  <!-- TOP NAVBAR -->
  <nav class="navbar navbar-expand-lg navbar-erp py-2">
    <div class="container-fluid px-4">
      <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" href="/">
        <i class="fa-solid fa-graduation-cap fs-4"></i>
        <span>مدارس بواكير الأهلية</span>
      </a>

      <div class="d-flex align-items-center gap-3">
        <a href="/" class="btn btn-outline-secondary btn-sm fw-bold">
          <i class="fa-solid fa-house me-1"></i> الرئيسية
        </a>
        <a href="/students" class="btn btn-outline-primary btn-sm fw-bold">
          <i class="fa-solid fa-users me-1"></i> قائمة الطلاب
        </a>
      </div>

      <div class="d-flex align-items-center gap-3">
        <span class="fw-bold text-dark"><%= currentUser ? (currentUser.full_name || currentUser.username) : 'المستخدم' %></span>
        <a href="/logout" class="btn btn-outline-danger btn-sm" title="تسجيل الخروج">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
        </a>
      </div>
    </div>
  </nav>

  <!-- BLUE SUB BANNER -->
  <div class="erp-sub-header">
    <div class="container-fluid px-4 d-flex justify-content-between align-items-center">
      <div class="fw-bold fs-5 d-flex align-items-center gap-2">
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span>سجل تغييرات وحركات الطالب | <%= student ? student.name : '' %></span>
      </div>
      <a href="/students" class="btn btn-light text-primary btn-sm fw-bold shadow-sm">
        <i class="fa-solid fa-arrow-right me-1"></i> العودة لقائمة الطلاب
      </a>
    </div>
  </div>

  <div class="container px-4 py-4" style="max-width: 1100px;">

    <!-- STUDENT HEADER CARD -->
    <% if(student){ %>
      <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
              <i class="fa-solid fa-user-graduate"></i>
            </div>
            <div>
              <h4 class="fw-bold text-dark mb-1"><%= student.name %></h4>
              <div class="text-muted small d-flex gap-3">
                <span><i class="fa-solid fa-phone me-1 text-success"></i> <%= student.phone || '—' %></span>
                <span><i class="fa-solid fa-school me-1 text-primary"></i> الفرع: <%= student.branch || 'الندى' %></span>
                <span><i class="fa-solid fa-layer-group me-1 text-secondary"></i> المرحلة: <%= student.phase || '—' %></span>
                <span><i class="fa-solid fa-book-open me-1 text-info"></i> الصف: <%= student.grade || '—' %></span>
              </div>
            </div>
          </div>

          <a href="/students?edit_id=<%= student.id %>" class="btn btn-warning text-white fw-bold shadow-sm" style="background:#f97316;border-color:#f97316;">
            <i class="fa-solid fa-pen-to-square me-1"></i> تعديل بيانات الطالب
          </a>
        </div>
      </div>
    <% } %>

    <!-- TIMELINE LIST -->
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-0">
        <h5 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-list-check text-primary me-2"></i> سجل الحركات والتعديلات السابقة
        </h5>
      </div>

      <div class="card-body p-4">
        <% if(!entries || entries.length === 0){ %>
          <div class="text-center py-5 text-muted">
            <i class="fa-solid fa-clipboard-list fs-1 text-secondary mb-3 d-block"></i>
            لا توجد سجلات تعديل مسجلة لهذا الطالب بعد
          </div>
        <% } else { %>
          <div class="d-flex flex-column gap-3">
            <% entries.forEach(function(entry){ %>
              <div class="card bg-light border rounded-3 p-3">
                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                  <div>
                    <span class="badge bg-primary me-2"><%= entry.action %></span>
                    <strong class="text-dark"><%= entry.details %></strong>
                  </div>
                  <small class="text-muted">
                    <i class="fa-solid fa-user me-1"></i> <%= entry.username %> • 
                    <i class="fa-regular fa-clock me-1"></i> <%= entry.timestamp ? new Date(entry.timestamp).toLocaleString('ar-SA') : '—' %>
                  </small>
                </div>

                <% if(entry.field_changes && entry.field_changes.length > 0){ %>
                  <div class="table-responsive bg-white rounded border mt-2">
                    <table class="table table-sm mb-0 align-middle">
                      <thead class="table-light">
                        <tr>
                          <th>الحقل المعدل</th>
                          <th>القيمة السابقة</th>
                          <th>القيمة الجديدة</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% entry.field_changes.forEach(function(c){ %>
                          <tr>
                            <td class="fw-bold text-secondary"><%= c.field_label %></td>
                            <td class="text-danger"><del><%= c.old_value %></del></td>
                            <td class="text-success fw-bold"><%= c.new_value %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
