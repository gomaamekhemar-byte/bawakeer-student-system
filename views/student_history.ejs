<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>سجل تغييرات الطالب | مدارس بواكير الأهلية</title>
  <link rel="stylesheet" href="/public/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body>
  <!-- TOP ERP NAVBAR -->
  <nav class="erp-top-nav">
    <div class="erp-nav-right">
      <a href="/" class="erp-menu-item" style="color:#2563eb;font-weight:800;"><span>🏠 الرئيسية</span></a>
      <a href="/students" class="erp-menu-item"><span class="erp-menu-tag" style="background:#10b981;">📋 متابعة الطلاب</span></a>
      <a href="/users" class="erp-menu-item"><span class="erp-menu-tag" style="background:#ef4444;">🛡️ الحماية</span></a>
      <a href="/history" class="erp-menu-item" style="background:#f8fafc;"><span class="erp-menu-tag" style="background:#6366f1;">📑 سجل العمليات والتعديلات</span></a>
      <a href="/branches" class="erp-menu-item"><span class="erp-menu-tag" style="background:#2563eb;">🏛️ الأعمال الإدارية</span></a>
      <a href="/analytics" class="erp-menu-item"><span class="erp-menu-tag" style="background:#d97706;">📊 الداش بورد</span></a>
    </div>
    <div class="erp-nav-left">
      <span style="font-weight:800;color:#0f172a;"><%= currentUser ? (currentUser.full_name || currentUser.username) : 'المستخدم' %></span>
      <a href="/logout" class="btn-icon-action" title="تسجيل الخروج" style="color:#ef4444;background:#fef2f2;border-color:#fecaca;">🚪</a>
    </div>
  </nav>

  <!-- BLUE SUB-HEADER BANNER -->
  <div class="erp-sub-banner">
    <div>سجل تغييرات الطالب | <%= student ? student.name : '' %></div>
    <div>
      <a href="/students" style="color:white;text-decoration:underline;font-size:13.5px;">← العودة لقائمة الطلاب</a>
    </div>
  </div>

  <div style="max-width:1200px;margin:24px auto;padding:0 24px;">
    <!-- STUDENT PROFILE CARD -->
    <% if(student){ %>
      <div class="main-card" style="margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;">
        <div style="display:flex;align-items:center;gap:14px;">
          <div style="width:52px;height:52px;border-radius:12px;background:#eff6ff;color:#2563eb;font-size:24px;display:flex;align-items:center;justify-content:center;font-weight:800;">
            🎓
          </div>
          <div>
            <h2 style="margin:0;font-size:18px;font-weight:800;color:#0f172a;"><%= student.name %></h2>
            <div style="font-size:13px;color:#64748b;margin-top:2px;">
              <span>الفرع: <strong><%= student.branch || 'الندى' %></strong></span> |
              <span>المرحلة: <strong><%= student.phase || '—' %></strong></span> |
              <span>الصف: <strong><%= student.grade || '—' %></strong></span>
            </div>
          </div>
        </div>

        <div style="display:flex;gap:8px;">
          <a href="/students?edit_id=<%= student.id %>" class="btn-search" style="text-decoration:none;display:inline-flex;align-items:center;gap:6px;">
            ✏️ تعديل بيانات الطالب
          </a>
        </div>
      </div>
    <% } %>

    <!-- TIMELINE OF CHANGES -->
    <div class="main-card">
      <div class="main-card-header">
        <h3>سجل الحركات والتعديلات السابقة</h3>
      </div>

      <% if(!entries || entries.length === 0){ %>
        <div style="text-align:center;padding:40px;color:#64748b;font-weight:600;">
          لا توجد سجلات تعديل مسجلة لهذا الطالب بعد
        </div>
      <% } else { %>
        <div style="display:flex;flex-direction:column;gap:16px;">
          <% entries.forEach(function(entry){ %>
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:16px 20px;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;flex-wrap:wrap;gap:8px;">
                <div>
                  <span class="badge-pill info"><%= entry.action %></span>
                  <strong style="margin-right:8px;color:#0f172a;"><%= entry.details %></strong>
                </div>
                <div style="font-size:12.5px;color:#64748b;">
                  <span>👤 <%= entry.username %></span> | 
                  <span>🕒 <%= entry.timestamp ? new Date(entry.timestamp).toLocaleString('ar-SA') : '—' %></span>
                </div>
              </div>

              <% if(entry.field_changes && entry.field_changes.length > 0){ %>
                <div class="table-responsive" style="margin-top:12px;background:white;">
                  <table class="erp-table">
                    <thead>
                      <tr>
                        <th>الحقل المعدل</th>
                        <th>القيمة السابقة</th>
                        <th>القيمة الجديدة</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% entry.field_changes.forEach(function(c){ %>
                        <tr>
                          <td><strong><%= c.field_label %></strong></td>
                          <td style="color:#dc2626;"><del><%= c.old_value %></del></td>
                          <td style="color:#16a34a;font-weight:700;"><%= c.new_value %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
